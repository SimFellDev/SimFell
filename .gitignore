# Build output
bin/
obj/
*.user
.vs/
.vscode/
.idea/

# Local data: downloaded fights, replay scripts, review pages and your FellowshipLogs API settings
data/

# BenchmarkDotNet results
BenchmarkDotNet.Artifacts/

# A developer's FellowshipLogs API client, and the browser app's copy of it (never committed or deployed: FellowshipLogs'
# terms keep a client to its owner)
/settings.json
src/FellowshipSim.Web/wwwroot/appsettings.json

# The CodeMirror bundle's packages (tools/codemirror)
node_modules/

# The CodeMirror bundle, built by FellowshipSim.UI's build from tools/codemirror
src/FellowshipSim.UI/wwwroot/lib/codemirror/

# The VS Code extension's bundle, its packaged language server and its packages (src/FellowshipSim.VsCode)
src/FellowshipSim.VsCode/dist/
src/FellowshipSim.VsCode/server/
*.vsix

# The Codex data export (tools/download-codex-export.sh): Fellowship game content, read by tools/regenerate-codex.sh
/codex-export/

# FellowshipSim.Core's generated source files: the Codex generators' files are committed (tools/regenerate-codex.sh).
src/FellowshipSim.Core/Generated/*
!src/FellowshipSim.Core/Generated/Codex/

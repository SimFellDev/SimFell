# The CodeMirror bundle's packages (tools/codemirror)
node_modules/

# The CodeMirror bundle, built by FellowshipSim.UI's build from tools/codemirror
src/FellowshipSim.UI/wwwroot/lib/codemirror/

# The Codex data export: Fellowship game content, downloaded and read by FellowshipSim.Core's build
/codex-export/

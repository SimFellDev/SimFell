{
  "name": "simfell-codemirror",
  "private": true,
  "description": "The CodeMirror modules of the action-list editor, as one ES module in FellowshipSim.UI/wwwroot/lib/codemirror.",
  "type": "module",
  "scripts": {
    "build": "esbuild codemirror.js --bundle --format=esm --minify --legal-comments=eof --outfile=../../src/FellowshipSim.UI/wwwroot/lib/codemirror/codemirror.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}

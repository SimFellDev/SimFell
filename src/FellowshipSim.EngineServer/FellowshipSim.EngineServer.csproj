<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>SimFell</UserSecretsId>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Hot methods move to tier 1 without the call-counting delay. A fight's rarely run code keeps compiling new methods,
         and each compilation postponed the tier-up of the fight loop: 2,000 fights took 6 s on one core, against 2.4 s. -->
    <RuntimeHostConfigurationOption Include="System.Runtime.TieredCompilation.CallCountingDelayMs" Value="0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FellowshipSim.Engine\FellowshipSim.Engine.csproj" />
    <ProjectReference Include="..\FellowshipSim.ServiceDefaults\FellowshipSim.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>

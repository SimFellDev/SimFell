@using System.Globalization
@using FellowshipSim.Core.Engine
@using FellowshipSim.UI.Build
@using Microsoft.JSInterop
@inject IJSRuntime JS
@* A done sim's report: its DPS, each damage source, and each buff and debuff. Save keeps it as its own HTML file. *@
<div @ref="_report" class="report">
    <div class="save-bar" data-save-skip>
        <button type="button" class="secondary-button" data-tooltip="Save this sim's report as an HTML file" @onclick="SaveAsync">Save as HTML</button>
    </div>
    <div class="tiles">
        <div class="tile main">
            <span>Mean DPS</span>
            <strong>@N(Result.MeanDps)</strong>
            <em>±@MarginText at 95% confidence</em>
        </div>
        @if (Result.PrimaryTargetDps is { } primary && primary > 0 && primary < Result.MeanDps * 0.999)
        {
            <div class="tile">
                <span>Main target DPS</span>
                <strong>@N(primary)</strong>
                <em>@Percent(Result.MeanDps > 0 ? primary / Result.MeanDps : 0) of the damage, to the first target</em>
            </div>
        }
        @if (HasBossDps(Result))
        {
            <div class="tile">
                <span>Boss DPS</span>
                <strong>@N(Result.BossDps!.Value)</strong>
                <em>to bosses, over the time of boss fighting</em>
            </div>
        }
        <div class="tile">
            <span>Range</span>
            <strong>@N(Result.MinDps) – @N(Result.MaxDps)</strong>
            <em>lowest and highest fight</em>
        </div>
        <div class="tile">
            <span>Std dev</span>
            <strong>@N(Result.StandardDeviation)</strong>
            <em>@Percent(Result.MeanDps > 0 ? Result.StandardDeviation / Result.MeanDps : 0) of the mean</em>
        </div>
        <div class="tile">
            <span>Mean damage</span>
            <strong>@N(Result.MeanDps * Result.DurationSeconds)</strong>
            <em>per fight</em>
        </div>
        <div class="tile">
            <span>Fights</span>
            <strong>@N(Result.Iterations)</strong>
            <em>@Result.DurationSeconds.ToString("0.##", CultureInfo.CurrentCulture) s each</em>
        </div>
    </div>

    @if (Result.Timeline is { Dps.Count: > 1 } timeline)
    {
        <section class="card">
            <div class="card-head">
                <h3>DPS</h3>
                <span class="legend"><i class="mean"></i>Mean of every fight <i class="average"></i>Mean DPS</span>
            </div>
            <div class="chart">
                @{ double dpsMax = Math.Max(timeline.Dps.Max(), Result.MeanDps); }
                <div class="y">@foreach (var tick in Ticks(dpsMax).Reverse())
                {
                    <span>@tick</span>
                }</div>
                <svg viewBox="0 0 1000 240" preserveAspectRatio="none" role="img" aria-label="DPS: the mean of every fight">
                    @for (int g = 1; g < 4; g++)
                    {
                        <line x1="0" x2="1000" y1="@(g * 60)" y2="@(g * 60)" class="grid" />
                    }
                    <line x1="0" x2="1000" y1="@Y(Result.MeanDps, Nice(dpsMax))" y2="@Y(Result.MeanDps, Nice(dpsMax))" class="average" />
                    <path d="@Line(timeline.Dps, dpsMax)" class="mean" />
                </svg>
                @TimeAxis(timeline.Dps.Count)
            </div>
        </section>
    }

    @if (Result.Spirit is { Mean.Count: > 1, Max: > 0 } spirit)
    {
        <section class="card">
            <div class="card-head">
                <h3>Spirit</h3>
                <span class="legend"><i class="mean"></i>Typical fight <i class="spirit-mean"></i>Mean of every fight <i class="average"></i>Most (@N(spirit.Max))</span>
            </div>
            <div class="chart">
                @{ double spiritTop = SpiritTop(spirit.Max); }
                <div class="y">@for (int i = 4; i >= 0; i--)
                {
                    <span>@N(spiritTop * i / 4)</span>
                }</div>
                <svg viewBox="0 0 1000 240" preserveAspectRatio="none" role="img" aria-label="Spirit Points over the fight: one typical fight and the mean of every fight">
                    @for (int g = 1; g < 4; g++)
                    {
                        <line x1="0" x2="1000" y1="@(g * 60)" y2="@(g * 60)" class="grid" />
                    }
                    <line x1="0" x2="1000" y1="@Y(spirit.Max, spiritTop)" y2="@Y(spirit.Max, spiritTop)" class="average" />
                    <path d="@Line(spirit.Mean, spiritTop, nice: false)" class="spirit-mean" />
                    <path d="@Steps(spirit.Typical, spirit.Mean.Count, spiritTop)" class="mean" />
                </svg>
                @TimeAxis(spirit.Mean.Count)
            </div>
        </section>
    }

    @{
        var abilityGroups = Result.Abilities is { Count: > 0 } reported ? AbilityGroups(reported) : [];
        var groupNames = abilityGroups.Where(g => g.Parts.Count > 0).Select(g => g.Row.Name).ToList();
    }
    <section class="card">
        <div class="card-head">
            <h3>Damage by ability</h3>
            @if (groupNames.Count > 0)
            {
                bool allOpen = groupNames.All(_openGroups.Contains);
                <button type="button" class="link-button" data-save-skip data-tooltip="Every ability's sources under other names"
                        @onclick="() => SetGroupsOpen(groupNames, !allOpen)">@(allOpen ? "Collapse all" : "Expand all")</button>
            }
        </div>
        <div class="table-wrap">
            @if (Result.Abilities is { Count: > 0 } abilities)
            {
                double total = abilities.Sum(a => a.Damage);
                <table class="report-table">
                    <thead>
                        <tr>
                            <th>Ability</th>
                            <th class="amount-cell">Amount</th>
                            <th>Casts</th>
                            <th data-tooltip="Damage per cast">Avg cast</th>
                            <th>Hits</th>
                            <th data-tooltip="Damage per hit, crits included">Avg hit</th>
                            <th data-tooltip="The hits' mean chance to crit (steadier than the crits rolled)">Crit %</th>
                            <th>DPS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var groups = abilityGroups;
                            double most = groups.Max(g => g.Row.Damage);
                            bool anyGroup = groups.Any(g => g.Parts.Count > 0);
                        }
                        @foreach (var g in groups)
                        {
                            bool open = _openGroups.Contains(g.Row.Name);
                            <tr @key="g.Row.Name" class="@(g.Parts.Count > 0 ? "group" : "")">
                                <td class="name">
                                    @if (g.Parts.Count > 0)
                                    {
                                        <button type="button" class="group-toggle @(open ? "open" : "")" aria-expanded="@(open ? "true" : "false")"
                                                data-tooltip="@(open ? "Collapse" : $"Expand: {g.Parts.Count} sources")" @onclick="() => ToggleGroup(g.Row.Name)">
                                            <Icon Shape="IconShape.Chevron" Class="chevron" />
                                            <GameIcon Url="@BuildCatalog.IconUrl(g.Row.Id, g.Row.Name)" Size="22" /><span>@g.Row.Name</span>
                                        </button>
                                    }
                                    else
                                    {
                                        @if (anyGroup)
                                        {
                                            <span class="chevron-space"></span>
                                        }
                                        <GameIcon Url="@BuildCatalog.IconUrl(g.Row.Id, g.Row.Name)" Size="22" /><span>@g.Row.Name</span>
                                    }
                                </td>
                                @AbilityCells(g.Row, total, most)
                            </tr>
                            @if (open)
                            {
                                @foreach (var part in g.Parts)
                                {
                                    <tr @key="(g.Row.Name + '/' + part.Name)" class="part">
                                        <td class="name"><GameIcon Url="@BuildCatalog.IconUrl(part.Id, part.Name)" Size="22" /><span>@part.Name</span></td>
                                        @AbilityCells(part, total, most)
                                    </tr>
                                }
                            }
                        }
                        <tr class="total">
                            <td class="name">Total</td>
                            <td class="amount-cell"><span class="amount">@N(total)</span></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td>@N(Result.MeanDps)</td>
                        </tr>
                    </tbody>
                </table>
            }
            else
            {
                @* A sim saved before the report: its DPS per ability alone. *@
                <table class="report-table">
                    <thead>
                        <tr><th>Ability</th><th>DPS</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var (ability, dps) in Result.AbilityDps.OrderByDescending(a => a.Value))
                        {
                            <tr @key="ability"><td class="name"><GameIcon Url="@BuildCatalog.IconUrl(0, ability)" Size="22" /><span>@ability</span></td><td>@N(dps)</td></tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </section>

    @if (Result.Casts is { Count: > 0 } casts)
    {
        var windows = casts.GroupBy(c => (int)(c.Time / CastWindowSeconds)).ToList();
        <section class="card">
            <div class="card-head">
                <h3>Cast sequence</h3>
                <span class="legend" data-tooltip="The sampled fight nearest the mean damage, fought again with its seed and with crits and damage spread rolled">One typical fight · @N(casts.Count) casts</span>
                <span class="sequence-switches">
                    <label class="switch" data-tooltip="Every cast and hit as a line with its time, and each hit's damage">
                        <input type="checkbox" @bind="_castList" />
                        <span>List mode</span>
                    </label>
                    @if (_castList)
                    {
                        <label class="switch" data-tooltip="When each buff on the hero and each debuff on a target starts and ends, in the same fight">
                            <input type="checkbox" @bind="_castListAuras" />
                            <span>Buffs and debuffs</span>
                        </label>
                    }
                </span>
            </div>
            @if (_castList)
            {
                <div class="table-wrap cast-table">
                    <table class="report-table">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>@(_castListAuras ? "Cast, hit, buff or debuff" : "Cast or hit")</th>
                                <th>Damage</th>
                            </tr>
                        </thead>
                        <tbody>
                            <Virtualize Items="SequenceRows(casts)" Context="row" ItemSize="SequenceRowHeight" OverscanCount="20" SpacerElement="tr">
                                <tr class="@(row.Kind is null or HitKind ? null : "aura-row")">
                                    <td class="time">@Clock(row.Time, decimals: 2)</td>
                                    <td class="name">
                                        <GameIcon Url="@BuildCatalog.IconUrl(row.IconId, row.Name)" Size="22" />
                                        <span>@row.Name</span>
                                        @if (row.Kind == HitKind)
                                        {
                                            <span class="meta" data-tooltip="@($"Damage ID {row.IconId}")">@row.Kind</span>
                                        }
                                        else if (row.Kind != null)
                                        {
                                            <span class="meta">@row.Kind</span>
                                        }
                                    </td>
                                    <td class="hits">
                                        @if (row.Hits.Count > 1)
                                        {
                                            <span class="count" data-tooltip="@($"{row.Hits.Count} hits at this moment")">@(row.Hits.Count)×</span>
                                        }
                                        @foreach (var hit in row.Hits)
                                        {
                                            @* A space between amounts, so a copied line keeps them apart. *@
                                            @(" ")
                                            @if (hit.Crit)
                                            {
                                                <strong class="hit crit" data-tooltip="Critical hit">@N(hit.Amount)</strong>
                                            }
                                            else
                                            {
                                                <span class="hit">@N(hit.Amount)</span>
                                            }
                                        }
                                    </td>
                                </tr>
                            </Virtualize>
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="casts">
                    @foreach (var window in _allCasts ? windows : windows.Take(ShownCastWindows))
                    {
                        <div @key="window.Key" class="cast-row">
                            <span class="cast-time">@Clock(window.Key * CastWindowSeconds)</span>
                            <ol class="cast-list">
                                @foreach (var cast in window)
                                {
                                    <li data-tooltip="@($"{cast.Name} at {Clock(cast.Time, decimals: 2)}")">
                                        <GameIcon Url="@BuildCatalog.IconUrl(cast.Id, cast.Name)" Size="30" />
                                        <span>@cast.Time.ToString("0.0", CultureInfo.CurrentCulture)</span>
                                    </li>
                                }
                            </ol>
                        </div>
                    }
                </div>
                @if (windows.Count > ShownCastWindows)
                {
                    <button type="button" class="link-button" @onclick="() => _allCasts = !_allCasts">@(_allCasts ? "Show the first minute" : $"Show the whole fight ({N(casts.Count)} casts)")</button>
                }
            }
        </section>
    }

    @if (Result.Buffs?.Where(b => !b.OnTarget).ToList() is { Count: > 0 } buffs)
    {
        <section class="card">
            <h3>Buffs</h3>
            <div class="table-wrap">@AuraTable(buffs, "Buff")</div>
        </section>
    }

    @if (Result.Buffs?.Where(b => b.OnTarget).ToList() is { Count: > 0 } debuffs)
    {
        <section class="card">
            <h3>Debuffs</h3>
            <div class="table-wrap">@AuraTable(debuffs, "Debuff")</div>
        </section>
    }
</div>

@code {
    [Parameter, EditorRequired] public SimResult Result { get; set; } = null!;

    /// <summary>The sim's title: the saved file's name and heading.</summary>
    [Parameter] public string Title { get; set; } = "Sim";

    private ElementReference _report;

    /// <summary>
    /// A row of the damage table: an ability with its sources under other names (<see cref="Parts"/>, most damage first,
    /// the ability's own hits among them), or one source alone (no parts).
    /// </summary>
    private sealed record AbilityGroup(AbilityReport Row, IReadOnlyList<AbilityReport> Parts);

    // The abilities whose rows are open, showing their sources.
    private readonly HashSet<string> _openGroups = [];

    private void ToggleGroup(string name)
    {
        if (!_openGroups.Remove(name)) _openGroups.Add(name);
    }

    private void SetGroupsOpen(IEnumerable<string> names, bool open)
    {
        if (open) _openGroups.UnionWith(names);
        else _openGroups.Clear();
    }

    /// <summary>
    /// The damage table's rows, most damage first: each ability with the sources that are part of it as one row, its
    /// casts the ability's and its hits, damage and crits those of every source.
    /// </summary>
    private static List<AbilityGroup> AbilityGroups(IReadOnlyList<AbilityReport> abilities)
    {
        var parts = abilities.Where(a => a.Group != null).ToLookup(a => a.Group!);
        return abilities.Where(a => a.Group == null).Select(a =>
        {
            if (!parts.Contains(a.Name)) return new AbilityGroup(a, []);
            var all = parts[a.Name].Append(a).Where(p => p.Damage > 0).OrderByDescending(p => p.Damage).ToList();
            double damage = all.Sum(p => p.Damage), hits = all.Sum(p => p.Hits);
            var row = new AbilityReport(a.Name, damage, all.Sum(p => p.Dps), a.Casts, hits,
                hits > 0 ? all.Sum(p => p.CritChance * p.Hits) / hits : 0, hits > 0 ? damage / hits : 0, a.Id != 0 ? a.Id : all[0].Id);
            return new AbilityGroup(row, all);
        }).OrderByDescending(g => g.Row.Damage).ToList();
    }

    // An ability's cells after its name: its share of the damage as FellowshipLogs shows it (share, bar, damage), then
    // its casts, hits, crits and DPS. The bar is the share of the most damage of a row.
    private RenderFragment AbilityCells(AbilityReport a, double total, double most) =>
        @<text>
            <td class="amount-cell">
                <span class="amount"><span class="pct">@Percent(total > 0 ? a.Damage / total : 0)</span><span class="bar"><b style="width: @Width(most > 0 ? a.Damage / most : 0)"></b></span><span class="value">@N(a.Damage)</span></span>
            </td>
            <td>@(a.Casts > 0 ? a.Casts.ToString("N1", CultureInfo.CurrentCulture) : "–")</td>
            <td>@(a.Casts > 0 ? N(a.Damage / a.Casts) : "–")</td>
            <td>@a.Hits.ToString("N1", CultureInfo.CurrentCulture)</td>
            <td>@N(a.AverageHit)</td>
            <td>@Percent(a.CritChance)</td>
            <td>@N(a.Dps)</td>
        </text>;

    private async Task SaveAsync()
    {
        await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/FellowshipSim.UI/report/saveReport.js");
        await module.InvokeVoidAsync("save", _report, FileDownloads.FileName(Title) + ".html", Title);
    }

    /// <summary>True when <paramref name="result"/> has a DPS to bosses apart from its mean DPS: a dungeon fight with trash.</summary>
    public static bool HasBossDps(SimResult result) => result.BossDps is > 0;

    /// <summary>The cast sequence's rows: the casts of each 30 seconds.</summary>
    private const int CastWindowSeconds = 30;

    /// <summary>Rows shown until the whole fight is asked for: the first minute.</summary>
    private const int ShownCastWindows = 2;

    private bool _allCasts;

    /// <summary>The cast sequence as a list of lines (time, icon, name) a page search can find; with the buffs and debuffs.</summary>
    private bool _castList, _castListAuras;

    /// <summary>
    /// A line of the list: a cast (<see cref="Kind"/> null), hits of one damage ID with no cast at their moment
    /// (<see cref="HitKind"/>, the ID in <see cref="IconId"/>), or a buff or debuff starting or ending. <see cref="Hits"/>
    /// are the line's hits.
    /// </summary>
    private sealed record SequenceRow(double Time, string Name, int IconId, string? Kind, IReadOnlyList<HitReport> Hits);

    private const string HitKind = "hit";

    /// <summary>The height of a list line in pixels, for its virtualization: the 22-pixel icon and the cell padding.</summary>
    private const float SequenceRowHeight = 37;

    // The list's lines, kept while the result and the buff switch are the same.
    private List<SequenceRow>? _sequenceRows;
    private (SimResult Result, bool Auras)? _sequenceRowsOf;

    /// <summary>
    /// The list's lines in time order: the casts, each with the hits of its ability at its moment, then the other hits by
    /// damage ID and moment (two sources of one name, such as Rime's Winter Orb and Flight of the Navir swallows, on lines
    /// of their own), then (when asked for) each buff's and debuff's starts and ends in the same typical fight. An end
    /// at the fight's end is the fight ending, not the aura, so it has no line.
    /// </summary>
    private List<SequenceRow> SequenceRows(IReadOnlyList<CastReport> casts)
    {
        if (_sequenceRows != null && _sequenceRowsOf == (Result, _castListAuras)) return _sequenceRows;
        var hitsAt = (Result.Hits ?? []).GroupBy(h => (h.Time, h.Name, h.Id)).ToDictionary(g => g.Key, g => (IReadOnlyList<HitReport>)g.ToList());
        var rows = new List<SequenceRow>();
        foreach (var c in casts)
        {
            // Every damage ID of the cast's name at its moment: an ability's hits may log under IDs other than the cast's.
            var keys = hitsAt.Keys.Where(k => k.Time == c.Time && k.Name == c.Name).ToList();
            var hits = keys.SelectMany(k => hitsAt[k]).ToList();
            foreach (var k in keys) hitsAt.Remove(k);
            rows.Add(new SequenceRow(c.Time, c.Name, c.Id, null, hits));
        }
        rows.AddRange(hitsAt.Values.Select(h => new SequenceRow(h[0].Time, h[0].Name, h[0].Id, HitKind, h)));
        if (_castListAuras)
        {
            foreach (var aura in Result.Buffs ?? [])
            {
                var spans = aura.Spans ?? [];
                string kind = aura.OnTarget ? "debuff" : "buff";
                for (int i = 0; i + 1 < spans.Count; i += 2)
                {
                    rows.Add(new SequenceRow(spans[i], aura.Name, aura.LogId, $"{kind} gained", []));
                    if (spans[i + 1] < Result.DurationSeconds - FightEndSeconds) rows.Add(new SequenceRow(spans[i + 1], aura.Name, aura.LogId, $"{kind} faded", []));
                }
            }
        }
        // A cast before the hits and auras of the same moment, and hits before auras.
        _sequenceRows = rows.OrderBy(r => r.Time).ThenBy(r => r.Kind switch { null => 0, HitKind => 1, _ => 2 }).ToList();
        _sequenceRowsOf = (Result, _castListAuras);
        return _sequenceRows;
    }

    /// <summary>An aura ending this close to the fight's end ended with the fight.</summary>
    private const double FightEndSeconds = 0.05;

    /// <summary>Minutes and seconds, the seconds whole or with <paramref name="decimals"/> decimals.</summary>
    private static string Clock(double seconds, int decimals = 0) =>
        $"{(int)seconds / 60}:{(decimals > 0 ? (seconds % 60).ToString("00." + new string('0', decimals), CultureInfo.CurrentCulture) : ((int)seconds % 60).ToString("00", CultureInfo.CurrentCulture))}";

    /// <summary>The table of buffs or debuffs: uptime, applications, refreshes, duration, stacks and gaps.</summary>
    private RenderFragment AuraTable(IReadOnlyList<BuffReport> auras, string kind) =>
        @<table class="report-table">
            <thead>
                <tr>
                    <th>@kind</th>
                    <th class="amount-cell">Uptime</th>
                    <th data-tooltip="Applications: times it starts, per fight">Apps</th>
                    <th data-tooltip="Refreshes: times it is applied again while up, per fight">Refr.</th>
                    <th data-tooltip="Average duration">Dur.</th>
                    <th data-tooltip="Average stacks while up">Stacks</th>
                    <th data-tooltip="Most stacks">Max</th>
                    <th data-tooltip="Share of the fight at the most stacks">At max</th>
                    <th data-tooltip="Average gap: time from one ending to the next starting">Gap</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in auras)
                {
                    bool stacks = b.MaxStacks > 1;
                    <tr @key="b.Name">
                        <td class="name"><GameIcon Url="@BuildCatalog.IconUrl(b.LogId, b.Name)" Size="22" /><span>@b.Name</span></td>
                        <td class="amount-cell">
                            @* As FellowshipLogs shows it: the share, then when it was up in one typical fight. *@
                            <span class="amount">
                                <span class="pct">@Percent(b.Uptime)</span>
                                <svg class="spans" viewBox="0 0 1000 8" preserveAspectRatio="none" role="img" aria-label="@($"When {b.Name} was up in a typical fight")">
                                    <path d="@SpanPath(b.Spans)" fill="currentColor" />
                                </svg>
                            </span>
                        </td>
                        <td>@b.Applications.ToString("N1", CultureInfo.CurrentCulture)</td>
                        <td>@b.Refreshes.ToString("N1", CultureInfo.CurrentCulture)</td>
                        <td>@Seconds(b.AverageDuration)</td>
                        <td>@(stacks ? b.AverageStacks.ToString("N1", CultureInfo.CurrentCulture) : "–")</td>
                        <td>@(stacks ? b.MaxStacks.ToString(CultureInfo.CurrentCulture) : "–")</td>
                        <td>@(stacks && b.AtMaxStacks > 0 ? Percent(b.AtMaxStacks) : "–")</td>
                        <td>@(b.AverageGap > 0 ? Seconds(b.AverageGap) : "–")</td>
                    </tr>
                }
            </tbody>
        </table>;

    private const double Height = 240;

    private static string N(double value) => Math.Round(value, MidpointRounding.AwayFromZero).ToString("N0", CultureInfo.CurrentCulture);

    private static string Percent(double fraction) => (fraction * 100).ToString("0.0", CultureInfo.CurrentCulture) + "%";

    private static string Seconds(double seconds) => seconds.ToString("0.0", CultureInfo.CurrentCulture) + " s";

    private static string Width(double fraction) => Math.Clamp(fraction * 100, 0, 100).ToString("0.#", CultureInfo.InvariantCulture) + "%";

    /// <summary>The 95% confidence margin of the mean DPS, as a share of it.</summary>
    private string MarginText => Result.MeanDps > 0 && Result.Iterations > 0
        ? (1.96 * Result.StandardDeviation / Math.Sqrt(Result.Iterations) / Result.MeanDps * 100).ToString("0.00", CultureInfo.CurrentCulture) + "%"
        : "–";

    /// <summary>A thin bar for each span (start and end seconds in turn) along the fight, 1000 units wide.</summary>
    private string SpanPath(IReadOnlyList<double>? spans)
    {
        if (spans is not { Count: > 1 } || Result.DurationSeconds <= 0) return "";
        var d = new System.Text.StringBuilder();
        for (int i = 0; i + 1 < spans.Count; i += 2)
        {
            double start = spans[i] / Result.DurationSeconds * 1000, end = Math.Max(start + 2, spans[i + 1] / Result.DurationSeconds * 1000);
            d.Append('M').Append(start.ToString("0.#", CultureInfo.InvariantCulture)).Append(" 2.5H").Append(end.ToString("0.#", CultureInfo.InvariantCulture))
                .Append("V5.5H").Append(start.ToString("0.#", CultureInfo.InvariantCulture)).Append("Z ");
        }
        return d.ToString();
    }

    /// <summary>
    /// A round axis top at or above <paramref name="max"/>: 4 ticks of 1, 1.5, 2, 2.5, 3, 4, 5, 6 or 8 times a power of
    /// ten, the smallest that fits, so the line fills most of the chart's height.
    /// </summary>
    private static double Nice(double max)
    {
        if (max <= 0) return 1;
        double step = max / 4;
        double power = Math.Pow(10, Math.Floor(Math.Log10(step)));
        double unit = new[] { 1, 1.5, 2, 2.5, 3, 4, 5, 6, 8, 10 }.Select(m => m * power).First(s => s >= step);
        return unit * 4;
    }

    private static IEnumerable<string> Ticks(double max)
    {
        double top = Nice(max);
        for (int i = 0; i <= 4; i++) yield return Short(top * i / 4);
    }

    private static string Short(double value) => value switch
    {
        >= 1e6 => (value / 1e6).ToString("0.#", CultureInfo.CurrentCulture) + "M",
        >= 1e3 => (value / 1e3).ToString("0.#", CultureInfo.CurrentCulture) + "k",
        _ => value.ToString("0", CultureInfo.CurrentCulture),
    };

    private static string Y(double value, double top) => (Height - value / top * Height).ToString("0.#", CultureInfo.InvariantCulture);

    private static string X(int index, int count) => (count <= 1 ? 0 : index * 1000.0 / (count - 1)).ToString("0.#", CultureInfo.InvariantCulture);

    private static string Line(IReadOnlyList<double> values, double max, bool nice = true)
    {
        double top = nice ? Nice(max) : max;
        var d = new System.Text.StringBuilder();
        for (int i = 0; i < values.Count; i++) d.Append(i == 0 ? 'M' : 'L').Append(X(i, values.Count)).Append(' ').Append(Y(values[i], top)).Append(' ');
        return d.ToString();
    }

    /// <summary>The Spirit chart's top: the most Spirit Points rounded up to 40, so its quarters fall on round numbers.</summary>
    private static double SpiritTop(double max) => Math.Max(40, Math.Ceiling(max / 40) * 40);

    /// <summary>
    /// A line that holds each second's value until the next (a resource's level), along a chart of
    /// <paramref name="seconds"/> seconds topped at <paramref name="top"/>.
    /// </summary>
    private static string Steps(IReadOnlyList<double> values, int seconds, double top)
    {
        if (values.Count == 0 || seconds < 2) return "";
        var d = new System.Text.StringBuilder();
        for (int i = 0; i < values.Count; i++)
        {
            string x = X(i, seconds), y = Y(Math.Min(values[i], top), top);
            d.Append(i == 0 ? "M" : "H").Append(x).Append(i == 0 ? " " : "V").Append(y).Append(' ');
        }
        return d.Append('H').Append(X(Math.Min(values.Count, seconds - 1), seconds)).ToString();
    }

    /// <summary>
    /// The time axis under a chart of <paramref name="seconds"/> values: each label at its own time along the chart
    /// (<see cref="X"/>), so a fight that does not end on a label keeps its labels over their seconds.
    /// </summary>
    private static RenderFragment TimeAxis(int seconds) =>
        @<div class="x">@foreach (int t in TimeLabelSeconds(seconds))
        {
            double left = seconds <= 1 ? 0 : t * 100.0 / (seconds - 1);
            <span style="left: @(Math.Min(left, 100).ToString("0.##", CultureInfo.InvariantCulture))%">@($"{t / 60}:{t % 60:00}")</span>
        }</div>;

    /// <summary>The seconds of the time labels: at most about ten, on round minutes or half minutes.</summary>
    private static IEnumerable<int> TimeLabelSeconds(int seconds)
    {
        int step = new[] { 15, 30, 60, 120, 300, 600 }.FirstOrDefault(s => seconds / s <= 10, 600);
        for (int t = 0; t < seconds; t += step) yield return t;
    }
}

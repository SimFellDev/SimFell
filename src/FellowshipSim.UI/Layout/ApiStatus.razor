@implements IDisposable
@inject LogsSettingsStore Settings
@inject IAppViews Views
@* Whether the app can download fights from FellowshipLogs. It opens the settings. *@
<button type="button" class="status @(_connected ? "connected" : "missing")" title="FellowshipLogs API settings"
        @onclick="() => Views.ShowPage(AppPage.Setup)">
    <span class="dot" aria-hidden="true"></span>
    @(_connected ? "Logs API connected" : "Logs API not set up")
</button>

@code {
    private bool _connected;

    protected override void OnInitialized()
    {
        Read();
        Settings.Saved += OnSaved;
    }

    private void Read()
    {
        try
        {
            _connected = Settings.Credentials != null;
        }
        catch (Exception)
        {
            _connected = false;
        }
    }

    private void OnSaved() => _ = InvokeAsync(() =>
    {
        Read();
        StateHasChanged();
    });

    public void Dispose() => Settings.Saved -= OnSaved;
}

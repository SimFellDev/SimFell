@using System.Globalization
@using Microsoft.JSInterop
@using FellowshipSim.Core.Customization.Gems
@using FellowshipSim.Core.Import
@using FellowshipSim.Core.Engine
@using FellowshipSim.Core.Customization.ProtectiveEnchants
@using FellowshipSim.Core.Customization.RelicPassives
@inject ISimEngine Engine
@inject ProfileStore Profiles
@inject Visitor Visitor
@inject SimPageState State
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IDisposable
@* The Hero tab: the build's saved copies, hero, talents, stats and gear. *@

<Card>
    <div class="row toolbar">
        <input aria-label="Build name" placeholder="Build name" autocomplete="off" @bind="Build.Name" @bind:after="Changed" />
        <select @key="_pickerKey" aria-label="Saved builds" @bind:get="State.SavedName" @bind:set="LoadSavedAsked">
            <option value="">Load build...</option>
            @foreach (var saved in _saved)
            {
                <option @key="saved.Name" value="@saved.Name">@saved.Name</option>
            }
        </select>
        <button type="button" class="secondary-button" @onclick="SaveAsync">Save</button>
        <button type="button" class="secondary-button" @onclick="NewAsked">New</button>
        <button type="button" class="secondary-button" @onclick="Duplicate">Duplicate</button>
        <button type="button" class="secondary-button" aria-expanded="@(_exportOpen ? "true" : "false")" @onclick="ExportAsync">Export</button>
        <button type="button" class="secondary-button delete" disabled="@(State.SavedName.Length == 0)" @onclick="DeleteAsync">Delete</button>
        @if (OnImport.HasDelegate)
        {
            <button type="button" class="secondary-button import-button" aria-haspopup="dialog" data-tooltip="Import a character from a log, a .simc profile or a share link"
                    @onclick="OnImport">
                <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14"><path d="M8 2v8M4.5 6.5 8 10l3.5-3.5M2.5 13.5h11" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                Import
            </button>
        }
        <button type="button" class="build-link-button"aria-expanded="@(_shareOpen ? "true" : "false")" data-tooltip="Copy a link that opens this build in SimFell, for anyone you send it to" @onclick="ShareAsync">
            <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14"><path d="M10 2h4v4M14 2 8 8M12 9v4a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
            Share build
        </button>
    </div>
    @if (State.BuildStatus.Text.Length > 0)
    {
        <Message Kind="State.BuildStatus.Kind">@State.BuildStatus.Text</Message>
    }
    @if (BuildHeroes.IsBuildOnly(Build.Hero))
    {
        <Message Kind="MessageKind.Warning">@Build.Hero is not in the engine yet. You can make, save, export and share this build, but not sim it.</Message>
    }
    @if (_exportOpen)
    {
        @* The build as a profile, the text Import reads; it follows the build while it shows. *@
        <div class="export">
            <textarea aria-label="Build profile" readonly spellcheck="false" rows="8">@ExportText</textarea>
            <div class="row">
                <button type="button" class="secondary-button" @onclick="CopyExportAsync">Copy</button>
                <button type="button" class="secondary-button" data-tooltip="Save the build as a .simc file" @onclick="DownloadExportAsync">Download</button>
                <button type="button" class="secondary-button" @onclick="() => _exportOpen = false">Close</button>
            </div>
        </div>
    }
    @if (_shareOpen)
    {
        @* The build's share link; it follows the build while it shows. *@
        <div class="export">
            <p class="hint">Anyone who opens this link gets this build in SimFell, ready to sim. Pasting it into Import works too.</p>
            <input class="build-link-field"aria-label="Share link" readonly spellcheck="false" value="@ShareLink" />
            <div class="row">
                <button type="button" class="secondary-button" @onclick="CopyShareAsync">Copy</button>
                <button type="button" class="secondary-button" @onclick="() => _shareOpen = false">Close</button>
            </div>
        </div>
    }
</Card>

<div class="editor">
    <aside class="sidebar" aria-label="Hero and character sheet">
        <Card Title="Hero">
                @* Every hero's portrait, loaded with the page, so the hero menu opens with its portraits drawn. *@
                <div hidden>
                    @foreach (string hero in BuildCatalog.GameHeroes)
                    {
                        <GameIcon @key="hero" Url="@BuildCatalog.PortraitUrl(hero)" Size="36" />
                    }
                </div>
                <div class="hero-select" @onkeydown="OnHeroKeyDown">
                    <button type="button" class="hero-current @(_heroMenuOpen ? "open" : "")" aria-haspopup="listbox" aria-expanded="@(_heroMenuOpen ? "true" : "false")"
                            @onclick="() => _heroMenuOpen = !_heroMenuOpen">
                        @if (BuildCatalog.PortraitUrl(Build.Hero) is { } portrait)
                        {
                            <img src="@portrait" alt="" loading="lazy" />
                        }
                        <span class="hero-name">
                            <strong>@Build.Hero</strong>
                            <span class="meta">Change hero</span>
                        </span>
                        <svg class="chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
                    </button>
                    @if (_heroMenuOpen)
                    {
                        <div class="hero-backdrop" @onclick="() => _heroMenuOpen = false"></div>
                        <div class="hero-menu" role="listbox" aria-label="Hero">
                            <span class="group">In the engine</span>
                            @foreach (string hero in BuildCatalog.GameHeroes.Where(IsSupported))
                            {
                                bool picked = hero.Equals(Build.Hero, StringComparison.OrdinalIgnoreCase);
                                <button @key="hero" type="button" role="option" class="hero-option @(picked ? "picked" : "")" aria-selected="@(picked ? "true" : "false")"
                                        @onclick="() => PickHeroFromMenu(hero)">
                                    <GameIcon Url="@BuildCatalog.PortraitUrl(hero)" Size="36" />
                                    <span class="option-name">@hero</span>
                                    @if (picked)
                                    {
                                        <svg class="check" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l5 5L20 7" /></svg>
                                    }
                                </button>
                            }
                            <span class="group">Build Only: Not in Engine</span>
                            @foreach (string hero in BuildCatalog.GameHeroes.Where(h => !IsSupported(h)))
                            {
                                bool picked = hero.Equals(Build.Hero, StringComparison.OrdinalIgnoreCase);
                                <button @key="hero" type="button" role="option" class="hero-option @(picked ? "picked" : "")" aria-selected="@(picked ? "true" : "false")"
                                        @onclick="() => PickHeroFromMenu(hero)">
                                    <GameIcon Url="@BuildCatalog.PortraitUrl(hero)" Size="36" />
                                    <span class="option-name">@hero</span>
                                    @if (picked)
                                    {
                                        <svg class="check" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l5 5L20 7" /></svg>
                                    }
                                </button>
                            }
                        </div>
                    }
                </div>
            <h3 class="section">Character sheet</h3>
            <div class="sheet">
                <span class="sheet-label">Main stat</span>
                <strong>@Editor.TotalMainStat.ToString("N0", CultureInfo.CurrentCulture)</strong>
                @foreach (var stat in BuildEditor.InGameOrder)
                {
                    <span class="sheet-label">@StatName(stat)</span>
                    <strong class="percent">@Editor.Percent(stat).ToString("P2", CultureInfo.CurrentCulture)</strong>
                }
            </div>
            <h3 class="section">Stats</h3>
            @if (Editor.StatsFromOldProfile)
            {
                <p class="field-warning">These stats come from a profile saved before an update and are likely incorrect: they may count bonuses twice. Import the character again, or pick the gear.</p>
            }
            @* Gear: the stats of the gear worn (a log's, or the items picked summed). Total: what a sim starts with (the base stats, stat enchants, gem nodes, sigils). *@
            <div class="ratings">
                <div class="stat-group">
                    <span>Primary</span>
                    <span class="rating">
                        <span class="column" data-tooltip="The stats the gear worn gives">Gear</span>
                        <span class="total" data-tooltip="What a sim starts with: the gear's, the base stats, the stat enchants, the gem nodes and the sigils">Total</span>
                    </span>
                </div>
                <div class="rating-line">
                    Stamina
                    <span class="rating">
                        <span class="value">@Build.Stamina.ToString("N0", CultureInfo.CurrentCulture)</span>
                        <span class="total" data-tooltip="Total Stamina: the base, the gear's and the gem nodes'">@Editor.TotalStamina.ToString("N0", CultureInfo.CurrentCulture)</span>
                    </span>
                </div>
                <div class="rating-line" data-tooltip="@($"The gear's main stat; the total adds the base {StatBlock.BasePrimaryStat:0} and every bonus")">
                    Main stat
                    <span class="rating">
                        <span class="value">@Build.PrimaryStat.ToString("N0", CultureInfo.CurrentCulture)</span>
                        <span class="total" data-tooltip="Total main stat: the base, the gear's and every bonus">@Editor.TotalMainStat.ToString("N0", CultureInfo.CurrentCulture)</span>
                    </span>
                </div>
                <div class="stat-group">
                    <span>Secondary</span>
                </div>
                @foreach (var stat in BuildEditor.InGameOrder)
                {
                    <div @key="stat" class="rating-line">
                        @StatName(stat)
                        <span class="rating">
                            <span class="value">@Math.Round(Editor.Rating(stat), 2).ToString("N0", CultureInfo.CurrentCulture)</span>
                            <span class="total" data-tooltip="Total rating: the gear's, the stat enchants', the gem nodes' and the sigils'">@Editor.TotalRating(stat).ToString("N0", CultureInfo.CurrentCulture)</span>
                        </span>
                    </div>
                }
            </div>
            <div class="slots-total @(Editor.UsedTotal > Editor.TotalLimit || !Editor.FitsGear ? "over" : "")"
                 data-tooltip="@($"Slots filled: stat enchants, gem power bonuses, and aspect, sigil and glyph ranks (protective enchants not counted){(Editor.HasWeapon ? "; the weapon adds 5" : "")}")">
                <span>Slots</span>
                <strong>@Editor.UsedTotal / @Editor.TotalLimit</strong>
            </div>
            <h3 class="section">Gem power</h3>
            <div class="gem-totals">
                @foreach (var color in BuildCatalog.GemColors)
                {
                    double power = Editor.SheetGem(color);
                    <span @key="color" class="gem-total @(power > 0 ? "taken" : "")">
                        <GameIcon Url="@BuildCatalog.GemIconUrl(color)" Size="20" />
                        @color
                        <strong>@power.ToString("N0", CultureInfo.CurrentCulture)</strong>
                    </span>
                }
            </div>
        </Card>
    </aside>

    <div class="editor-main">
        <Card Title="Talents" Collapsible="true" Collapsed='@Folded("Talents")' CollapsedChanged='v => Fold("Talents", v)'>
            <div class="points">
                <span class="count" data-tooltip="Talent points spent">@(FellowshipSim.Core.Domain.Hero.TalentPoints - Editor.PointsLeft) / @FellowshipSim.Core.Domain.Hero.TalentPoints</span>
                <button type="button" class="secondary-button small" @onclick="ClearTalents">Clear all</button>
            </div>
            <div class="tree">
                @foreach (var row in Catalog.Talents.GroupBy(t => t.Slot.Row))
                {
                    <div @key="row.Key" class="tree-row">
                        <span class="tier">@Roman(row.Key) <span class="meta">- @row.First().Slot.Cost pt</span></span>
                        @foreach (var t in row)
                        {
                            bool picked = Editor.HasTalent(t.Slot.TalentId);
                            bool affordable = picked || t.Slot.Cost <= Editor.PointsLeft;
                            <button @key="t.Slot.TalentId" type="button" class="talent @(picked ? "picked" : "")" aria-pressed="@picked"
                                    disabled="@(!affordable)" data-tooltip="@TalentTitle(t)"
                                    @onclick="() => ToggleTalent(t)">
                                <GameIcon Url="@t.Talent.IconUrl" Size="36" />
                                <span class="name">@t.Talent.Name</span>
                            </button>
                        }
                    </div>
                }
            </div>
        </Card>

        <Card Title="Gear" Count="@($"{Editor.GearWorn} / {GearSlots.All.Count}")" CountTitle="Slots with an item worn"
              Collapsible="true" Collapsed='@Folded("Gear")' CollapsedChanged='v => Fold("Gear", v)'>
            @* The armor down the left, the neck, wrists, rings, relics and weapon down the right. *@
            <div class="gear-slots">
                @foreach (var slot in GearSlots.All)
                {
                    var item = Editor.Item(slot);
                    var piece = Editor.Piece(slot);
                    <div @key="slot" class="gear-slot @(item != null ? "worn" : "")">
                        <img class="slot-icon @(item == null ? "empty" : item.Legendary ? "legendary" : "")" alt="" width="40" height="40"
                             src="@(item != null ? GameIcons.Url(item.Icon) : GearPicker.EmptyIconUrl(slot))" />
                        <span class="slot-label">@GearSlots.Label(slot)</span>
                        <button type="button" class="slot-button" aria-haspopup="dialog" aria-label="@($"{GearSlots.Label(slot)}: {item?.Name ?? "empty"}")"
                                @onclick="() => _pickerSlot = slot">
                            <span class="slot-item @(item?.Legendary == true ? "legendary-name" : item == null ? "none" : "")">@(item?.Name ?? "— empty —")</span>
                            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        </button>
                        @if (item != null && piece != null)
                        {
                            var stats = item.StatsAt(piece.Tempers);
                            <span class="slot-stats">
                                @foreach (var (name, value) in SlotStats(stats))
                                {
                                    <span @key="name" class="slot-stat @(name == Catalog.MainStatShort ? "primary" : "")">@name <strong>@value</strong></span>
                                }
                            </span>
                        }
                    </div>
                }
            </div>
        </Card>
        @if (_pickerSlot is { } pickerSlot)
        {
            <GearPicker Editor="Editor" Slot="pickerSlot" @bind-Sort="_gearSort" OnChanged="Changed" OnClose="() => _pickerSlot = null" />
        }

        @* Two columns, each card under the one above it: a folded card lets the next move up. A narrow window shows
           them in one column, row by row as the cards pair. *@
        <div class="loadout-columns">
            <div class="loadout-column">
                <div class="loadout-card" style="order: 1">
                    <Card Title="Stat enchants" Collapsible="true" Collapsed='@Folded("Stat enchants")' CollapsedChanged='v => Fold("Stat enchants", v)' CountContent="@GearCount(EnchantSlot.StatEnchants)" CountTitle="@GearTitle(EnchantSlot.StatEnchants)" Over="@GearOver(EnchantSlot.StatEnchants)">
                        <div class="enchants">
                            @foreach (var e in Catalog.StatEnchants)
                            {
                                double rating = Editor.StatEnchantRating(e.Enchant.Id);
                                int count = Editor.StatEnchantCount(e.Enchant.Id);
                                bool full = Editor.Room(EnchantSlot.StatEnchants, e.Enchant.Id) <= 0;
                                <div @key="e.Enchant.Id" class="enchant @(rating > 0 ? "taken" : "")">
                                    <GameIcon Url="@e.IconUrl" Size="34" />
                                    <span class="enchant-name">
                                        @e.Name
                                        <span class="enchant-stats">@e.StatsText@(rating > 0 ? $" · {rating.ToString("0.#", CultureInfo.CurrentCulture)} rating" : "")</span>
                                    </span>
                                    <span class="stepper">
                                        <button type="button" class="icon-button" aria-label="@($"One fewer {e.Name}")" disabled="@(count <= 0)"
                                                @onclick="() => Set(() => Editor.SetStatEnchantCount(e.Enchant, count - 1))">−</button>
                                        <input type="number" min="0" step="1" aria-label="@EnchantLabel(e)" @bind:get="count" @bind:set="v => Set(() => Editor.SetStatEnchantCount(e.Enchant, v))" />
                                        <button type="button" class="icon-button" aria-label="@($"One more {e.Name}")" disabled="@full" data-tooltip="@(full ? FullText(EnchantSlot.StatEnchants) : null)"
                                                @onclick="() => Set(() => Editor.SetStatEnchantCount(e.Enchant, count + 1))">+</button>
                                    </span>
                                </div>
                            }
                        </div>
                    </Card>
                </div>
                <div class="loadout-card" style="order: 3">
                    <Card Title="Aspects" Collapsible="true" Collapsed='@Folded("Aspects")' CollapsedChanged='v => Fold("Aspects", v)' CountContent="@GearCount(EnchantSlot.Aspects)" CountTitle="@GearTitle(EnchantSlot.Aspects)" Over="@GearOver(EnchantSlot.Aspects)">
                        <RankedChoices Options="Catalog.Aspects" RankOf="Editor.AugmentationRank" SetRank="(o, r) => Set(() => Editor.SetAugmentationRank(o, r))"
                                       RoomOf="id => Editor.Room(EnchantSlot.Aspects, id)" FullText="@FullText(EnchantSlot.Aspects)" />
                    </Card>
                </div>
                <div class="loadout-card" style="order: 5">
                    <Card Title="Glyphs" Collapsible="true" Collapsed='@Folded("Glyphs")' CollapsedChanged='v => Fold("Glyphs", v)' CountContent="@GearCount(EnchantSlot.Glyphs)" CountTitle="@GearTitle(EnchantSlot.Glyphs)" Over="@GearOver(EnchantSlot.Glyphs)">
                        <RankedChoices Options="Catalog.Glyphs" RankOf="Editor.GlyphRank" SetRank="(o, r) => Set(() => Editor.SetGlyphRank(o, r))"
                                       RoomOf="id => Editor.Room(EnchantSlot.Glyphs, id)" FullText="@FullText(EnchantSlot.Glyphs)" />
                    </Card>
                </div>
            </div>
            <div class="loadout-column">
                <div class="loadout-card" style="order: 2">
                    <Card Title="Gems" Collapsible="true" Collapsed='@Folded("Gems")' CollapsedChanged='v => Fold("Gems", v)' CountContent="@GearCount(EnchantSlot.Gems)" CountTitle="@GearTitle(EnchantSlot.Gems)" Over="@GearOver(EnchantSlot.Gems)">
                            <div class="sockets">
                                @for (int i = 0; i < GemItem.Sockets; i++)
                                {
                                    int socket = i;
                                    var gem = Editor.Socket(socket);
                                    if (gem == null)
                                    {
                                        <span @key="socket" class="socket empty" data-tooltip="Empty socket"></span>
                                    }
                                    else
                                    {
                                        <button @key="socket" type="button" class="socket filled" data-tooltip="@($"Take out the {gem.Name}")" aria-label="@($"Take out the {gem.Name}")"
                                                @onclick="() => Set(() => Editor.SetSocket(socket, null))">
                                            <GameIcon Url="@BuildCatalog.GemIconUrl(gem)" Size="32" />
                                        </button>
                                    }
                                }
                            </div>
                        <div class="gem-rows">
                            @foreach (var color in BuildCatalog.GemColors)
                            {
                                int bonuses = Editor.GearBonuses(color);
                                bool socketsFull = Build.SocketedGemIds.Count >= GemItem.Sockets;
                                <div @key="color" class="gem-row @(Editor.Gem(color) > 0 ? "taken" : "")">
                                    <span class="gem-name">@color</span>
                                    <span class="gem-picks">
                                        @foreach (var g in GemItem.All.Where(g => g.Color == color))
                                        {
                                            int count = Editor.SocketedCount(g.Id);
                                            <button @key="g.Id" type="button" class="gem-pick @(count > 0 ? "picked" : "")" disabled="@socketsFull"
                                                    data-tooltip="@(socketsFull ? "Every socket is filled: take a gem out first" : $"Socket a {g.Name} (+{g.Power})")"
                                                    @onclick="() => Set(() => Editor.AddGem(g.Id))">
                                                <GameIcon Url="@BuildCatalog.GemIconUrl(g)" Size="26" />
                                                <span class="gem-pick-power">@g.Power</span>
                                                @if (count > 0)
                                                {
                                                    <span class="gem-count">×@count</span>
                                                }
                                            </button>
                                        }
                                    </span>
                                    <span class="gear-bonus">
                                                    <span class="stepper">
                                            <button type="button" class="icon-button" aria-label="@($"One fewer {color} gear bonus")" disabled="@(bonuses <= 0)"
                                                    @onclick="() => Set(() => Editor.SetGearBonuses(color, bonuses - 1))">−</button>
                                            <input type="number" min="0" step="1" aria-label="@($"{color} gear bonuses")" @bind:get="bonuses" @bind:set="v => Set(() => Editor.SetGearBonuses(color, Math.Max(0, v)))" />
                                            <button type="button" class="icon-button" aria-label="@($"One more {color} gear bonus")" disabled="@(Editor.Room(EnchantSlot.Gems) <= 0)"
                                                    data-tooltip="@(Editor.Room(EnchantSlot.Gems) <= 0 ? FullText(EnchantSlot.Gems) : null)"
                                                    @onclick="() => Set(() => Editor.SetGearBonuses(color, bonuses + 1))">+</button>
                                        </span>
                                    </span>
                                </div>
                            }
                        </div>
                    </Card>
                </div>
                <div class="loadout-card" style="order: 4">
                    <Card Title="Sigils" Collapsible="true" Collapsed='@Folded("Sigils")' CollapsedChanged='v => Fold("Sigils", v)' CountContent="@GearCount(EnchantSlot.Sigils)" CountTitle="@GearTitle(EnchantSlot.Sigils)" Over="@GearOver(EnchantSlot.Sigils)">
                        <RankedChoices Options="Catalog.Sigils" RankOf="Editor.AugmentationRank" SetRank="(o, r) => Set(() => Editor.SetAugmentationRank(o, r))"
                                       RoomOf="id => Editor.Room(EnchantSlot.Sigils, id)" FullText="@FullText(EnchantSlot.Sigils)" />
                    </Card>
                </div>
                <div class="loadout-card" style="order: 6">
                    <Card Title="Protective enchants" Collapsible="true" Collapsed='@Folded("Protective enchants")' CollapsedChanged='v => Fold("Protective enchants", v)' Count="@SlotCount(EnchantSlot.Protective)" CountTitle="@SlotTitle(EnchantSlot.Protective)" Over="@SlotOver(EnchantSlot.Protective)">
                        <div class="chips">
                            @foreach (var p in Catalog.ProtectiveEnchants)
                            {
                                bool taken = Editor.AugmentationRank(p.Id) > 0;
                                bool full = !taken && Editor.Room(EnchantSlot.Protective) <= 0;
                                <button @key="p.Id" type="button" class="chip @(taken ? "picked" : "")" aria-pressed="@taken" disabled="@full"
                                        data-tooltip="@(full ? FullText(EnchantSlot.Protective) : null)" @onclick="() => Set(() => Editor.ToggleProtectiveEnchant(p))">
                                    <GameIcon Url="@p.IconUrl" Size="24" />
                                    @p.Name
                                </button>
                            }
                        </div>
                    </Card>
                </div>
            </div>
        </div>
    </div>
</div>

@if (State.HasBuildEdits)
{
    @* Over the bottom of the window while the build has changes not saved; a step waiting on them asks first. *@
    <div class="unsaved-space"></div>
    <div class="unsaved" role="@(_pending != null ? "alertdialog" : "status")" aria-label="Unsaved changes">
        <span>
            @(Build.Name.Trim().Length > 0 ? Build.Name.Trim() : "This build") has changes that are not saved.@(_pending is { } pending ? $" Save them before {pending.What}?" : "")
        </span>
        <button type="button" @onclick="SaveThenContinue">Save</button>
        <button type="button" class="secondary-button" @onclick="DiscardThenContinue">Discard</button>
        @if (_pending != null)
        {
            <button type="button" class="secondary-button" @onclick="CancelPending">Cancel</button>
        }
    </div>
}

@code {
    /// <summary>Called after every change to the build.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>Opens the Import dialog; the toolbar has an Import button when set.</summary>
    [Parameter] public EventCallback OnImport { get; set; }

    // The gear slot whose item picker shows, and the column every picker sorts by.
    private GearSlot? _pickerSlot;
    private string _gearSort = GearPicker.ItemColumn;

    private bool Folded(string card) => State.CollapsedCards.Contains(card);

    private void Fold(string card, bool folded)
    {
        if (folded) State.CollapsedCards.Add(card);
        else State.CollapsedCards.Remove(card);
    }

    // An item's stats under its slot: the main stat, the ratings in the game's order, Stamina last; none it lacks.
    private IEnumerable<(string Name, int Value)> SlotStats(GearStats stats) =>
        new (string, int)[] { (Catalog.MainStatShort, stats.Primary), ("Crit", stats.Crit), ("Exp", stats.Expertise), ("Haste", stats.Haste), ("Spirit", stats.Spirit), ("Stam", stats.Stamina) }
            .Where(s => s.Item2 > 0);

    private IReadOnlyList<string> _heroes = [];
    private IReadOnlyList<ProfileEntry> _saved = [];
    // The hero _saved lists the builds of.
    private string? _savedHero;

    // The step waiting on the unsaved changes (open another hero, build or a new one), and a key that draws the picker
    // anew so a cancelled pick shows the build still open.
    private (string What, Func<Task> Then)? _pending;
    private int _pickerKey;

    private BuildEditor Editor => State.Editor;
    private CharacterBuild Build => State.Build;
    private BuildCatalog Catalog => Editor.Catalog;

    protected override async Task OnInitializedAsync()
    {
        // A build loaded from a sim's result swaps State.Editor while this editor shows: its parameters stay the same, so
        // it redraws on the state's word.
        State.Changed += OnStateChanged;
        try
        {
            _heroes = await Engine.GetHeroesAsync();
            await LoadSavedListAsync(force: true);
        }
        catch (Exception e)
        {
            State.BuildStatus = MessageState.Error(e.Message);
        }
    }

    private void OnStateChanged() => _ = InvokeAsync(async () =>
    {
        StateHasChanged();
        try
        {
            await LoadSavedListAsync();
            StateHasChanged();
        }
        catch (Exception e)
        {
            State.BuildStatus = MessageState.Error(e.Message);
            StateHasChanged();
        }
    });

    public void Dispose() => State.Changed -= OnStateChanged;

    private static string EnchantLabel(StatEnchantOption e) => $"{e.Name} count";

    // A card's count against its limit ("4 / 12"), what it counts, and whether it is over.
    private string SlotCount(EnchantSlot slot) => $"{Editor.Used(slot)} / {Editor.Limit(slot)}";

    private string SlotTitle(EnchantSlot slot) => $"{EnchantSlots.Name(slot)} worn, of {Editor.Limit(slot)}" +
        (Editor.HasWeapon && Editor.Limit(slot) != EnchantSlots.Limit(slot, weapon: false) ? " (the weapon adds some)" : "");

    private bool SlotOver(EnchantSlot slot) => Editor.Used(slot) > Editor.Limit(slot);

    // A gear kind's count: on the armor (or all gear) against its most, the room left, and the weapon's tree on a line of its own.
    private RenderFragment GearCount(EnchantSlot slot) => __builder =>
    {
        int room = Editor.Room(slot);
        int weaponLimit = GearFit.WeaponLimit(slot, Editor.HasWeapon);
        <span class="gear-count">
            <span>
                <span class="@(room > 0 ? "room" : "full")">@(room > 0 ? $"{room} Slots Available" : "Full")</span>
            </span>
            @if (weaponLimit > 0)
            {
                <span><span class="where">Weapon</span> @Editor.WeaponUsed(slot) / @weaponLimit</span>
            }
        </span>
    };

    private string GearTitle(EnchantSlot slot) => slot is EnchantSlot.StatEnchants or EnchantSlot.Gems
        ? $"{EnchantSlots.Name(slot)} on gear, of the {GearFit.GearLimit(slot)} its {EnchantSlots.ArmorPieces + EnchantSlots.OtherPieces} pieces hold (2 each). Room: how many more fit with the rest of your enchants."
        : $"{EnchantSlots.Name(slot)} on armor, of the {GearFit.GearLimit(slot)} its {EnchantSlots.ArmorPieces} pieces hold (2 each). Room: how many more fit; stat enchants and gems fill the other pieces first.";

    private bool GearOver(EnchantSlot slot) => Editor.GearUsed(slot) > GearFit.GearLimit(slot) || !Editor.FitsGear;

    // Why a + is off: this kind is at its most, or no slot that takes it is left.
    private string FullText(EnchantSlot slot) => (slot == EnchantSlot.Protective || Editor.Used(slot) >= Editor.Limit(slot)
        ? $"At the limit of {Editor.Limit(slot)} {EnchantSlots.Name(slot)}"
        : slot is EnchantSlot.StatEnchants or EnchantSlot.Gems
            ? $"No slot left that takes {EnchantSlots.Name(slot)}: take off another enchant to make room"
            : $"No armor slot left for {EnchantSlots.Name(slot)}: stat enchants and gems fill the other pieces first, then armor")
        + (GearFit.WeaponLimit(slot, Editor.HasWeapon) > 1 ? ". The weapon's slots take different ones, never two of the same" : "");

    private static string TalentTitle(TalentOption t) => $"{t.Slot.Code}: {t.Talent.Name}";

    private static string Roman(int row) => row switch { 1 => "I", 2 => "II", 3 => "III", 4 => "IV", 5 => "V", 6 => "VI", _ => row.ToString() };

    private static int? Id(string value) => int.TryParse(value, out int id) ? id : null;

    private Task Changed() => OnChanged.InvokeAsync();

    // A child's change (RankedChoices calls back through a Func, not an EventCallback) redraws only the child, so this
    // editor redraws itself too: its counts and every stepper's room change with it.
    private Task Set(Action change)
    {
        change();
        StateHasChanged();
        return Changed();
    }

    private Task ToggleTalent(TalentOption talent)
    {
        if (!Editor.ToggleTalent(talent)) State.BuildStatus = MessageState.Error($"{talent.Talent.Name} costs {talent.Slot.Cost} points; {Editor.PointsLeft} are left.");
        return Changed();
    }

    private Task ClearTalents() => Set(Editor.ClearTalents);

    private bool _heroMenuOpen;

    private bool IsSupported(string hero) => _heroes.Contains(hero, StringComparer.OrdinalIgnoreCase);

    private void OnHeroKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _heroMenuOpen = false;
    }

    private Task PickHeroFromMenu(string hero)
    {
        _heroMenuOpen = false;
        if (hero.Equals(Build.Hero, StringComparison.OrdinalIgnoreCase)) return Task.CompletedTask;
        return AskFirst($"opening {hero}", () => PickHero(hero));
    }

    // Builds are saved per hero: the picker lists the new hero's builds.
    private async Task PickHero(string hero)
    {
        State.Editor = new BuildEditor(BuildEditor.NewBuild(hero));
        State.SavedName = "";
        State.MarkBuildClean();
        State.BuildStatus = MessageState.None;
        try
        {
            await LoadSavedListAsync(force: true);
        }
        catch (Exception e)
        {
            State.BuildStatus = MessageState.Error(e.Message);
        }
        await Changed();
    }

    /// <summary>Runs <paramref name="then"/> now, or after asking to save when the build has changes not saved.</summary>
    private Task AskFirst(string what, Func<Task> then)
    {
        if (!State.HasBuildEdits) return then();
        _pending = (what, then);
        _pickerKey++;
        return Task.CompletedTask;
    }

    private async Task SaveThenContinue()
    {
        await SaveAsync();
        // A save that failed keeps the question, with the reason in the status.
        if (State.HasBuildEdits || _pending is not { } pending) return;
        _pending = null;
        await pending.Then();
    }

    // With no step waiting, the build goes back to how it was last loaded, saved or started anew.
    private async Task DiscardThenContinue()
    {
        if (_pending is not { } pending)
        {
            State.DiscardBuildEdits();
            State.BuildStatus = MessageState.None;
            await Changed();
            return;
        }
        _pending = null;
        await pending.Then();
    }

    private void CancelPending() => _pending = null;

    private bool _exportOpen;

    private string ExportText => new SimcProfile(Build, "").Format();

    // Shows the build's profile and copies it: the text Import takes, to share or to keep.
    private async Task ExportAsync()
    {
        _exportOpen = true;
        _shareOpen = false;
        await CopyExportAsync();
    }

    /// <summary>Where a share link made outside a public site (the desktop app, a local server) opens: the browser app.</summary>
    private const string PublicSite = "https://simfelldev.github.io/";

    private bool _shareOpen;

    // The site's own address when others can open it, the browser app's otherwise.
    private string ShareSite()
    {
        var site = new Uri(Navigation.BaseUri);
        bool shareable = site.Scheme is "http" or "https" && !site.IsLoopback && site.Host != "0.0.0.0";
        return shareable ? Navigation.BaseUri : PublicSite;
    }

    private string ShareLink => BuildShareLink.Create(ShareSite(), Build);

    // Shows the build's share link and copies it.
    private async Task ShareAsync()
    {
        _shareOpen = true;
        _exportOpen = false;
        await CopyShareAsync();
    }

    private async Task CopyShareAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", ShareLink);
            State.BuildStatus = MessageState.Ok("Copied the build's share link. Opening it, or pasting it into Import, loads the build.");
        }
        catch (Exception e) when (e is JSException or TaskCanceledException or InvalidOperationException)
        {
            State.BuildStatus = new MessageState("Select the link below and copy it. Opening it, or pasting it into Import, loads the build.");
        }
    }

    private Task DownloadExportAsync() => FileDownloads.SaveAsync(JS, Build.Name, ".simc", ExportText);

    private async Task CopyExportAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", ExportText);
            State.BuildStatus = MessageState.Ok("Copied the build to the clipboard. Import takes it as a profile.");
        }
        catch (Exception e) when (e is JSException or TaskCanceledException or InvalidOperationException)
        {
            State.BuildStatus = new MessageState("Select the build's text below and copy it. Import takes it as a profile.");
        }
    }

    private Task NewAsked() => AskFirst("starting a new build", New);

    private Task New()
    {
        State.Editor = new BuildEditor(BuildEditor.NewBuild(Build.Hero));
        State.SavedName = "";
        State.MarkBuildClean();
        State.BuildStatus = MessageState.None;
        return Changed();
    }

    // The rating's percentage is the log's character sheet until the rating changes.
    private static string StatName(RatedStat stat) => stat == RatedStat.Crit ? "Critical strike" : stat.ToString();


    // A copy of the build, not saved yet, named after it.
    private Task Duplicate()
    {
        var copy = SimcProfile.Parse(new SimcProfile(Build, "").Format()).Build;
        copy.Name = $"{Build.Name} copy";
        State.Editor = new BuildEditor(copy);
        State.SavedName = "";
        State.BuildStatus = MessageState.Ok($"Copied to {copy.Name}; save it to keep it.");
        return Changed();
    }

    // A build from an import or a sim's run can be another hero's, so the list reads the builds of the hero shown.
    private async Task LoadSavedListAsync(bool force = false)
    {
        string hero = Build.Hero;
        if (!force && hero.Equals(_savedHero, StringComparison.OrdinalIgnoreCase)) return;
        var saved = (await Profiles.ListAsync(Visitor, [hero])).ToList();
        // The build shows another hero now, whose list replaces this one.
        if (!hero.Equals(Build.Hero, StringComparison.OrdinalIgnoreCase)) return;
        _saved = saved;
        _savedHero = hero;
    }

    private Task LoadSavedAsked(string name) => name.Length > 0 ? AskFirst($"opening {name}", () => LoadSavedAsync(name)) : LoadSavedAsync(name);

    private async Task LoadSavedAsync(string name)
    {
        State.SavedName = name;
        if (name.Length == 0) return;
        try
        {
            string text = await Profiles.ReadAsync(Visitor, new ProfileEntry(Build.Hero, name))
                          ?? throw new KeyNotFoundException($"No build named {name}.");
            var build = SimcProfile.Parse(text).Build;
            build.Name = name;
            State.Editor = new BuildEditor(build);
            State.MarkBuildClean();
            State.BuildStatus = MessageState.Ok($"Loaded {name}.");
            await Changed();
        }
        catch (Exception e)
        {
            State.BuildStatus = MessageState.Error(e.Message);
        }
    }

    private async Task SaveAsync()
    {
        string name = Build.Name.Trim();
        if (!ActionListStore.IsValidName(name))
        {
            State.BuildStatus = MessageState.Error("Name the build with letters, digits, spaces, '_' and '-' (up to 64 characters).");
            return;
        }
        try
        {
            Build.Name = name;
            await Profiles.SaveAsync(Visitor, new ProfileEntry(Build.Hero, name), new SimcProfile(Build, "").Format());
            await LoadSavedListAsync(force: true);
            State.SavedName = name;
            State.MarkBuildClean();
            State.BuildStatus = MessageState.Ok($"Saved {name} to your builds.");
        }
        catch (Exception e)
        {
            State.BuildStatus = MessageState.Error(e.Message);
        }
    }

    private async Task DeleteAsync()
    {
        string name = State.SavedName;
        try
        {
            await Profiles.DeleteAsync(Visitor, new ProfileEntry(Build.Hero, name));
            await LoadSavedListAsync(force: true);
            State.SavedName = "";
            State.BuildStatus = MessageState.Ok($"Deleted {name}. The editor keeps the build until you change it.");
        }
        catch (Exception e)
        {
            State.BuildStatus = MessageState.Error(e.Message);
        }
    }
}

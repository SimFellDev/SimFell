@using System.Globalization
@*
    The fight of a sim or of the APL Debugger: training dummies or a dungeon (the Fight card), the dungeon's pulls, then
    the fight's settings (the Fight settings card).
*@
<Card Title="Fight">
    <div class="choices" role="radiogroup" aria-label="Fight">
        <label class="choice @(State.Mode == SimMode.TrainingDummies ? "on" : "")">
            <input type="radio" name="@_group" checked="@(State.Mode == SimMode.TrainingDummies)" @onchange="() => State.Mode = SimMode.TrainingDummies" />
            <strong>Training dummies</strong>
            <span class="meta">Training dummies for the full fight. With two or more dummies, the report also shows the DPS to the first dummy.</span>
        </label>
        <label class="choice @(State.Mode == SimMode.Dungeon ? "on" : "")">
            <input type="radio" name="@_group" checked="@(State.Mode == SimMode.Dungeon)" @onchange="() => State.Mode = SimMode.Dungeon" />
            <strong>Dungeon</strong>
            <span class="meta">Trash pulls and boss pulls in sequence. Each pull ends when its enemies die. The report also shows the DPS to bosses.</span>
        </label>
    </div>
</Card>

@if (State.Mode == SimMode.Dungeon)
{
    <DungeonCard State="State" OnChanged="OnChanged" />
}

<Card Title="Fight settings">
    <div class="fields">
        @if (State.Mode == SimMode.Dungeon)
        {
            <div class="field">
                Pulls
                <span class="length">@State.Dungeon.Pulls.Count</span>
            </div>
        }
        else
        {
            <label class="field">
                Duration (seconds)
                <input type="number" min="1" step="any" @bind="State.DurationSeconds" />
            </label>
            <label class="field">
                Training dummies
                <input type="number" class="short" min="1" step="1"
                       @bind:get="State.TrainingDummies" @bind:set="v => State.TrainingDummies = Math.Max(1, v)" />
            </label>
        }
        @if (State.Mode == SimMode.TrainingDummies)
        {
            <div class="toggle-block">
                <label class="switch">
                    <input type="checkbox" @bind="State.Boss" />
                    <span>The dummies are bosses</span>
                </label>
            </div>
        }
        <div class="toggle-block">
            <label class="switch">
                <input type="checkbox" @bind="State.StartWithSpirit" />
                <span>Start with Spirit</span>
            </label>
        </div>
        <label class="field @(State.StartWithSpirit ? "" : "off")">
            Spirit (0 – @N(MaxStartingSpirit))
            <input type="number" class="short" min="0" max="@MaxStartingSpirit" step="1" disabled="@(!State.StartWithSpirit)"
                   @bind:get="State.StartingSpirit" @bind:set="v => State.StartingSpirit = Math.Clamp(v, 0, MaxStartingSpirit)" />
        </label>
        @MoreSettings
    </div>
</Card>

@code {
    /// <summary>The fight's settings: the Sim page's, or the APL Debugger's own.</summary>
    [Parameter, EditorRequired] public SimPageState State { get; set; } = null!;

    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>Settings of the place the cards show, after the Fight settings card's own (the APL Debugger's seed).</summary>
    [Parameter] public RenderFragment? MoreSettings { get; set; }

    /// <summary>The most Spirit a fight can start with: a build with Ancestral Surge - II holds 130.</summary>
    public const double MaxStartingSpirit = 130;

    // The radio group's name, its own in each place the cards show (the Sim page and the APL Debugger).
    private readonly string _group = $"mode-{Guid.NewGuid():N}";

    private static string N(double value) => value.ToString("0.#", CultureInfo.CurrentCulture);
}

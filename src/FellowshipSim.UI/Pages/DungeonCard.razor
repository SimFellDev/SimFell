@using System.Globalization
@using FellowshipSim.Core.Dungeons
@using Microsoft.JSInterop

@inject DungeonStore Store
@inject Visitor Visitor
@inject IJSRuntime JS
@inject DungeonImport Dungeons
@*
    The dungeon of a dungeon fight (FightCards): its name and the saved dungeons, its comment and time limit,
    then its pulls in the order they run, each built as an action of the action-list editor. Import reads a fight's dungeon from
    its log link, or a dungeon profile from a file or pasted; Export shows the profile text.
*@
<Card Title="Dungeon">
    <div class="row toolbar">
        <input aria-label="Dungeon name" placeholder="Dungeon name" autocomplete="off"
               @bind:get="State.Dungeon.Name" @bind:set="v => Change(State.Dungeon with { Name = v.Trim() })" />
        <select @key="_pickerKey" aria-label="Saved dungeons" @bind:get="State.DungeonValue" @bind:set="PickAsked">
            @if (State.DungeonValue.Length == 0)
            {
                <option value="">Load dungeon...</option>
            }
            @foreach (var saved in _saved)
            {
                <option @key="ValueOf(saved)" value="@ValueOf(saved)">@saved.Name@(saved.BuiltIn ? " (built in)" : "")</option>
            }
        </select>
        <div class="icons">
            <button type="button" class="icon-button" aria-label="Revert" disabled="@(!CanRevert)"
                    data-tooltip="Undo the changes not saved" @onclick="Revert"><Icon Shape="IconShape.Revert" /></button>
            <button type="button" class="icon-button" aria-label="Save" data-tooltip="Save" @onclick="Save"><Icon Shape="IconShape.Save" /></button>
            <button type="button" class="icon-button" aria-label="Duplicate" data-tooltip="Duplicate" @onclick="Duplicate"><Icon Shape="IconShape.Duplicate" /></button>
            <span class="divider" aria-hidden="true"></span>
            <button type="button" class="icon-button" aria-label="Import" aria-haspopup="dialog" data-tooltip="Import a dungeon from a log or a .simc profile"
                    @onclick="OpenImport"><Icon Shape="IconShape.Import" /></button>
            <button type="button" class="icon-button" aria-label="Export" aria-expanded="@(_exportOpen ? "true" : "false")" data-tooltip="Export the dungeon as a .simc profile"
                    @onclick="ExportAsync"><Icon Shape="IconShape.Export" /></button>
            <span class="divider" aria-hidden="true"></span>
            <button type="button" class="icon-button danger-button delete" aria-label="Delete" disabled="@(!CanDelete)"
                    data-tooltip="@(CanDelete ? "Delete" : "Only your own saved dungeons can be deleted")" @onclick="Delete"><Icon Shape="IconShape.Bin" /></button>
        </div>
    </div>
    @if (_exportOpen)
    {
        @* The dungeon as a profile, the text Import reads; it follows the dungeon while it shows. *@
        <div class="export">
            <textarea aria-label="Dungeon profile" readonly spellcheck="false" rows="8">@State.Dungeon.Format()</textarea>
            <div class="row">
                <button type="button" class="secondary-button" @onclick="CopyExportAsync">Copy</button>
                <button type="button" class="secondary-button" data-tooltip="Save the dungeon as a .simc file" @onclick="Download">Download</button>
                <button type="button" class="secondary-button" @onclick="() => _exportOpen = false">Close</button>
            </div>
        </div>
    }
    @if (_pending is { } pending)
    {
        <div class="confirm" role="alertdialog" aria-label="Unsaved changes">
            <span>@State.Dungeon.Name has changes that are not saved. Save them before @pending.What?</span>
            <button type="button" @onclick="SaveThenContinue">Save</button>
            <button type="button" class="secondary-button" @onclick="DiscardThenContinue">Discard</button>
            <button type="button" class="secondary-button" @onclick="() => _pending = null">Cancel</button>
        </div>
    }
    <Message Kind="_status.Kind">@_status.Text</Message>
    <textarea class="comment" rows="@CommentRows" placeholder="Comment" aria-label="Dungeon comment" spellcheck="true"
              @bind:get="State.Dungeon.Comment ?? string.Empty" @bind:set="SetComment" @bind:event="oninput"></textarea>

    <div class="fields">
        <label class="field">
            Time limit (s)
            <input type="number" min="1" step="any" @bind:get="State.Dungeon.TimeLimitSeconds" @bind:set="v => Change(State.Dungeon with { TimeLimitSeconds = v })" />
        </label>
        @if (DifficultyShown)
        {
            <label class="field">
                Difficulty
                <select @bind:get="State.Dungeon.Difficulty" @bind:set="v => Change(State.Dungeon with { Difficulty = v })">
                    @foreach (var level in DifficultyScaling.Levels)
                    {
                        <option @key="level.Eternal" value="@level.Eternal">@level.Label</option>
                    }
                </select>
            </label>
        }
    </div>

    <ol class="pulls">
        @for (int i = 0; i < Pulls.Count; i++)
        {
            int index = i;
            var pull = Pulls[i];
            <PullItem @key="index" Pull="pull" Pulls="Pulls" Index="index" Open="Editor.Open.Contains(pull.Name)" DragFrom="Editor.DragFrom"
                      OnChange="p => ChangePulls(ps => ps.Select((x, at) => at == index ? p : x).ToList())"
                      OnToggle="() => Editor.Toggle(pull.Name)"
                      OnRename="name => ChangePulls(ps => Editor.Rename(ps, index, name))"
                      OnMove="m => ChangePulls(ps => Editor.Move(ps, m.From, m.To))"
                      OnDuplicate="() => ChangePulls(ps => Editor.Insert(ps, index + 1, pull with { Join = null }))"
                      OnDelete="() => ChangePulls(ps => Editor.Remove(ps, index))"
                      OnDrag="from => Editor.DragFrom = from" />
        }
    </ol>
    @if (State.Dungeon.Problem() is { } problem)
    {
        <p class="field-error">@problem</p>
    }
    <div class="adds">
        <button type="button" class="add" @onclick="() => ChangePulls(ps => Editor.Insert(ps, ps.Count, NewPull(PullItem.NewTrash)))">+ Trash pull</button>
        <button type="button" class="add" @onclick="() => ChangePulls(ps => Editor.Insert(ps, ps.Count, NewPull(PullItem.NewBoss)))">+ Boss pull</button>
    </div>
</Card>

@if (_importOpen)
{
    @* Import: a fight's dungeon from its log link, or a dungeon profile from a file or pasted. Clicking outside it closes it. *@
    <div class="modal-layer" @onclick="CloseImport" @onkeydown="OnImportKeyDown">
        <div class="modal small-dialog import-dialog" role="dialog" aria-modal="true" aria-labelledby="dungeon-import-title" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h2 id="dungeon-import-title" class="title">Import a dungeon</h2>
                <button type="button" class="icon-button" aria-label="Close" @onclick="CloseImport">
                    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
                </button>
            </div>
            <form class="dialog-body" @onsubmit="ImportAsync" @onsubmit:preventDefault="true">
                <LogsSignInPrompt Purpose="to import a dungeon from a log" />
                <label class="name-field">
                    FellowshipLogs link
                    <input @ref="_linkInput" autocomplete="off" spellcheck="false" placeholder="https://www.fellowshiplogs.com/reports/code?fight=6"
                           disabled="@_importBusy" @bind="_importLink" @bind:event="oninput" />
                </label>
                <p class="hint">A report link with its fight. The pulls, their enemies and their durations come from the fight.</p>
                <div class="text-head">
                    <label for="dungeon-import-text">Or a dungeon profile</label>
                    <label class="icon-button file-button" aria-label="Upload" data-tooltip="Import a dungeon from a .simc file">
                        <Icon Shape="IconShape.Import" />
                        <InputFile accept=".simc,.txt" disabled="@_importBusy" OnChange="LoadFileAsync" />
                    </label>
                </div>
                <textarea id="dungeon-import-text" spellcheck="false" rows="8" placeholder='dungeon="name"' disabled="@_importBusy"
                          @bind="_importText" @bind:event="oninput"></textarea>
                @if (_importStatus.Text.Length > 0)
                {
                    <Message Kind="_importStatus.Kind">@_importStatus.Text</Message>
                }
                <div class="row dialog-actions">
                    <button type="button" class="secondary-button" @onclick="CloseImport">Cancel</button>
                    <button type="submit" disabled="@(_importBusy || (_importLink.Trim().Length == 0 && _importText.Trim().Length == 0))">Import</button>
                </div>
            </form>
        </div>
    </div>
}

@code {
    [CascadingParameter] private ToastProvider Toasts { get; set; } = null!;

    /// <summary>The fight's settings: the Sim page's, or the APL Debugger's own.</summary>
    [Parameter, EditorRequired] public SimPageState State { get; set; } = null!;

    [Parameter] public EventCallback OnChanged { get; set; }

    // The Difficulty field shows once the engine models each enemy.
    private static readonly bool DifficultyShown = false;

    /// <summary>Largest dungeon file the card reads.</summary>
    private const long MaxDungeonBytes = 1024 * 1024;

    private IReadOnlyList<DungeonEntry> _saved = [];
    private MessageState _status = MessageState.None;
    private int _pickerKey;
    // The step waiting on the unsaved changes (open another dungeon).
    private (string What, Func<Task> Then)? _pending;
    private bool _exportOpen;

    // The Import dialog: its link, its profile text, status and focus.
    private bool _importOpen, _importBusy, _focusLink;
    private string _importLink = "", _importText = "";
    private MessageState _importStatus = MessageState.None;
    private ElementReference _linkInput;

    private const string BuiltInValue = "builtin";
    private const string OwnValue = "own";

    private IReadOnlyList<DungeonPull> Pulls => State.Dungeon.Pulls;

    private DungeonEditor Editor => State.DungeonEditor;

    private static string ValueOf(DungeonEntry entry) => $"{(entry.BuiltIn ? BuiltInValue : OwnValue)}/{entry.Name}";

    private DungeonEntry? Picked => _saved.FirstOrDefault(s => ValueOf(s) == State.DungeonValue);

    private bool CanDelete => Picked is { BuiltIn: false };

    private bool CanRevert => Picked != null && State.HasDungeonEdits;

    /// <summary>"Pull" or "pulls" with the count.</summary>
    private static string PullsText(int count) => $"{count} {(count == 1 ? "pull" : "pulls")}";

    private int CommentRows => Math.Max(1, (State.Dungeon.Comment ?? "").Split('\n').Length);

    private Task SetComment(string comment) => Change(State.Dungeon with { Comment = string.IsNullOrWhiteSpace(comment) ? null : comment });

    /// <summary>
    /// A new pull of one group, 60 seconds long and 20 seconds after the pull before it; <see cref="DungeonEditor.Insert"/>
    /// names it.
    /// </summary>
    private static DungeonPull NewPull(EnemyGroup group) => new("", [group], DurationSeconds: 60, DowntimeSeconds: 20);

    protected override async Task OnInitializedAsync()
    {
        await LoadSaved();
    }

    private async Task LoadSaved()
    {
        try
        {
            _saved = await Store.ListAsync(Visitor);
        }
        catch (Exception e)
        {
            _status = MessageState.Error(e.Message);
        }
    }

    private Task Change(DungeonProfile dungeon)
    {
        State.Dungeon = dungeon;
        _status = MessageState.None;
        return OnChanged.InvokeAsync();
    }

    private Task ChangePulls(Func<IReadOnlyList<DungeonPull>, IReadOnlyList<DungeonPull>> change) =>
        Change(State.Dungeon with { Pulls = change(Pulls) });

    private Task PickAsked(string value)
    {
        var picked = _saved.FirstOrDefault(s => ValueOf(s) == value);
        if (picked == null) return Task.CompletedTask;
        if (!State.HasDungeonEdits) return Pick(picked);
        _pending = ($"opening {picked.Name}", () => Pick(picked));
        _pickerKey++;
        return Task.CompletedTask;
    }

    private async Task Pick(DungeonEntry entry)
    {
        try
        {
            string text = await Store.ReadAsync(Visitor, entry) ?? throw new KeyNotFoundException($"No dungeon named {entry.Name}.");
            State.Dungeon = DungeonProfile.Parse(text);
            Editor.CloseAll();
            State.DungeonValue = ValueOf(entry);
            State.MarkDungeonClean();
            _status = MessageState.None;
        }
        catch (Exception e) when (e is FormatException or KeyNotFoundException)
        {
            _status = MessageState.Error(e.Message);
        }
        await OnChanged.InvokeAsync();
    }

    private async Task<bool> SaveDungeon()
    {
        var dungeon = State.Dungeon;
        if (DefaultDungeons.Read(dungeon.Name) != null)
        {
            _status = MessageState.Error($"{dungeon.Name} is a built-in dungeon: save it under another name.");
            return false;
        }
        if (!ActionListStore.IsValidName(dungeon.Name))
        {
            _status = MessageState.Error("Name the dungeon with letters, digits, spaces, '_' or '-' (up to 64 characters).");
            return false;
        }
        if (dungeon.Problem() is { } problem)
        {
            _status = MessageState.Error(problem);
            return false;
        }
        await Store.SaveAsync(Visitor, dungeon);
        State.MarkDungeonClean();
        await LoadSaved();
        State.DungeonValue = ValueOf(new DungeonEntry(dungeon.Name));
        _status = MessageState.None;
        Toasts.Ok($"Saved {dungeon.Name}.");
        return true;
    }

    private async Task Save()
    {
        await SaveDungeon();
        await OnChanged.InvokeAsync();
    }

    private async Task SaveThenContinue()
    {
        var pending = _pending;
        _pending = null;
        if (await SaveDungeon() && pending is { } p) await p.Then();
    }

    private async Task DiscardThenContinue()
    {
        var pending = _pending;
        _pending = null;
        if (pending is { } p) await p.Then();
    }

    private async Task Delete()
    {
        if (Picked is not { BuiltIn: false } own) return;
        await Store.DeleteAsync(Visitor, own);
        await LoadSaved();
        State.DungeonValue = "";
        _status = MessageState.None;
        Toasts.Ok($"Deleted {own.Name}. The editor still has it: save it to keep it.");
        await OnChanged.InvokeAsync();
    }

    private Task Revert() => Picked is { } picked ? Pick(picked) : Task.CompletedTask;

    private Task Duplicate()
    {
        var copy = State.Dungeon with { Name = $"{State.Dungeon.Name} copy" };
        State.DungeonValue = "";
        Toasts.Ok($"Copied to {copy.Name}; save it to keep it.");
        return Change(copy);
    }

    private async Task ExportAsync()
    {
        _exportOpen = true;
        await CopyExportAsync();
    }

    private async Task CopyExportAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", State.Dungeon.Format());
            _status = MessageState.None;
            Toasts.Ok("Copied the dungeon to the clipboard. Import takes it as a profile.");
        }
        catch (Exception e) when (e is JSException or TaskCanceledException or InvalidOperationException)
        {
            _status = new MessageState("Select the dungeon's text below and copy it. Import takes it as a profile.");
        }
    }

    private Task Download() => FileDownloads.SaveAsync(JS, State.Dungeon.Name, ".simc", State.Dungeon.Format());

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusLink)
        {
            _focusLink = false;
            await _linkInput.FocusAsync();
        }
    }

    private void OpenImport()
    {
        _importOpen = true;
        _importLink = "";
        _importText = "";
        _importStatus = MessageState.None;
        _focusLink = true;
    }

    private void CloseImport()
    {
        if (!_importBusy) _importOpen = false;
    }

    private void OnImportKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseImport();
    }

    // The link's fight when the link has text, else the pasted profile.
    private Task ImportAsync() => _importLink.Trim().Length > 0 ? FindFightAsync() : ImportTextAsync();

    // The link's fight: its pulls, enemies and pull durations. A failure shows as a toast, and the dialog stays open.
    private async Task FindFightAsync()
    {
        if (_importBusy) return;
        _importBusy = true;
        _importStatus = new MessageState("Reading the fight's pulls...");
        try
        {
            var (dungeon, currentPatch) = await Dungeons.ReadAsync(_importLink);
            // A saved dungeon's name is a file name.
            await UseImported(dungeon with { Name = ActionListStore.ValidName(dungeon.Name, "Imported dungeon") });
            if (!currentPatch)
            {
                _status = new MessageState($"This log is from before patch {GamePatch.Current.Name}: its enemies and pulls may have changed.", MessageKind.Warning);
            }
        }
        catch (Exception e)
        {
            _importStatus = MessageState.None;
            Toasts.Show(MessageState.Error(e.Message));
        }
        finally
        {
            _importBusy = false;
        }
    }

    private Task ImportTextAsync()
    {
        try
        {
            return UseImported(DungeonProfile.Parse(_importText));
        }
        catch (FormatException e)
        {
            _importStatus = MessageState.Error(e.Message);
            return Task.CompletedTask;
        }
    }

    /// <summary>Puts the file's text in the profile field and imports it.</summary>
    private async Task LoadFileAsync(InputFileChangeEventArgs e)
    {
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(MaxDungeonBytes));
            _importText = await reader.ReadToEndAsync();
        }
        catch (Exception ex)
        {
            _importStatus = MessageState.Error(ex.Message);
            return;
        }
        await ImportTextAsync();
    }

    // The imported dungeon in the editor, as changes not saved; the dialog closes.
    private Task UseImported(DungeonProfile dungeon)
    {
        Editor.CloseAll();
        State.DungeonValue = "";
        _importStatus = MessageState.None;
        _importOpen = false;
        Toasts.Ok($"Imported {dungeon.Name}: {PullsText(dungeon.Pulls.Count)}.");
        return Change(dungeon);
    }

    private static string N(double value) => value.ToString("0.#", CultureInfo.CurrentCulture);
}

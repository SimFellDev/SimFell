@using System.Globalization
@using FellowshipSim.Core.Dungeons
@using FellowshipSim.Core.Enemies
@using Microsoft.JSInterop
@inject SimPageState State
@inject DungeonStore Store
@inject Visitor Visitor
@inject IJSRuntime JS
@*
    The dungeon of a dungeon fight on the Modes tab: its name and the saved dungeons, then a row per segment in fight order
    (kind, enemies, priority targets, length, final boss, creature), and its profile text.
*@
<Card Title="Dungeon">
    <p class="hint">
        Each row is one segment of the fight, in order. Its enemies arrive as it starts and die as it ends, their health
        falling with its time. Action lists read the segment through dungeon_event.adds, dungeon_event.boss, target.is_boss and
        target.is_priority.
    </p>
    <div class="row toolbar">
        <input aria-label="Dungeon name" placeholder="Dungeon name" autocomplete="off"
               @bind:get="State.Dungeon.Name" @bind:set="v => Change(State.Dungeon with { Name = v.Trim() })" />
        <select @key="_pickerKey" aria-label="Saved dungeons" @bind:get="State.DungeonValue" @bind:set="PickAsked">
            @if (State.DungeonValue.Length == 0)
            {
                <option value="">Load dungeon...</option>
            }
            @foreach (var saved in _saved)
            {
                <option @key="ValueOf(saved)" value="@ValueOf(saved)">@saved.Name@(saved.BuiltIn ? " (built in)" : "")</option>
            }
        </select>
        <button type="button" class="secondary-button" @onclick="Save">Save</button>
        <button type="button" class="secondary-button delete" disabled="@(!CanDelete)"
                data-tooltip="@(CanDelete ? null : "Only your own saved dungeons can be deleted")" @onclick="Delete">Delete</button>
    </div>
    @if (_pending is { } pending)
    {
        <div class="confirm" role="alertdialog" aria-label="Unsaved changes">
            <span>@State.Dungeon.Name has changes that are not saved. Save them before @pending.What?</span>
            <button type="button" @onclick="SaveThenContinue">Save</button>
            <button type="button" class="secondary-button" @onclick="DiscardThenContinue">Discard</button>
            <button type="button" class="secondary-button" @onclick="() => _pending = null">Cancel</button>
        </div>
    }
    <Message Kind="_status.Kind">@_status.Text</Message>

    <div class="segments" role="table" aria-label="Segments">
        <div class="segment heading" role="row">
            <span role="columnheader">#</span>
            <span role="columnheader">Kind</span>
            <span role="columnheader">Enemies</span>
            <span role="columnheader">Priority</span>
            <span role="columnheader">Length (s)</span>
            <span role="columnheader">Final boss</span>
            <span role="columnheader">Creature</span>
            <span role="columnheader"></span>
        </div>
        @for (int i = 0; i < Segments.Count; i++)
        {
            int index = i;
            var s = Segments[i];
            <div class="segment" role="row">
                <span class="num">@(index + 1)</span>
                <select aria-label="Kind of segment @(index + 1)" @bind:get="s.Kind" @bind:set="v => ChangeKind(index, v)">
                    <option value="@DungeonSegmentKind.Trash">Trash pull</option>
                    <option value="@DungeonSegmentKind.Boss">Boss</option>
                    <option value="@DungeonSegmentKind.Council">Council</option>
                </select>
                <input type="number" min="1" step="1" aria-label="Enemies of segment @(index + 1)" disabled="@(s.Kind == DungeonSegmentKind.Boss)"
                       @bind:get="s.EnemyCount" @bind:set="v => Set(index, s with { Enemies = Math.Max(1, v), Priority = Math.Min(s.Priority, Math.Max(1, v)) })" />
                <input type="number" min="0" max="@s.Enemies" step="1" aria-label="Priority targets of segment @(index + 1)"
                       disabled="@(s.Kind != DungeonSegmentKind.Trash)"
                       @bind:get="s.Priority" @bind:set="v => Set(index, s with { Priority = Math.Clamp(v, 0, s.Enemies) })" />
                <input type="number" min="1" step="any" aria-label="Length of segment @(index + 1)"
                       @bind:get="s.LengthSeconds" @bind:set="v => Set(index, s with { LengthSeconds = v })" />
                <label class="final">
                    <input type="checkbox" aria-label="Segment @(index + 1) is the final boss" disabled="@(!s.IsBoss)"
                           @bind:get="s.Final" @bind:set="v => Set(index, s with { Final = v })" />
                </label>
                <input list="dungeon-creatures" placeholder="None" spellcheck="false" autocomplete="off" aria-label="Creature of segment @(index + 1)"
                       @bind:get="CreatureOf(s)" @bind:set="v => Set(index, s with { Creature = string.IsNullOrWhiteSpace(v) ? null : v.Trim() })" />
                <span class="end">
                    <button type="button" class="icon-button" data-tooltip="Move up" aria-label="Move segment @(index + 1) up" disabled="@(index == 0)"
                            @onclick="() => Move(index, index - 1)">
                        <Icon Shape="IconShape.Up" />
                    </button>
                    <button type="button" class="icon-button" data-tooltip="Move down" aria-label="Move segment @(index + 1) down" disabled="@(index == Segments.Count - 1)"
                            @onclick="() => Move(index, index + 1)">
                        <Icon Shape="IconShape.Down" />
                    </button>
                    <button type="button" class="icon-button" data-tooltip="Duplicate segment" aria-label="Duplicate segment @(index + 1)"
                            @onclick="() => Insert(index + 1, s)">
                        <Icon Shape="IconShape.Duplicate" />
                    </button>
                    <button type="button" class="icon-button danger-button" data-tooltip="Delete segment" aria-label="Delete segment @(index + 1)"
                            disabled="@(Segments.Count == 1)" @onclick="() => Remove(index)">
                        <Icon Shape="IconShape.Bin" />
                    </button>
                </span>
            </div>
        }
    </div>
    <datalist id="dungeon-creatures">
        @foreach (string creature in Creatures)
        {
            <option @key="creature" value="@creature" />
        }
    </datalist>
    @if (State.Dungeon.Problem() is { } problem)
    {
        <p class="field-error">@problem</p>
    }
    <div class="adds">
        <button type="button" class="add" @onclick="() => Insert(Segments.Count, new DungeonSegment(DungeonSegmentKind.Trash, 60, 5))">+ Trash pull</button>
        <button type="button" class="add" @onclick="() => Insert(Segments.Count, new DungeonSegment(DungeonSegmentKind.Boss, 60))">+ Boss</button>
        <button type="button" class="add" @onclick="() => Insert(Segments.Count, new DungeonSegment(DungeonSegmentKind.Council, 60, DungeonSegment.CouncilBosses))">+ Council</button>
        <span class="meta count">@SegmentsText(Segments.Count) · @N(State.Dungeon.LengthSeconds) s</span>
    </div>
    <p class="hint">A creature's enemies give its Spirit Points, as in the game. Without a creature they give none.</p>

    <details @key="_textKey" class="text" open="@_textOpen">
        <summary>Dungeon text</summary>
        <textarea spellcheck="false" rows="8" @bind="_text"></textarea>
        <div class="row">
            <button type="button" class="secondary-button" @onclick="LoadText">Load this text</button>
            <button type="button" class="secondary-button" data-tooltip="Save the dungeon as a .simc file" @onclick="Download">Download</button>
        </div>
        <Message Kind="_textStatus.Kind">@_textStatus.Text</Message>
    </details>
</Card>

@code {
    [Parameter] public EventCallback OnChanged { get; set; }

    private IReadOnlyList<DungeonEntry> _saved = [];
    private MessageState _status = MessageState.None, _textStatus = MessageState.None;
    private string _text = "";
    private bool _textOpen;
    private int _textKey, _pickerKey;
    // The step waiting on the unsaved changes (open another dungeon).
    private (string What, Func<Task> Then)? _pending;

    private const string BuiltInValue = "builtin";
    private const string OwnValue = "own";

    /// <summary>Every creature with a Spirit Point value, by name.</summary>
    private static readonly IReadOnlyList<string> Creatures = CreatureSpiritPoints.ByName.Keys.Order(StringComparer.OrdinalIgnoreCase).ToList();

    private IReadOnlyList<DungeonSegment> Segments => State.Dungeon.Segments;

    private static string CreatureOf(DungeonSegment segment) => segment.Creature ?? "";

    private static string ValueOf(DungeonEntry entry) => $"{(entry.BuiltIn ? BuiltInValue : OwnValue)}/{entry.Name}";

    private DungeonEntry? Picked => _saved.FirstOrDefault(s => ValueOf(s) == State.DungeonValue);

    private bool CanDelete => Picked is { BuiltIn: false };

    /// <summary>"Segment" or "segments" with the count.</summary>
    private static string SegmentsText(int count) => $"{count} {(count == 1 ? "segment" : "segments")}";

    protected override async Task OnInitializedAsync()
    {
        _text = State.Dungeon.Format();
        await LoadSaved();
    }

    private async Task LoadSaved()
    {
        try
        {
            _saved = await Store.ListAsync(Visitor);
        }
        catch (Exception e)
        {
            _status = MessageState.Error(e.Message);
        }
    }

    private Task Change(DungeonProfile dungeon)
    {
        State.Dungeon = dungeon;
        _text = dungeon.Format();
        _status = MessageState.None;
        return OnChanged.InvokeAsync();
    }

    private Task ChangeSegments(Action<List<DungeonSegment>> change)
    {
        var segments = Segments.ToList();
        change(segments);
        return Change(State.Dungeon with { Segments = segments });
    }

    private Task Set(int index, DungeonSegment segment) => ChangeSegments(s => s[index] = segment);

    private Task ChangeKind(int index, DungeonSegmentKind kind) => Set(index, Segments[index] with
    {
        Kind = kind,
        Enemies = kind == DungeonSegmentKind.Council ? Math.Max(2, Segments[index].Enemies) : Segments[index].Enemies,
        Priority = kind == DungeonSegmentKind.Trash ? Segments[index].Priority : 0,
        Final = kind != DungeonSegmentKind.Trash && Segments[index].Final,
    });

    private Task Insert(int index, DungeonSegment segment) => ChangeSegments(s => s.Insert(index, segment));

    private Task Remove(int index) => ChangeSegments(s => s.RemoveAt(index));

    private Task Move(int from, int to) => ChangeSegments(s =>
    {
        var segment = s[from];
        s.RemoveAt(from);
        s.Insert(to, segment);
    });

    private Task PickAsked(string value)
    {
        var picked = _saved.FirstOrDefault(s => ValueOf(s) == value);
        if (picked == null) return Task.CompletedTask;
        if (!State.HasDungeonEdits) return Pick(picked);
        _pending = ($"opening {picked.Name}", () => Pick(picked));
        _pickerKey++;
        return Task.CompletedTask;
    }

    private async Task Pick(DungeonEntry entry)
    {
        try
        {
            string text = await Store.ReadAsync(Visitor, entry) ?? throw new KeyNotFoundException($"No dungeon named {entry.Name}.");
            State.Dungeon = DungeonProfile.Parse(text);
            State.DungeonValue = ValueOf(entry);
            State.MarkDungeonClean();
            _text = State.Dungeon.Format();
            _status = MessageState.None;
        }
        catch (Exception e) when (e is FormatException or KeyNotFoundException)
        {
            _status = MessageState.Error(e.Message);
        }
        await OnChanged.InvokeAsync();
    }

    private async Task<bool> SaveDungeon()
    {
        var dungeon = State.Dungeon;
        if (DefaultDungeons.Read(dungeon.Name) != null)
        {
            _status = MessageState.Error($"{dungeon.Name} is a built-in dungeon: save it under another name.");
            return false;
        }
        if (!ActionListStore.IsValidName(dungeon.Name))
        {
            _status = MessageState.Error("Name the dungeon with letters, digits, spaces, '_' or '-' (up to 64 characters).");
            return false;
        }
        if (dungeon.Problem() is { } problem)
        {
            _status = MessageState.Error(problem);
            return false;
        }
        await Store.SaveAsync(Visitor, dungeon);
        State.MarkDungeonClean();
        await LoadSaved();
        State.DungeonValue = ValueOf(new DungeonEntry(dungeon.Name));
        _status = MessageState.Ok($"Saved {dungeon.Name}.");
        return true;
    }

    private async Task Save()
    {
        await SaveDungeon();
        await OnChanged.InvokeAsync();
    }

    private async Task SaveThenContinue()
    {
        var pending = _pending;
        _pending = null;
        if (await SaveDungeon() && pending is { } p) await p.Then();
    }

    private async Task DiscardThenContinue()
    {
        var pending = _pending;
        _pending = null;
        if (pending is { } p) await p.Then();
    }

    private async Task Delete()
    {
        if (Picked is not { BuiltIn: false } own) return;
        await Store.DeleteAsync(Visitor, own);
        await LoadSaved();
        State.DungeonValue = "";
        _status = MessageState.Ok($"Deleted {own.Name}. The editor still has it: save it to keep it.");
        await OnChanged.InvokeAsync();
    }

    private Task LoadText()
    {
        try
        {
            var dungeon = DungeonProfile.Parse(_text);
            State.DungeonValue = "";
            _textStatus = MessageState.Ok($"Loaded {SegmentsText(dungeon.Segments.Count)}.");
            return Change(dungeon);
        }
        catch (FormatException e)
        {
            _textStatus = MessageState.Error(e.Message);
            _textOpen = true;
            _textKey++;
            return Task.CompletedTask;
        }
    }

    private Task Download() => FileDownloads.SaveAsync(JS, State.Dungeon.Name, ".simc", State.Dungeon.Format());

    private static string N(double value) => value.ToString("0.#", CultureInfo.CurrentCulture);
}

@using System.Globalization
@using FellowshipSim.Core.Dungeons
@using FellowshipSim.Core.Domain
@*
    One enemy group of a pull as a tinted box: its kind on the top-left edge, its duplicate and delete buttons on the
    top-right edge, its values and its comment. First seen and Dies are empty for the pull's start and its duration.
*@
<div class="group">
    <div class="group-start">
        <span class="kind">@(Group.Boss ? "Boss" : "Enemy group")</span>
    </div>
    <div class="group-end">
        <button type="button" data-tooltip="@(Group.Boss ? "Duplicate boss" : "Duplicate enemy group")"
                aria-label="@(Group.Boss ? "Duplicate boss" : "Duplicate enemy group") @Group.Name" @onclick="OnDuplicate">
            <Icon Shape="IconShape.Duplicate" />
        </button>
        <button type="button" class="danger-button" data-tooltip="@(Group.Boss ? "Delete boss" : "Delete enemy group")"
                aria-label="@(Group.Boss ? "Delete boss" : "Delete enemy group") @Group.Name" disabled="@(!CanDelete)" @onclick="OnDelete">
            <Icon Shape="IconShape.Bin" />
        </button>
    </div>
    <div class="values">
        @if (!Group.Boss)
        {
            <label class="value short">
                Count
                <input type="number" min="1" step="1" @bind:get="Group.Count" @bind:set="SetCount" />
            </label>
        }
        <label class="value name">
            Name
            <input spellcheck="false" autocomplete="off" @bind:get="Group.Name" @bind:set="SetName" />
        </label>
        <label class="value short">
            Spirit Points
            <input type="number" min="0" step="any" placeholder="@(GameCreatures.ByName(Group.Name)?.SpiritPoints.ToString() ?? "0")" @bind:get="Group.SpiritPoints" @bind:set="SetSpirit" />
        </label>
        <label class="value">
            Hit points
            <input type="number" min="1" step="any" placeholder="@(GameCreatures.ByName(Group.Name)?.BaseHealth.ToString("0.##") ?? "Required")" @bind:get="Group.HitPoints" @bind:set="SetHitPoints" />
        </label>
        <label class="value short" data-tooltip="Seconds after the pull starts at which @(Group.Boss ? "the boss enters" : "these enemies enter") combat">
            First seen (s)
            <input type="number" min="0" step="any" placeholder="0" @bind:get="FirstSeen" @bind:set="SetFirstSeen" />
        </label>
        <label class="value short" data-tooltip="Seconds after the pull starts at which @(Group.Boss ? "the boss dies" : "these enemies die"); the pull's duration unless given">
            Dies (s)
            <input type="number" min="0" step="any" placeholder="@PullSeconds.ToString("0.##", CultureInfo.InvariantCulture)" @bind:get="Group.DiesSeconds" @bind:set="SetDies" />
        </label>
        <label class="value check">
            Priority
            <input type="checkbox" @bind:get="Group.Priority" @bind:set="SetPriority" />
        </label>
        <label class="value name">
            Interrupt ability
            <input spellcheck="false" autocomplete="off" placeholder="None" @bind:get="Group.Cast?.Ability ?? string.Empty" @bind:set="SetAbility" />
        </label>
        <label class="value short">
            Cooldown (s)
            <input type="number" min="0" step="any" disabled="@(Group.Cast == null)"
                   @bind:get="Group.Cast?.CooldownSeconds" @bind:set="SetCooldown" />
        </label>
        <label class="value short">
            Cast time (s)
            <input type="number" min="0" step="any" disabled="@(Group.Cast == null)"
                   @bind:get="Group.Cast?.CastSeconds" @bind:set="SetCastTime" />
        </label>
    </div>
    <textarea class="comment" rows="@CommentRows" placeholder="Comment" aria-label="Comment on @Group.Name" spellcheck="true"
              @bind:get="Group.Comment ?? string.Empty" @bind:set="SetComment" @bind:event="oninput"></textarea>
</div>

@code {
    [Parameter, EditorRequired] public EnemyGroup Group { get; set; } = null!;

    /// <summary>The duration of the group's pull, in seconds: its enemies die then unless the group has its own time.</summary>
    [Parameter, EditorRequired] public double PullSeconds { get; set; }

    [Parameter] public EventCallback<EnemyGroup> OnChange { get; set; }

    [Parameter] public EventCallback OnDuplicate { get; set; }

    [Parameter] public EventCallback OnDelete { get; set; }

    /// <summary>False for a pull's only group.</summary>
    [Parameter] public bool CanDelete { get; set; } = true;

    /// <summary>The cooldown of a new interrupt ability, in seconds.</summary>
    private const double NewCooldownSeconds = 20;

    private int CommentRows => Math.Max(1, (Group.Comment ?? "").Split('\n').Length);

    private Task SetComment(string comment) => OnChange.InvokeAsync(Group with { Comment = string.IsNullOrWhiteSpace(comment) ? null : comment });

    private Task SetCount(int count) => OnChange.InvokeAsync(Group with { Count = Math.Max(1, count) });

    private Task SetName(string name) => OnChange.InvokeAsync(Group with { Name = name.Trim() });

    private Task SetSpirit(double? spirit) => OnChange.InvokeAsync(Group with { SpiritPoints = spirit is { } s ? Math.Max(0, s) : null });

    private Task SetHitPoints(double? hitPoints) => OnChange.InvokeAsync(Group with { HitPoints = hitPoints is > 0 ? hitPoints : null });

    // An empty box for the pull's start.
    private double? FirstSeen => Group.FirstSeenSeconds > 0 ? Group.FirstSeenSeconds : null;

    private Task SetFirstSeen(double? seconds) => OnChange.InvokeAsync(Group with { FirstSeenSeconds = seconds is > 0 ? seconds.Value : 0 });

    private Task SetDies(double? seconds) => OnChange.InvokeAsync(Group with { DiesSeconds = seconds is > 0 ? seconds : null });

    private Task SetPriority(bool priority) => OnChange.InvokeAsync(Group with { Priority = priority });

    private Task SetAbility(string ability) => OnChange.InvokeAsync(Group with
    {
        Cast = string.IsNullOrWhiteSpace(ability) ? null
            : Group.Cast is { } cast ? cast with { Ability = ability.Trim() }
            : new EnemyCast(ability.Trim(), NewCooldownSeconds),
    });

    private Task SetCooldown(double? seconds) =>
        Group.Cast is { } cast ? OnChange.InvokeAsync(Group with { Cast = cast with { CooldownSeconds = seconds ?? 0 } }) : Task.CompletedTask;

    private Task SetCastTime(double? seconds) =>
        Group.Cast is { } cast ? OnChange.InvokeAsync(Group with { Cast = cast with { CastSeconds = seconds ?? EnemyCast.DefaultCastSeconds } }) : Task.CompletedTask;
}

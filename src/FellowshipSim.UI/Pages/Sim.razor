@page "/"
@using System.Globalization
@using FellowshipSim.Core.APL
@using FellowshipSim.Core.Import
@using Microsoft.JSInterop
@inject ISimEngine Engine
@inject VisitorJobs Jobs
@inject SimPageState State
@inject ActionListStore Store
@inject Visitor Visitor
@inject CharacterImport Characters
@inject IAppViews Views
@inject SimResultLibrary Results
@inject ProfileStore Profiles
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Sim - SimFell</PageTitle>

<SectionContent SectionName="@MainLayout.SubtitleSection">
    Build a character, pick the fight and the action list, and sim it
</SectionContent>

<div class="steps">
    <nav class="tabs" role="tablist" aria-label="Sim steps">
        @foreach (var tab in Enum.GetValues<SimTab>())
        {
            bool selected = tab == State.Tab;
            <button @key="tab" type="button" role="tab" class="tab @(selected ? "selected" : "")" aria-selected="@selected" @onclick="() => State.Tab = tab">
                @StepTitle(tab)
            </button>
        }
    </nav>
    <div class="run">
        <span class="summary">@Summary()</span>
        <button type="button" class="run-button" disabled="@((State.Extra == SimExtra.Compare && State.CompareRows.Count == 0) || BuildHeroes.IsBuildOnly(State.Build.Hero))"
                data-tooltip="@(BuildHeroes.IsBuildOnly(State.Build.Hero) ? $"{State.Build.Hero} is not in the engine yet" : null)" @onclick="StartAsync">Run sim</button>
    </div>
</div>
<Message Kind="State.Status.Kind">@State.Status.Text</Message>

<div role="tabpanel" aria-label="@State.Tab">
    @switch (State.Tab)
    {
        case SimTab.Hero:
            <HeroEditor OnChanged="StateHasChanged" OnImport="() => State.ImportOpen = true" />
            break;

        case SimTab.Modes:
            <ModesTab Heroes="_heroes" Lists="_lists" OnChanged="StateHasChanged" OnListsChanged="ReloadListsAsync" />
            break;

        case SimTab.Advanced:
            <Card Title="Advanced settings">
                <div class="fields">
                    <label class="field">
                        Iterations
                        <input type="number" min="1" step="1" @bind="State.Iterations" />
                    </label>
                    <label class="field">
                        Threads (of @MaxThreads)
                        <input type="number" min="1" max="@MaxThreads" step="1" @bind:get="State.Threads" @bind:set="SetThreadsAsync" />
                    </label>
                    <label class="field" data-tooltip="The first fight's seed; fight i has this seed + i. The fights' lengths and every roll of the dice depend on it">
                        Seed
                        <input type="number" min="@int.MinValue" max="@int.MaxValue" step="1" @bind="State.FirstSeed" />
                    </label>
                    <AdvancedFightFields State="State" />
                </div>
            </Card>
            <Card Title="Profile">
                <p class="hint">The <code>.simc</code> profile the sim runs: the build, the sim settings, the dungeon of a dungeon fight, then the action list.</p>
                <pre class="profile preview">@ProfilePreview()</pre>
            </Card>
            break;
    }
</div>

@if (State.ImportOpen)
{
    @* Import as the Import tab had it: a log's build, or a profile or share link. Clicking outside it closes it. *@
    <div class="modal-layer" @onclick="CloseImport" @onkeydown="OnImportKeyDown">
        <div class="modal import-dialog" role="dialog" aria-modal="true" aria-labelledby="import-title" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h2 id="import-title" class="title">Import</h2>
                <button type="button" class="icon-button" aria-label="Close" @onclick="CloseImport">
                    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
                </button>
            </div>
            <div class="import-body">
                <LogsSignInPrompt Purpose="to import a hero from a log" />
                <ImportCard Title="Import from a log" PickHint="Pick a player, then Import their build."
                            BuildOnlyHeroes="true" OnImport="ImportFromLogAsync" />
                <Card Title="Import a .simc profile or share link">
                    <p class="hint">Load a <code>.simc</code> file, or paste its text or a build's share link. Its build goes to the Hero tab, a profile's sim settings to Modes and Advanced, and its action list to Modes.</p>
                    <label class="secondary-button file-button profile-file">
                        <Icon Shape="IconShape.Import" />
                        Choose a .simc file
                        <InputFile accept=".simc,.txt" OnChange="LoadFileAsync" />
                    </label>
                    <textarea class="profile" rows="10" spellcheck="false" placeholder='rime="name"' @bind="State.ProfileText"></textarea>
                    <div class="row actions">
                        <button type="button" @onclick="ImportProfileAsync">Use this profile</button>
                    </div>
                </Card>
                @if (State.ImportStatus.Text.Length > 0)
                {
                    <Message Kind="State.ImportStatus.Kind">@State.ImportStatus.Text</Message>
                }
            </div>
        </div>
    </div>
}


@code {
    /// <summary>Largest profile file the page reads.</summary>
    private const long MaxProfileBytes = 1024 * 1024;

    /// <summary>The most threads a sim can ask for: the machine's logical processors.</summary>
    private static int MaxThreads => SimThreads.Available;

    private SavedActionLists _savedLists = null!;
    private IReadOnlyList<ActionListEntry> _lists = [];
    private IReadOnlyList<string> _heroes = [];

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;
        _savedLists = new SavedActionLists(Store, Engine, Visitor);
        try
        {
            _lists = await _savedLists.ListAsync();
            _heroes = await Engine.GetHeroesAsync();
        }
        catch (Exception e)
        {
            State.Status = MessageState.Error(e.Message);
        }
    }

    /// <summary>The browser's storage key of the visitor's threads.</summary>
    private const string ThreadsKey = "sim-threads";

    // The threads the browser keeps, read once for the circuit or window; the default when it has none or its storage is
    // unavailable.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await OpenLastBuildAsync();
        if (State.ThreadsRestored) return;
        State.ThreadsRestored = true;
        try
        {
            if (int.TryParse(await JS.InvokeAsync<string?>("localStorage.getItem", ThreadsKey), out int threads))
            {
                State.Threads = Math.Clamp(threads, 1, MaxThreads);
                StateHasChanged();
            }
        }
        catch (Exception e) when (e is JSDisconnectedException or JSException or OperationCanceledException)
        {
            // The default stays.
        }
    }

    // The saved build the browser last had open, in place of the first new build. A build an import, a share link or a
    // sim's run put in stays; a build since deleted leaves the new one.
    private async Task OpenLastBuildAsync()
    {
        if (State.BuildPlaced || State.HasBuildEdits) return;
        try
        {
            string? last = await JS.InvokeAsync<string?>("localStorage.getItem", HeroEditor.LastBuildKey);
            if (State.BuildPlaced || State.HasBuildEdits || last?.Split('/', 2) is not [{ } hero, { } name]) return;
            string? text = await Profiles.ReadAsync(Visitor, new ProfileEntry(hero, name));
            if (State.BuildPlaced || State.HasBuildEdits || text == null) return;
            var build = SimcProfile.Parse(text).Build;
            build.Name = name;
            State.Editor = new BuildEditor(build);
            State.SavedName = name;
            State.MarkBuildClean();
            State.NotifyChanged();
        }
        catch (Exception e) when (e is JSDisconnectedException or JSException or OperationCanceledException or FormatException)
        {
            // The first new build stays.
        }
    }

    private async Task SetThreadsAsync(int threads)
    {
        State.Threads = Math.Clamp(threads, 1, MaxThreads);
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", ThreadsKey, State.Threads.ToString(CultureInfo.InvariantCulture));
        }
        catch (Exception e) when (e is JSDisconnectedException or JSException or OperationCanceledException)
        {
            // The choice lasts until the page reloads.
        }
    }

    // The desktop app keeps this page alive in its tab: a build loaded from a result tab shows at once.
    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= OnStateChanged;

    /// <summary>A list in a picker: where it is kept, its hero and its name.</summary>
    internal static string ListValue(ActionListEntry list) => $"{(list.BuiltIn ? "builtin" : list.Shared ? "shared" : "own")}/{list.Hero}/{list.Name}";

    // A list saved on the Modes tab shows in Compare's pickers too.
    private async Task ReloadListsAsync()
    {
        try
        {
            _lists = await _savedLists.ListAsync();
        }
        catch (Exception e)
        {
            State.Status = MessageState.Error(e.Message);
        }
    }

    // The action list the sim runs: the one picked, or the hero's default list.
    private string ActionListText() =>
        State.ActionListText ?? DefaultActionLists.Read(State.Build.Hero, DefaultActionLists.DefaultName) ?? "";

    private string ActionListName() => State.ActionListName;

    private static string StepTitle(SimTab tab) => tab switch
    {
        SimTab.Hero => "1. Hero & loadout",
        SimTab.Modes => "2. Modes",
        _ => "3. Advanced",
    };

    private void CloseImport() => State.ImportOpen = false;

    private void OnImportKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseImport();
    }

    private string Summary() => State.Extra switch
    {
        SimExtra.Compare => string.Format(CultureInfo.CurrentCulture, "{0} · Compare · {1} × {2:N0} fights",
            Capital(TargetsText()), CompareCard.Runs(State.CompareRows.Count), State.Iterations),
        SimExtra.Finder => string.Format(CultureInfo.CurrentCulture, "{0} · {1} finder · {2} × {3:N0} fights",
            Capital(TargetsText()), FinderCard.Title(State.Finder), CompareCard.Runs(FinderRuns()), State.Iterations),
        _ => string.Format(CultureInfo.CurrentCulture, "{0} ({1}) · {2} · {3} s · {4:N0} fights · {5} APL",
            State.Build.Name, State.Build.Hero, TargetsText(), State.FightSeconds, State.Iterations, ActionListName()),
    };

    private int FinderRuns()
    {
        try
        {
            return BuildFinders.Count(State.Build, State.Finder, State.FinderRanks) + 1;
        }
        catch (Exception)
        {
            return 1;
        }
    }

    private static string Capital(string text) => text.Length == 0 ? text : char.ToUpperInvariant(text[0]) + text[1..];

    private string TargetsText() => State.Mode == SimMode.Dungeon ? $"dungeon {State.Dungeon.Name}"
        : State.TrainingDummies == 1 ? "1 training dummy" : $"{State.TrainingDummies} training dummies";

    private static string N(double value) => value.ToString("0.#", CultureInfo.CurrentCulture);

    private string ProfilePreview()
    {
        try
        {
            return State.SimProfileText(State.Build, ActionListText());
        }
        catch (Exception e)
        {
            return e.Message;
        }
    }

    // The build of the player picked.
    private async Task ImportFromLogAsync(PickedPlayer picked)
    {
        var progress = new Progress<string>(m => { State.ImportStatus = new MessageState($"{m}..."); InvokeAsync(StateHasChanged); });
        try
        {
            State.ImportStatus = new MessageState($"Reading {picked.Player.Name}'s character...");
            StateHasChanged();
            var build = await Characters.ReadAsync(picked.ReportCode, picked.Fight.Id, picked.Player, progress);
            build.LogSource = new FellowshipSim.Logs.ReportLink(picked.ReportCode, picked.Fight.Id, picked.Player.Id).Url;
            State.ImportedBuildToSave = true;
            UseBuild(build);
            if (!picked.CurrentPatch)
            {
                string oldPatch = $"This log is from before patch {FellowshipSim.Logs.GamePatch.Current.Name}: check its talents, traits and blessings.";
                State.BuildStatus = new MessageState(State.BuildStatus.Text.Length > 0 ? $"{State.BuildStatus.Text} {oldPatch}" : oldPatch, MessageKind.Warning);
            }
            State.ImportStatus = MessageState.None;
            CloseImport();
        }
        catch (Exception e)
        {
            State.ImportStatus = MessageState.Error(e.Message);
        }
    }

    private async Task LoadFileAsync(InputFileChangeEventArgs e)
    {
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(MaxProfileBytes));
            State.ProfileText = await reader.ReadToEndAsync();
            await ImportProfileAsync();
        }
        catch (Exception ex)
        {
            State.ImportStatus = MessageState.Error(ex.Message);
        }
    }

    private Task ImportProfileAsync()
    {
        State.ImportProfile();
        if (State.ImportStatus.Kind != MessageKind.Error)
        {
            State.ImportedBuildToSave = true;
            CloseImport();
        }
        // The Hero tab shows under the Import dialog: the state's word redraws its editor with the new build.
        State.NotifyChanged();
        return Task.CompletedTask;
    }

    // The Hero tab shows under the Import dialog: the state's word redraws its editor with the new build.
    private void UseBuild(CharacterBuild build)
    {
        State.UseBuild(build);
        State.NotifyChanged();
    }


    private async Task StartAsync()
    {
        if (BuildHeroes.IsBuildOnly(State.Build.Hero))
        {
            State.Status = MessageState.Error($"{State.Build.Hero} is not in the engine yet: their builds can be made, saved and shared, but not simmed.");
            return;
        }
        if (State.Iterations < 1 || State.FightSeconds <= 0 || State.Targets < 1)
        {
            State.Status = MessageState.Error("Iterations and training dummies are at least 1, and the duration is above 0 seconds.");
            return;
        }
        if (State.Mode == SimMode.Dungeon && State.Dungeon.Problem() is { } problem)
        {
            State.Status = MessageState.Error(problem);
            return;
        }
        try
        {
            switch (State.Extra)
            {
                case SimExtra.Compare:
                    await StartCompareAsync();
                    break;
                case SimExtra.Finder:
                    StartFinder();
                    break;
                default:
                    Start();
                    break;
            }
        }
        catch (Exception e) when (e is FormatException or InvalidOperationException or IOException)
        {
            State.Status = MessageState.Error(e.Message);
        }
    }

    /// <summary>One run of a compare or finder sim, before it runs.</summary>
    private sealed record PlannedRun(string Label, string Detail, string Hero, string ListName, string ListValue, string ProfileText);

    // A run of <paramref name="build"/> with the action list <paramref name="listText"/>; throws for a profile that does not read.
    private PlannedRun Plan(string label, string detail, CharacterBuild build, string listName, string listValue, string listText)
    {
        string text = State.SimProfileText(build, listText);
        if (SimProfile.Parse(text).Profile.ActionList.Trim().Length == 0)
        {
            throw new InvalidOperationException($"{label}: its action list is empty.");
        }
        return new PlannedRun(label, detail, build.Hero, listName, listValue, text);
    }

    private async Task StartCompareAsync()
    {
        if (State.CompareRows.Count == 0)
        {
            State.Status = MessageState.Error("Compare has no runs: add one on the Modes tab.");
            return;
        }
        var runs = new List<PlannedRun>();
        foreach (var row in State.CompareRows)
        {
            CharacterBuild build;
            if (row.Saved is { } saved)
            {
                string text = await Profiles.ReadAsync(Visitor, saved) ?? throw new InvalidOperationException($"The saved build {saved.Name} is gone.");
                build = SimcProfile.Parse(text).Build;
            }
            else
            {
                build = BuildFinders.Copy(State.Build);
            }
            var list = _lists.FirstOrDefault(l => ListValue(l) == row.ListValue);
            string listName = list?.Name ?? DefaultActionLists.DefaultName;
            string listText = list == null
                ? DefaultActionLists.Read(build.Hero, DefaultActionLists.DefaultName) ?? ""
                : (await _savedLists.ReadAsync(list)).Text;
            runs.Add(Plan(row.Saved?.Name ?? $"{build.Name} (current)", listName, build, listName, row.ListValue, listText));
        }
        Enqueue($"Compare: {CompareCard.Runs(runs.Count)}, {TargetsText()}, {N(State.FightSeconds)} s", runs);
    }

    private void StartFinder()
    {
        var variants = BuildFinders.Variants(State.Build, State.Finder, State.FinderRanks);
        if (variants.Count == 0)
        {
            State.Status = MessageState.Error($"The {FinderCard.Title(State.Finder)} finder has nothing to try for this build.");
            return;
        }
        string listText = ActionListText();
        var runs = new List<PlannedRun> { Plan("Current build", State.Build.Name, State.Build, ActionListName(), State.ActionListValue, listText) };
        runs.AddRange(variants.Select(v => Plan(v.Label, v.Detail, v.Build, ActionListName(), State.ActionListValue, listText)));
        Enqueue($"{FinderCard.Title(State.Finder)} finder: {State.Build.Name} ({State.Build.Hero}), {CompareCard.Runs(runs.Count)}, {TargetsText()}", runs);
    }

    // Queues the runs as one job: each run's sim in turn, saved together with the first as the baseline. Each run's sim is
    // its profile text alone.
    private void Enqueue(string title, IReadOnlyList<PlannedRun> runs)
    {
        var first = SimProfile.Parse(runs[0].ProfileText);
        // The job outlives this page's circuit, so the work captures the engine, the results library and values alone.
        var (engine, results, visitor) = (Engine, Results, Jobs.Visitor);
        var job = Jobs.Enqueue(SimJobKind.Sim, title, async c =>
        {
            var done = new List<SimRun>();
            for (int i = 0; i < runs.Count; i++)
            {
                var run = runs[i];
                var progress = new RunProgress(c, i, runs.Count, run.Label);
                var sim = SimProfile.Parse(run.ProfileText);
                var result = await engine.SimulateAsync(sim.Profile, sim.Settings, progress, c.CancellationToken);
                done.Add(new SimRun(run.Label, run.Detail, run.Hero, run.ListName, run.ListValue, run.ProfileText, result));
            }
            var settings = SimProfile.Parse(done[0].Profile).Settings;
            var saved = new SavedSim(c.Job.Id, title, done[0].Hero, first.Profile.Build.Name, done[0].Profile, settings.TargetCount, done[0].Result,
                DateTime.UtcNow, done, Settings: settings);
            await results.SaveAsync(visitor, saved, CancellationToken.None);
            return saved;
        }, first.Profile);
        State.Status = MessageState.None;
        Views.ShowJob(job);
    }

    /// <summary>A run's progress as its share of the whole job, with which run it is.</summary>
    private sealed class RunProgress(SimJobContext job, int run, int runs, string label) : IProgress<SimProgress>
    {
        public void Report(SimProgress value) => job.Report((run + value.Fraction) / runs, $"Run {run + 1} of {runs}: {label}");
    }

    private void Start()
    {
        string profileText;
        SimcProfile profile;
        try
        {
            profileText = State.SimProfileText(State.Build, ActionListText());
            profile = SimProfile.Parse(profileText).Profile;
        }
        catch (Exception e) when (e is FormatException or InvalidOperationException)
        {
            State.Status = MessageState.Error(e.Message);
            return;
        }
        if (profile.ActionList.Trim().Length == 0)
        {
            State.Status = MessageState.Error("The action list is empty: pick one on the Modes tab.");
            return;
        }
        string title = string.Format(CultureInfo.CurrentCulture, "{0} ({1}): {2:N0} iterations, {3} s, {4}",
            profile.Build.Name, profile.Build.Hero, State.Iterations, N(State.FightSeconds), TargetsText());
        // The job outlives this page's circuit, so the work captures the engine, the results library and values alone. The
        // sim is the profile text alone.
        var (engine, results, visitor) = (Engine, Results, Jobs.Visitor);
        var job = Jobs.Enqueue(SimJobKind.Sim, title, async c =>
        {
            var sim = SimProfile.Parse(profileText);
            var result = await engine.SimulateAsync(sim.Profile, sim.Settings, c, c.CancellationToken);
            var saved = new SavedSim(c.Job.Id, title, sim.Profile.Build.Hero, sim.Profile.Build.Name, profileText, sim.Settings.TargetCount, result,
                DateTime.UtcNow, Settings: sim.Settings);
            await results.SaveAsync(visitor, saved, CancellationToken.None);
            return saved;
        }, profile);
        State.Status = MessageState.None;
        Views.ShowJob(job);
    }
}

@page "/"
@using System.Globalization
@using FellowshipSim.Core.APL
@using FellowshipSim.Core.Import
@inject ISimEngine Engine
@inject VisitorJobs Jobs
@inject SimPageState State
@inject ActionListStore Store
@inject Visitor Visitor
@inject CharacterImport Characters
@inject IAppViews Views
@inject SimResultLibrary Results

<PageTitle>Sim - FellowshipSim</PageTitle>

<SectionContent SectionName="@MainLayout.SubtitleSection">
    Build a character, pick the fight and the action list, and sim it
</SectionContent>

<div class="steps">
    <nav class="tabs" role="tablist" aria-label="Sim steps">
        @foreach (var tab in Enum.GetValues<SimTab>())
        {
            bool selected = tab == State.Tab;
            <button @key="tab" type="button" role="tab" class="tab @(selected ? "selected" : "")" aria-selected="@selected" @onclick="() => State.Tab = tab">
                @StepTitle(tab)
            </button>
        }
    </nav>
    <div class="run">
        <span class="summary">@Summary()</span>
        <button type="button" class="run-button" @onclick="Start">Run sim</button>
    </div>
</div>
<Message Kind="State.Status.Kind">@State.Status.Text</Message>

<div role="tabpanel" aria-label="@State.Tab">
    @switch (State.Tab)
    {
        case SimTab.Import:
            <ImportCard Title="Import Hero" PickHint="Pick a player, then Import to use their build." OnEditSettings="() => Views.ShowPage(AppPage.Setup)" OnPlayer="ImportPlayerAsync" />
            <Card Title="Import a .simc profile">
                <p class="hint">Load a <code>.simc</code> file or paste its text. Its build goes to the Hero tab, and its action list, if it has one, to Advanced.</p>
                <InputFile class="file" accept=".simc,.txt" OnChange="LoadFileAsync" />
                <textarea class="profile" rows="10" spellcheck="false" placeholder='rime="name"' @bind="State.ProfileText"></textarea>
                <div class="row actions">
                    <button type="button" @onclick="ImportProfileAsync">Use this profile</button>
                </div>
            </Card>
            <Message Kind="State.ImportStatus.Kind">@State.ImportStatus.Text</Message>
            break;

        case SimTab.Hero:
            <HeroEditor OnChanged="StateHasChanged" />
            break;

        case SimTab.Modes:
            <Card Title="Fight">
                <div class="modes" role="radiogroup" aria-label="Fight">
                    <label class="mode @(State.Mode == SimMode.SingleTarget ? "selected" : "")">
                        <input type="radio" name="mode" checked="@(State.Mode == SimMode.SingleTarget)" @onchange="() => State.Mode = SimMode.SingleTarget" />
                        <strong>Single target</strong>
                        <span class="meta">One target for the whole fight.</span>
                    </label>
                    <label class="mode @(State.Mode == SimMode.Aoe ? "selected" : "")">
                        <input type="radio" name="mode" checked="@(State.Mode == SimMode.Aoe)" @onchange="() => State.Mode = SimMode.Aoe" />
                        <strong>AoE</strong>
                        <span class="meta">Several targets for the whole fight.</span>
                    </label>
                </div>
                <div class="settings">
                    <label>
                        Duration (seconds)
                        <input type="number" min="1" step="any" @bind="State.DurationSeconds" />
                    </label>
                    @if (State.Mode == SimMode.Aoe)
                    {
                        <label>
                            Targets
                            <input type="number" min="2" step="1" @bind="State.AoeTargets" />
                        </label>
                    }
                </div>
            </Card>
            break;

        case SimTab.Advanced:
            <Card Title="Sim">
                <div class="settings">
                    <label>
                        Iterations
                        <input type="number" min="1" step="1" @bind="State.Iterations" />
                    </label>
                    <label>
                        Threads (of @MaxThreads)
                        <input type="number" min="1" max="@MaxThreads" step="1" @bind:get="State.Threads" @bind:set="v => State.Threads = Math.Clamp(v, 1, MaxThreads)" />
                    </label>
                </div>
            </Card>
            <Card Title="Action list">
                <div class="settings">
                    <label>
                        APL
                        <select class="apl" @bind:get="State.ActionListValue" @bind:set="PickActionListAsync">
                            @if (State.ActionListValue.Length == 0)
                            {
                                <option value="">@State.ActionListName</option>
                            }
                            @foreach (var list in _lists.Where(l => l.Hero.Equals(State.Build.Hero, StringComparison.OrdinalIgnoreCase)))
                            {
                                <option @key="ListValue(list)" value="@ListValue(list)">@list.Name@(list.BuiltIn ? " (built in)" : list.Shared ? " (shared)" : "")</option>
                            }
                        </select>
                    </label>
                </div>
                <p class="hint">Make or change a list in the <button type="button" class="link-button" @onclick="() => Views.ShowPage(AppPage.AplEditor)">APL Editor</button>; save it there and it shows here.</p>
            </Card>
            <Card Title="Profile">
                <p class="hint">The <code>.simc</code> profile the sim runs: the build, then the action list.</p>
                <pre class="profile preview">@ProfilePreview()</pre>
            </Card>
            break;
    }
</div>


@code {
    /// <summary>Largest profile file the page reads.</summary>
    private const long MaxProfileBytes = 1024 * 1024;

    /// <summary>The most threads a sim can ask for: the machine's logical processors.</summary>
    private static int MaxThreads => Environment.ProcessorCount;

    private SavedActionLists _savedLists = null!;
    private IReadOnlyList<ActionListEntry> _lists = [];

    protected override async Task OnInitializedAsync()
    {
        _savedLists = new SavedActionLists(Store, Engine, Visitor);
        try
        {
            _lists = await _savedLists.ListAsync();
        }
        catch (Exception e)
        {
            State.Status = MessageState.Error(e.Message);
        }
    }

    // A list in the picker: where it is kept, its hero and its name.
    private static string ListValue(ActionListEntry list) => $"{(list.BuiltIn ? "builtin" : list.Shared ? "shared" : "own")}/{list.Hero}/{list.Name}";

    private async Task PickActionListAsync(string value)
    {
        var list = _lists.FirstOrDefault(l => ListValue(l) == value);
        if (list == null) return;
        try
        {
            var saved = await _savedLists.ReadAsync(list);
            State.ActionListValue = value;
            State.ActionListName = list.Name;
            State.ActionListText = saved.Text;
            State.Status = saved.Error != null ? MessageState.Error($"{list.Name} does not parse: {saved.Error}") : MessageState.None;
        }
        catch (Exception e)
        {
            State.Status = MessageState.Error(e.Message);
        }
    }

    // The action list the sim runs: the one picked, or the hero's default list.
    private string ActionListText() =>
        State.ActionListText ?? DefaultActionLists.Read(State.Build.Hero, DefaultActionLists.DefaultName) ?? "";

    private string ActionListName() => State.ActionListName;

    private static string StepTitle(SimTab tab) => tab switch
    {
        SimTab.Import => "1. Import",
        SimTab.Hero => "2. Hero & loadout",
        SimTab.Modes => "3. Modes",
        _ => "4. Advanced & APL",
    };

    private string Summary() => string.Format(CultureInfo.CurrentCulture, "{0} ({1}) · {2} · {3} s · {4:N0} fights · {5} APL",
        State.Build.Name, State.Build.Hero,
        State.Mode == SimMode.SingleTarget ? "single target" : $"{State.AoeTargets} targets",
        State.DurationSeconds, State.Iterations, ActionListName());

    private string ProfilePreview()
    {
        try
        {
            return new SimcProfile(State.Build, ActionListText()).Format();
        }
        catch (Exception e)
        {
            return e.Message;
        }
    }

    private async Task ImportPlayerAsync(PickedPlayer picked)
    {
        State.ImportStatus = new MessageState($"Reading {picked.Player.Name}'s character...");
        StateHasChanged();
        try
        {
            var progress = new Progress<string>(m => { State.ImportStatus = new MessageState($"{m}..."); InvokeAsync(StateHasChanged); });
            var build = await Characters.ReadAsync(picked.ReportCode, picked.Fight.Id, picked.Player, progress);
            UseBuild(build, $"{picked.Player.Name}'s {picked.Player.Hero} in {picked.Fight.Name}");
            if (!picked.CurrentPatch)
            {
                State.ImportStatus = State.BuildStatus = new MessageState(
                    $"{State.ImportStatus.Text} This log is from before patch {FellowshipSim.Logs.GamePatch.Current.Name}: check its talents, traits and blessings.",
                    MessageKind.Warning);
            }
        }
        catch (Exception e)
        {
            State.ImportStatus = MessageState.Error(e.Message);
        }
    }

    private async Task LoadFileAsync(InputFileChangeEventArgs e)
    {
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(MaxProfileBytes));
            State.ProfileText = await reader.ReadToEndAsync();
            await ImportProfileAsync();
        }
        catch (Exception ex)
        {
            State.ImportStatus = MessageState.Error(ex.Message);
        }
    }

    private Task ImportProfileAsync()
    {
        try
        {
            var profile = SimcProfile.Parse(State.ProfileText);
            if (profile.ActionList.Trim().Length > 0)
            {
                State.ActionListText = profile.ActionList;
                State.ActionListName = "the profile's list";
                State.ActionListValue = "";
            }
            UseBuild(profile.Build, profile.ActionList.Trim().Length > 0 ? "the profile, with its action list" : "the profile");
        }
        catch (FormatException e)
        {
            State.ImportStatus = MessageState.Error(e.Message);
        }
        return Task.CompletedTask;
    }

    private void UseBuild(CharacterBuild build, string from)
    {
        var removed = BuildEditor.RemoveUnknown(build);
        State.Editor = new BuildEditor(build);
        State.SavedName = "";
        State.ImportStatus = MessageState.Ok($"Using the build of {from}." + (removed.Count > 0 ? $" Left out (not in the engine): {string.Join(", ", removed)}." : ""));
        State.BuildStatus = State.ImportStatus;
        State.Tab = SimTab.Hero;
    }

    private void Start()
    {
        if (State.Iterations < 1 || State.DurationSeconds <= 0 || State.Targets < 1)
        {
            State.Status = MessageState.Error("Iterations and targets are at least 1, and the duration is above 0 seconds.");
            return;
        }
        string profileText;
        SimcProfile profile;
        try
        {
            profileText = new SimcProfile(State.Build, ActionListText()).Format();
            profile = SimcProfile.Parse(profileText);
        }
        catch (Exception e) when (e is FormatException or InvalidOperationException)
        {
            State.Status = MessageState.Error(e.Message);
            return;
        }
        if (profile.ActionList.Trim().Length == 0)
        {
            State.Status = MessageState.Error("The action list is empty: pick one on the Advanced tab.");
            return;
        }
        var settings = new SimSettings(State.Iterations, State.DurationSeconds, State.Targets, DegreeOfParallelism: Math.Clamp(State.Threads, 1, MaxThreads));
        string title = string.Format(CultureInfo.CurrentCulture, "{0} ({1}): {2:N0} iterations, {3} s, {4} {5}",
            profile.Build.Name, profile.Build.Hero, State.Iterations, State.DurationSeconds, State.Targets, State.Targets == 1 ? "target" : "targets");
        // The job outlives this page's circuit, so the work captures the engine, the results library and values alone.
        var (engine, results, visitor) = (Engine, Results, Jobs.Visitor);
        var job = Jobs.Enqueue(SimJobKind.Sim, title, async c =>
        {
            var result = await engine.SimulateAsync(profile, settings, c, c.CancellationToken);
            var saved = new SavedSim(c.Job.Id, title, profile.Build.Hero, profile.Build.Name, profileText, settings.TargetCount, result, DateTime.UtcNow);
            await results.SaveAsync(visitor, saved, CancellationToken.None);
            return saved;
        }, profile);
        State.Status = MessageState.Ok($"Queued: {title}.");
        Views.ShowJob(job);
    }
}

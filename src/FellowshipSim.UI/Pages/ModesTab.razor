@using System.Globalization
@inject SimPageState State
@* The Sim page's Modes tab: the fight, its dungeon or training mobs, its settings, then Compare and Finder. *@
<Card Title="Fight">
    <div class="choices" role="radiogroup" aria-label="Fight">
        <label class="choice @(State.Mode == SimMode.Dungeon ? "on" : "")">
            <input type="radio" name="mode" checked="@(State.Mode == SimMode.Dungeon)" @onchange="() => State.Mode = SimMode.Dungeon" />
            <strong>Dungeon</strong>
            <span class="meta">Trash pulls, bosses and councils in turn, each for its own length. The report adds the DPS to bosses.</span>
        </label>
        <label class="choice @(State.Mode == SimMode.TrainingMobs ? "on" : "")">
            <input type="radio" name="mode" checked="@(State.Mode == SimMode.TrainingMobs)" @onchange="() => State.Mode = SimMode.TrainingMobs" />
            <strong>Training mobs</strong>
            <span class="meta">A number of training mobs for the whole fight. With more than one, the report adds the first mob's DPS.</span>
        </label>
    </div>
    <div class="fields">
        @if (State.Mode == SimMode.Dungeon)
        {
            <div class="field">
                Length
                <span class="length">@N(State.Dungeon.LengthSeconds) s</span>
            </div>
        }
        else
        {
            <label class="field">
                Duration (seconds)
                <input type="number" min="1" step="any" @bind="State.DurationSeconds" />
            </label>
            <label class="field">
                Training mobs
                <input type="number" class="short" min="1" step="1"
                       @bind:get="State.TrainingMobs" @bind:set="v => State.TrainingMobs = Math.Max(1, v)" />
            </label>
        }
        <div class="toggle-block">
            <label class="switch">
                <input type="checkbox" @bind="State.VaryLength" />
                <span>Vary the fight length</span>
            </label>
            <span class="meta">@LengthText()</span>
        </div>
        <label class="field @(State.VaryLength ? "" : "off")">
            By ± %
            <input type="number" class="short" min="0" max="90" step="1" disabled="@(!State.VaryLength)"
                   @bind:get="State.LengthVariancePercent" @bind:set="v => State.LengthVariancePercent = Math.Clamp(v, 0, 90)" />
        </label>
    </div>
</Card>

@if (State.Mode == SimMode.Dungeon)
{
    <DungeonCard OnChanged="OnChanged" />
}

@* What else the fights have; more settings of the fight go here. *@
<Card Title="Fight settings">
    <div class="fields">
        @if (State.Mode == SimMode.TrainingMobs)
        {
            <div class="toggle-block">
                <label class="switch">
                    <input type="checkbox" @bind="State.Boss" />
                    <span>The mobs are bosses</span>
                </label>
            </div>
        }
        <div class="toggle-block">
            <label class="switch">
                <input type="checkbox" @bind="State.StartWithSpirit" />
                <span>Start with Spirit</span>
            </label>
        </div>
        <label class="field @(State.StartWithSpirit ? "" : "off")">
            Spirit (0 – @N(MaxStartingSpirit))
            <input type="number" class="short" min="0" max="@MaxStartingSpirit" step="1" disabled="@(!State.StartWithSpirit)"
                   @bind:get="State.StartingSpirit" @bind:set="v => State.StartingSpirit = Math.Clamp(v, 0, MaxStartingSpirit)" />
        </label>
    </div>
</Card>

<CompareCard Heroes="Heroes" Lists="Lists" OnChanged="OnChanged" />
<FinderCard OnChanged="OnChanged" />

@code {
    /// <summary>Every hero the engine has, for the saved builds.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<string> Heroes { get; set; } = [];

    /// <summary>Every action list the visitor can pick, of every hero.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<ActionListEntry> Lists { get; set; } = [];

    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>The most Spirit a fight can start with: a build with Ancestral Surge - II holds 130.</summary>
    public const double MaxStartingSpirit = 130;

    private string LengthText()
    {
        if (!State.VaryLength || State.LengthVariancePercent <= 0) return "Every fight lasts the same length.";
        double share = State.LengthVariancePercent / 100;
        return $"Each fight lasts {N(State.FightSeconds * (1 - share))} – {N(State.FightSeconds * (1 + share))} s, so no build is tuned to one exact length.";
    }

    private static string N(double value) => value.ToString("0.#", CultureInfo.CurrentCulture);
}

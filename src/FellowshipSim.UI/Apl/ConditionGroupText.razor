@using FellowshipSim.Core.APL
@implements IDisposable
@* A closed group's text on one line, coloured once it has stayed the same for 300 ms, with the whole text in its title. *@
<div class="group-text" title="@Text">@if (_text.Result is { } result && result.Text == _text.Text && _text.Text == Text)
    {
        <Highlight Text="@Text" Check="result.Check" />
    }
    else
    {
        @Text
    }</div>

@code {
    [CascadingParameter] public ActionListEditor Editor { get; set; } = null!;

    [Parameter, EditorRequired] public AplVocabulary Vocabulary { get; set; } = null!;

    [Parameter, EditorRequired] public string Text { get; set; } = "";

    private DebouncedCheck _text = null!;

    protected override void OnInitialized() =>
        _text = new DebouncedCheck(Editor.Checks, TimeSpan.FromMilliseconds(300), change => InvokeAsync(() =>
        {
            change();
            StateHasChanged();
        }));

    protected override void OnParametersSet() => _text.Set(Vocabulary.Hero, Text);

    public void Dispose() => _text.Dispose();
}

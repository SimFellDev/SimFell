@using FellowshipSim.Core.APL
@using FellowshipSim.Core.APL.Expressions
@using System.Globalization
@*
    The fields of an open action: its type, ability, list or variable, condition, target and other arguments. A Switch
    target action has the condition and the target alone, and its target is always a selection.
*@
<div class="detail">
    <label for="@($"{Id}-type")">Type</label>
    <select id="@($"{Id}-type")" value="@(ListAction || VariableAction || SwitchAction ? Action.Ability : "")" @onchange="e => ChangeType((string?)e.Value ?? string.Empty)">
        <option value="">Cast an ability</option>
        @foreach (string name in Vocabulary.ListActions)
        {
            <option @key="name" value="@name">@ActionListModel.ListActionName(name)</option>
        }
        <option value="@AplVariable.ActionName">Set a variable</option>
        <option value="@AplSwitchTarget.ActionName">@AplSwitchTarget.Label</option>
    </select>

    @if (ListAction)
    {
        <label for="@($"{Id}-list")" data-tooltip="@ListTip">List</label>
        <select id="@($"{Id}-list")" value="@(KnownList ? Action.ActionList : "")"
                @onchange="e => Change(a => a with { ActionList = string.IsNullOrEmpty((string?)e.Value) ? null : (string)e.Value! })">
            @if (!KnownList)
            {
                <option value="">@(OtherLists.Count > 0 ? "Pick a list" : "Add an action list first")</option>
            }
            @foreach (var l in OtherLists)
            {
                <option @key="l.Name" value="@l.Name">@l.Name</option>
            }
        </select>
    }
    else if (VariableAction)
    {
        <label for="@($"{Id}-variable")">Variable</label>
        <div>
            <input id="@($"{Id}-variable")" class="name" spellcheck="false" autocomplete="off" placeholder="Name"
                   list="@($"{Id}-variables")" @bind="VariableName" @bind:event="oninput" />
            <datalist id="@($"{Id}-variables")">
                @foreach (string name in OtherVariables)
                {
                    <option @key="name" value="@name"></option>
                }
            </datalist>
            @if (VariableName.Length > 0 && ActionListModel.VariableNameProblem(VariableName) is { } problem)
            {
                <p class="field-error">@problem</p>
            }
        </div>

        <label for="@($"{Id}-op")">Op</label>
        <select id="@($"{Id}-op")" value="@Variable.Op.ToString()" @onchange="e => ChangeOp((string?)e.Value)">
            @foreach (var op in Enum.GetValues<AplVariableOp>())
            {
                <option @key="op" value="@op.ToString()">@ActionListModel.VariableOpName(op)</option>
            }
        </select>

        <label hidden="@(Variable.Op == AplVariableOp.Reset)">Value</label>
        <div hidden="@(Variable.Op == AplVariableOp.Reset)">
            <ConditionField Vocabulary="Vocabulary" Value="@Variable.Value" Label="Value" Lead=""
                            Placeholder="@($"Example: {Vocabulary.Resources.FirstOrDefault()?.Slug ?? "active_enemies"} + 1")"
                            OnChange="value => ChangeVariable(v => v with { Value = value })" />
        </div>

        <label for="@($"{Id}-default")">Default</label>
        <input id="@($"{Id}-default")" type="number" step="any" class="default" value="@ConditionBuilder.Number(Variable.Default)"
               @onchange="e => ChangeDefault((string?)e.Value)" />
    }
    else if (!SwitchAction)
    {
        <label for="@($"{Id}-ability")">Ability</label>
        <select id="@($"{Id}-ability")" value="@Action.Ability" @onchange="e => ChangeAbility((string?)e.Value ?? string.Empty)">
            @if (Action.Ability.Length == 0)
            {
                <option value="">Pick an ability</option>
            }
            @if (Action.Ability.Length > 0 && !KnownAbility)
            {
                <option value="@Action.Ability">@Action.Ability (not a @Vocabulary.Hero ability)</option>
            }
            @foreach (var a in Vocabulary.Abilities)
            {
                <option @key="a.Slug" value="@a.Slug">@a.Name</option>
            }
        </select>
    }

    <label class="wide">Condition</label>
    <div class="wide">
        <ConditionField Vocabulary="Vocabulary" Value="@Action.Condition"
                        Placeholder="@($"Always. Example: {Vocabulary.Resources.FirstOrDefault()?.Slug ?? "active_enemies"} >= 3 and not buff.{Vocabulary.Auras.FirstOrDefault()?.Slug ?? "name"}.up")"
                        OnChange="condition => Change(a => a with { Condition = condition })" />
    </div>

    @if (!ListAction && !VariableAction)
    {
        <label for="@($"{Id}-target")" data-tooltip="@(SwitchAction ? AplSwitchTarget.Description : null)">Target</label>
        <select id="@($"{Id}-target")" value="@(Selection?.ToString() ?? "")" @onchange="e => ChangeTarget((string?)e.Value)">
            @if (!SwitchAction)
            {
                <option value="">Current target</option>
            }
            @foreach (var s in Vocabulary.TargetSelections)
            {
                <option @key="s.Selection" value="@s.Selection.ToString()">@s.Label</option>
            }
        </select>
        <label hidden="@(Selection == null)">Target by</label>
        <div hidden="@(Selection == null)">
            <ConditionField Vocabulary="Vocabulary" Value="@Action.TargetExpression" Label="Target by" Lead=""
                            Placeholder="@($"Value for each enemy. Example: debuff.{Vocabulary.Auras.FirstOrDefault()?.Slug ?? "name"}.remains")"
                            OnChange="expression => Change(a => a with { TargetExpression = expression })" />
        </div>

        @if (!SwitchAction)
        {
            <label>Timing</label>
            <div class="switches">
                <label class="switch">
                    <input type="checkbox" checked="@Action.UseOffGcd" @onchange="e => Change(a => a with { UseOffGcd = e.Value is true })" />
                    <span data-tooltip="@OptionTip(AplActionLine.UseOffGcdKey)">Use off the global cooldown</span>
                </label>
                <label class="switch">
                    <input type="checkbox" checked="@Action.UseWhileCasting" @onchange="e => Change(a => a with { UseWhileCasting = e.Value is true })" />
                    <span data-tooltip="@OptionTip(AplActionLine.UseWhileCastingKey)">Use while casting</span>
                </label>
            </div>
        }

        @if (!SwitchAction && Channel)
        {
            <label data-tooltip="@InterruptIfTip">Interrupt if</label>
            <div>
                <ConditionField Vocabulary="Vocabulary" Value="@Action.InterruptIf" Label="Interrupt if" Lead=""
                                Placeholder="@($"Never. Example: {(TickingChannel ? $"{PropertyExpression.ChannelTicksProperty} >= 1" : $"{PropertyExpression.ChannelPercentProperty} >= 50")}")"
                                OnChange="condition => Change(a => a with { InterruptIf = condition })" />
            </div>
            <label hidden="@string.IsNullOrWhiteSpace(Action.InterruptIf)">Interrupt</label>
            <div class="switches" hidden="@string.IsNullOrWhiteSpace(Action.InterruptIf)">
                <label class="switch">
                    <input type="checkbox" checked="@Action.InterruptImmediate" @onchange="e => Change(a => a with { InterruptImmediate = e.Value is true })" />
                    <span data-tooltip="@OptionTip(AplActionLine.InterruptImmediateKey)">Interrupt immediately</span>
                </label>
            </div>
        }
    }

    @if (_hasArguments)
    {
        <label for="@($"{Id}-arguments")">Other arguments</label>
        <input id="@($"{Id}-arguments")" class="arguments" spellcheck="false" autocomplete="off" @bind="ArgumentsText" @bind:event="oninput" />
    }
</div>

@code {
    [CascadingParameter] public ActionListEditor Editor { get; set; } = null!;

    [Parameter, EditorRequired] public AplVocabulary Vocabulary { get; set; } = null!;

    [Parameter, EditorRequired] public IReadOnlyList<ActionList> Lists { get; set; } = [];

    [Parameter, EditorRequired] public ActionList List { get; set; } = null!;

    [Parameter, EditorRequired] public EditorAction Action { get; set; } = null!;

    // The field for other arguments shows when the action had them as its details opened.
    private bool _hasArguments;

    private string Id => $"apl-{Action.Key}";

    private string ArgumentsText
    {
        get => Action.Arguments ?? "";
        set => Change(a => a with { Arguments = value });
    }

    private bool ListAction => ActionListModel.IsListAction(Vocabulary, Action);

    private bool VariableAction => ActionListModel.IsVariableAction(Action);

    private bool SwitchAction => ActionListModel.IsSwitchTargetAction(Action);

    // A Switch target action's target is a selection: the first enemy where, unless the action has another.
    private AplTargetSelection? Selection => Action.TargetSelection ?? (SwitchAction ? AplTargetSelection.First : null);

    private AplDocumentVariable Variable => Action.Variable ?? new AplDocumentVariable("");

    private string VariableName
    {
        get => Variable.Name;
        set => ChangeVariable(v => v with { Name = value });
    }

    // The names the other variable actions set, for the name field's suggestions.
    private IReadOnlyList<string> OtherVariables =>
        ConditionBuilder.Variables(Lists.Select(l => l with { Actions = l.Actions.Where(a => a.Key != Action.Key).ToList() }));

    private IReadOnlyList<ActionList> OtherLists =>
        Lists.Where(l => l.Name != List.Name && !ActionListModel.IsDefaultList(Vocabulary, l)).ToList();

    private bool KnownAbility => Vocabulary.Abilities.Any(a => a.Slug == Action.Ability);

    // A channeled ability's action has Interrupt if, and its ticks when the channel has them.
    private bool Channel => Vocabulary.Channels.Any(c => c.Slug == Action.Ability);

    private bool TickingChannel => Vocabulary.TickingChannels.Contains(Action.Ability);

    // The condition reference's meaning of interrupt_if.
    private static string? InterruptIfTip =>
        AplActionOptions.All.FirstOrDefault(o => o.Syntax.StartsWith($"{AplActionLine.InterruptIfKey}=", StringComparison.Ordinal)).Doc?.Description;

    // An ability that does not channel drops the interrupt.
    private void ChangeAbility(string ability) => Change(a => Vocabulary.Channels.Any(c => c.Slug == ability)
        ? a with { Ability = ability }
        : a with { Ability = ability, InterruptIf = null, InterruptImmediate = false });

    private bool KnownList => OtherLists.Any(l => l.Name == Action.ActionList);

    private string ListTip => Action.Ability == Vocabulary.ListActions[0]
        ? "The actions after this one do not run, even when nothing in the named list is cast."
        : "When nothing in the named list is cast, the next action in this list runs.";

    protected override void OnInitialized() => _hasArguments = !string.IsNullOrEmpty(Action.Arguments);

    // The condition reference's meaning of an action option ("use_off_gcd=1").
    private static string? OptionTip(string key) => AplActionOptions.All.FirstOrDefault(o => o.Syntax == $"{key}=1").Doc?.Description;

    private void Change(Func<EditorAction, EditorAction> change) => Editor.ChangeAction(Action.Key, change);

    private void ChangeVariable(Func<AplDocumentVariable, AplDocumentVariable> change) =>
        Change(a => a with { Variable = change(a.Variable ?? new AplDocumentVariable("")) });

    private void ChangeType(string type)
    {
        bool listAction = ListAction;
        string? firstOther = OtherLists.FirstOrDefault()?.Name;
        Change(a => type switch
        {
            // A Switch target action with no expression yet has no target to keep.
            "" => a with
            {
                Ability = "", ActionList = null, Variable = null,
                TargetSelection = string.IsNullOrWhiteSpace(a.TargetExpression) ? null : a.TargetSelection,
            },
            AplVariable.ActionName => a with
            {
                Ability = type, ActionList = null, TargetSelection = null, TargetExpression = null, Variable = a.Variable ?? new AplDocumentVariable(""),
                UseOffGcd = false, UseWhileCasting = false, InterruptIf = null, InterruptImmediate = false,
            },
            // The action keeps an ability action's target.
            AplSwitchTarget.ActionName => a with
            {
                Ability = type, ActionList = null, TargetSelection = a.TargetSelection ?? AplTargetSelection.First, Variable = null,
                UseOffGcd = false, UseWhileCasting = false, InterruptIf = null, InterruptImmediate = false,
            },
            _ => a with
            {
                Ability = type, ActionList = listAction ? a.ActionList : firstOther, TargetSelection = null, TargetExpression = null, Variable = null,
                UseOffGcd = false, UseWhileCasting = false, InterruptIf = null, InterruptImmediate = false,
            },
        });
    }

    private void ChangeOp(string? value)
    {
        var op = Enum.TryParse<AplVariableOp>(value, out var parsed) ? parsed : AplVariableOp.Set;
        ChangeVariable(v => v with { Op = op });
    }

    private void ChangeDefault(string? value) =>
        ChangeVariable(v => v with { Default = double.TryParse(value, NumberStyles.Float, CultureInfo.InvariantCulture, out double number) ? number : 0 });

    private void ChangeTarget(string? value)
    {
        var selection = Vocabulary.TargetSelections.FirstOrDefault(s => s.Selection.ToString() == value)?.Selection;
        Change(a => selection != null ? a with { TargetSelection = selection } : a with { TargetSelection = null, TargetExpression = null });
    }
}

@using FellowshipSim.Core.APL
@implements IAsyncDisposable
@inject ISimEngine Engine
@inject ActionListStore Store
@inject Visitor Visitor
@inject IJSRuntime JS
@inject ActionListsState SharedState
@inject AplDebuggerState Debugger
@inject IAppViews Views
@*
    Visual action-list editor: one section per action list, each with its actions in priority order. On the APL Editor
    page it edits any hero's lists. Embedded (the Sim page's Modes tab, Hero set) it is the sim's Selected APL: the picker
    of the hero's lists, then the picked list's editor under the edit button, its actions and its text on two tabs.
*@
<Card>
    <div @ref="_root" class="apl-editor">
        @if (Embedded)
        {
            <div class="selected-apl">
                <label class="selected-label" for="@_selectId">Selected APL</label>
                <select id="@_selectId" @key="_pickerKey" disabled="@(Disabled || State.Editor.Vocabulary == null)" @bind:get="State.SelectedSaved" @bind:set="PickSavedAsked">
                    @if (State.SelectedSaved.Length == 0)
                    {
                        <option value="">@(State.Name.Length > 0 ? State.Name : "Imported list")</option>
                    }
                    @foreach (var saved in State.Saved.Where(s => s.Hero.Equals(Hero, StringComparison.OrdinalIgnoreCase)))
                    {
                        <option @key="SavedValue(saved)" value="@SavedValue(saved)">@saved.Name@(saved.BuiltIn ? " (built in)" : saved.Shared ? " (shared)" : "")</option>
                    }
                </select>
                <button type="button" class="icon-button edit-button @(EditorShown ? "on" : "")" aria-label="Edit action list" aria-expanded="@(EditorShown ? "true" : "false")"
                        disabled="@Disabled" data-tooltip="@(EditorShown ? "Hide the editor" : "Edit this action list here")" @onclick="ToggleOpen">
                    <Icon Shape="IconShape.Pencil" />
                </button>
            </div>
            @if (Disabled)
            {
                <p class="hint">Compare is on: each of its runs picks its own action list.</p>
            }
        }
        @if (_pending is { } pending)
        {
            <div class="confirm" role="alertdialog" aria-label="Unsaved changes">
                <span>@(State.Name.Trim().Length > 0 ? State.Name.Trim() : "This list") has changes that are not saved. Save them before @pending.What?</span>
                <button type="button" @onclick="SaveThenContinue">Save</button>
                <button type="button" class="secondary-button" @onclick="DiscardThenContinue">Discard</button>
                <button type="button" class="secondary-button" @onclick="CancelPending">Cancel</button>
            </div>
        }
        @if (State.Editor.Vocabulary is not { } v)
        {
            <Message Kind="State.Editor.Status.Kind">@State.Editor.Status.Text</Message>
        }
        else if (!Embedded || EditorShown)
        {
            <CascadingValue Value="State.Editor" IsFixed="true">
                <ConditionReference @ref="_reference" />
                @if (Embedded)
                {
                    <div class="editor-bar">
                        <nav class="editor-tabs" role="tablist" aria-label="Action list views">
                            <button type="button" role="tab" class="editor-tab @(State.TextOpen ? "" : "selected")" aria-selected="@(State.TextOpen ? "false" : "true")"
                                    @onclick="() => State.TextOpen = false">Actions</button>
                            <button type="button" role="tab" class="editor-tab @(State.TextOpen ? "selected" : "")" aria-selected="@(State.TextOpen ? "true" : "false")"
                                    @onclick="() => State.TextOpen = true">Action list text</button>
                        </nav>
                        <div class="row editor-actions">
                            <button type="button" class="link-button" aria-haspopup="dialog" @onclick="() => _reference.Open()">Condition reference</button>
                            @if (State.HasEdits)
                            {
                                <span class="edited">Edited</span>
                            }
                            <button type="button" class="icon-button" aria-label="Revert" disabled="@(!State.HasEdits || State.SelectedSaved.Length == 0)"
                                    data-tooltip="Undo the changes not saved" @onclick="Revert"><Icon Shape="IconShape.Revert" /></button>
                            <button type="button" class="icon-button" aria-label="Save" data-tooltip="@(PickedOwnList != null ? "Save" : "Save as your own list")"
                                    @onclick="Save"><Icon Shape="IconShape.Save" /></button>
                        </div>
                    </div>
                }
                else
                {
                    <p>
                        <button type="button" class="link-button" aria-haspopup="dialog" @onclick="() => _reference.Open()">Condition reference</button>
                    </p>
                    <div class="row toolbar">
                        <label class="field">
                            Hero
                            <select @key="_pickerKey" @bind:get="v.Hero" @bind:set="SelectHero">
                                @foreach (string hero in State.Heroes)
                                {
                                    <option @key="hero">@hero</option>
                                }
                            </select>
                        </label>
                        <input @ref="_nameInput" aria-label="Action list name" placeholder="Action list name" autocomplete="off" @bind="State.Name" />
                        <select @key="_pickerKey" aria-label="Saved action lists" @bind:get="State.SelectedSaved" @bind:set="PickSavedAsked">
                            <option value="">Load list...</option>
                            @foreach (var saved in State.Saved.Where(s => s.Hero.Equals(v.Hero, StringComparison.OrdinalIgnoreCase)))
                            {
                                <option @key="SavedValue(saved)" value="@SavedValue(saved)">@saved.Name@(saved.BuiltIn ? " (built in)" : saved.Shared ? " (shared)" : "")</option>
                            }
                        </select>
                        <button type="button" class="secondary-button" @onclick="Save">Save</button>
                        <button type="button" class="secondary-button" @onclick="NewAsked">New</button>
                        <button type="button" class="secondary-button" @onclick="Duplicate">Duplicate</button>
                        <button type="button" class="secondary-button delete" disabled="@(!CanDelete)" data-tooltip="@(CanDelete ? null : "Only your own saved lists can be deleted")" @onclick="Delete">Delete</button>
                        <button type="button" class="secondary-button" data-tooltip="Step through one fight of this action list in the APL Debugger, with a build and a fight picked there" @onclick="DebugAsync">Debug</button>
                    </div>
                }
                <Message Kind="State.Editor.Status.Kind">@State.Editor.Status.Text</Message>
                @if (!Embedded || !State.TextOpen)
                {
                    <div>
                        @foreach (var list in State.Editor.Lists)
                        {
                            <ListSection @key="list.Name" Vocabulary="v" Lists="State.Editor.Lists" List="list" Open="State.Editor.Open" DragFrom="State.Editor.DragFrom" />
                        }
                    </div>
                    <div class="row add-list">
                        <input @ref="_newListInput" placeholder="New action list name (aoe)" spellcheck="false" autocomplete="off" @bind="State.NewList" />
                        <button type="button" class="secondary-button" @onclick="AddList">Add action list</button>
                    </div>
                }
                @if (!Embedded)
                {
                    <details @key="State.TextKey" class="text" open="@State.TextOpen">
                        <summary>Action list text</summary>
                        @TextPane(v)
                    </details>
                }
                else if (State.TextOpen)
                {
                    @TextPane(v)
                }
            </CascadingValue>
        }
    </div>
</Card>

@if (_naming)
{
    @* Save of a built-in, shared or imported list: the visitor's own copy, under its name. *@
    <div class="modal-layer" @onclick="CloseNaming" @onkeydown="OnNamingKeyDown">
        <div class="modal small-dialog" role="dialog" aria-modal="true" aria-labelledby="@($"{_selectId}-save")" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h2 id="@($"{_selectId}-save")" class="title">Save action list</h2>
                <button type="button" class="icon-button" aria-label="Close" @onclick="CloseNaming">
                    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
                </button>
            </div>
            <form class="dialog-body" @onsubmit="ConfirmNamingAsync" @onsubmit:preventDefault="true">
                <label class="name-field">
                    Action list name
                    <input @ref="_namingInput" autocomplete="off" spellcheck="false" maxlength="64" @bind="_namingText" @bind:event="oninput" />
                </label>
                <p class="hint">Saves a copy to your action lists and picks it.</p>
                @if (_namingError.Length > 0)
                {
                    <p class="field-error">@_namingError</p>
                }
                <div class="row dialog-actions">
                    <button type="button" class="secondary-button" @onclick="CloseNaming">Cancel</button>
                    <button type="submit">Save</button>
                </div>
            </form>
        </div>
    </div>
}

@code {
    /// <summary>The lists and fields to edit; the APL Editor page's own when null.</summary>
    [Parameter] public ActionListsState? Lists { get; set; }

    /// <summary>The hero whose lists the embedded editor picks from; null on the APL Editor page.</summary>
    [Parameter] public string? Hero { get; set; }

    /// <summary>The list the Sim page runs (kept/hero/name, empty for an imported list), its name and its text (null for the hero's default list).</summary>
    [Parameter] public string Selected { get; set; } = "";

    [Parameter] public string SelectedName { get; set; } = "";

    [Parameter] public string? SelectedText { get; set; }

    /// <summary>Called with the list picked and its text after every pick and edit.</summary>
    [Parameter] public EventCallback<ActionListPick> OnPicked { get; set; }

    /// <summary>Called after a save, so the Sim page's other pickers list the new list.</summary>
    [Parameter] public EventCallback OnSaved { get; set; }

    /// <summary>The picker and editor are off (Compare picks each run's list).</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>The embedded editor shows under the picker.</summary>
    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    private ActionListsState State => Lists ?? SharedState;

    private bool Embedded => Hero != null;

    private bool EditorShown => Open && !Disabled;

    private readonly string _selectId = $"apl-{Guid.NewGuid():N}";

    // The name dialog of a save as the visitor's own list, and the step it was opened for.
    private bool _naming;
    private string _namingText = "";
    private string _namingError = "";
    private ElementReference _namingInput;
    private bool _focusNaming;
    // The last save did not go through; the reason is in the editor's status.
    private bool _saveFailed;

    private SavedActionLists _savedLists = null!;
    private ElementReference _root, _nameInput, _newListInput;
    private ConditionReference _reference = null!;
    private IJSObjectReference? _module, _drag;
    // The lists and vocabulary the action-list text is written for, and the write waiting for its delay.
    private IReadOnlyList<ActionList>? _writtenLists;
    private AplVocabulary? _writtenVocabulary;
    private CancellationTokenSource? _write;
    // The read of the text waiting for its delay, and whether the editor is loading the lists read from the text.
    private CancellationTokenSource? _read;
    private bool _fromText;
    // A text edit changes nothing else on the card, and the field renders itself: the card skips the render the edit's
    // callback asks for, which on a long list would draw every action again.
    private bool _keystroke;

    // The step waiting on the unsaved changes (open another hero, list or a new one), and a key that draws the pickers
    // anew so a cancelled pick shows the list still open.
    private (string What, Func<Task> Then)? _pending;
    private int _pickerKey;

    private const string SharedValue = "shared";
    private const string BuiltInValue = "builtin";

    private static string SavedValue(ActionListEntry saved) => $"{(saved.BuiltIn ? BuiltInValue : saved.Shared ? SharedValue : "own")}/{saved.Hero}/{saved.Name}";

    protected override void OnInitialized()
    {
        _savedLists = new SavedActionLists(Store, Engine, Visitor);
        State.Editor.Changed += EditorChanged;
        State.Editor.ConditionModePicked += StoreConditionMode;
    }

    protected override async Task OnInitializedAsync()
    {
        // The state keeps the editor's lists from an earlier visit to the page; their text is written again in case the
        // visit ended inside the write's delay. A text edit not in the lists yet is read again.
        if (State.Loaded)
        {
            if (State.TextEdited) ReadLater(State.Text);
            else WriteText();
            return;
        }
        if (Embedded)
        {
            try
            {
                var heroVocabulary = await VocabularyOf(Hero!);
                State.Saved = await _savedLists.ListAsync();
                State.Editor.Load(heroVocabulary, []);
                State.Loaded = true;
                await LoadSelected();
            }
            catch (Exception e)
            {
                Fail(e);
            }
            return;
        }
        try
        {
            State.Heroes = await Engine.GetHeroesAsync();
            var v = await VocabularyOf(State.Heroes[0]);
            State.Saved = await _savedLists.ListAsync();
            State.Editor.Load(v, []);
            State.Loaded = true;
            await PickDefault(v.Hero);
        }
        catch (Exception e)
        {
            State.Editor.SetStatus(MessageState.Error(e.Message));
        }
    }

    // The Sim page's list changed outside the editor (an import, a sim run again, another hero's list): the editor opens it.
    // A pick or load under way has set the editor's list already. The page has its list once it ends.
    protected override async Task OnParametersSetAsync()
    {
        if (!Embedded || !State.Loaded || _loading) return;
        if (Selected == State.SelectedSaved && (SelectedText == null || SelectedText == State.Text)) return;
        await LoadSelected();
    }

    // A pick or load of the embedded editor's list is under way.
    private bool _loading;

    /// <summary>Opens the Sim page's list: the saved one picked, or an imported list's text.</summary>
    private async Task LoadSelected()
    {
        if (Selected.Length > 0)
        {
            await PickSaved(Selected);
            return;
        }
        _loading = true;
        try
        {
            _read?.Cancel();
            _write?.Cancel();
            State.SelectedSaved = "";
            State.Name = SelectedName;
            State.Text = SelectedText ?? "";
            State.TextEdited = false;
            State.Editor.SetStatus(MessageState.None);
            try
            {
                LoadFromText(await Engine.ParseActionListAsync(State.Text));
            }
            catch (Exception e)
            {
                State.TextEdited = true;
                State.TextOpen = true;
                State.Editor.SetStatus(MessageState.Error($"The list does not parse: {e.Message}"));
            }
            State.MarkClean();
        }
        finally
        {
            _loading = false;
        }
        await Report();
    }

    /// <summary>Gives the Sim page the embedded editor's list and its text, edits included.</summary>
    private Task Report() =>
        Embedded ? OnPicked.InvokeAsync(new ActionListPick(State.SelectedSaved, State.Name, State.Text)) : Task.CompletedTask;

    private Task ToggleOpen() => OpenChanged.InvokeAsync(!Open);

    // The saved list again, without the edits.
    private Task Revert() => State.SelectedSaved.Length > 0 ? PickSaved(State.SelectedSaved) : Task.CompletedTask;

    private void OpenNaming()
    {
        _naming = true;
        _namingText = PickedOwnList != null || State.Name.Length == 0 ? State.Name : $"{State.Name} copy";
        _namingError = "";
        _focusNaming = true;
    }

    private void CloseNaming() => _naming = false;

    private void OnNamingKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseNaming();
    }

    private async Task ConfirmNamingAsync()
    {
        string name = _namingText.Trim();
        if (!ActionListStore.IsValidName(name))
        {
            _namingError = "Name the list with letters, digits, spaces, '_' and '-' (up to 64 characters).";
            return;
        }
        if (State.Saved.Any(s => s is { BuiltIn: false, Shared: false } && s.Hero.Equals(Hero, StringComparison.OrdinalIgnoreCase)
                                 && s.Name.Equals(name, StringComparison.OrdinalIgnoreCase)))
        {
            _namingError = $"You have a {Hero} list named {name}.";
            return;
        }
        State.Name = name;
        await Save(named: true);
        if (_saveFailed)
        {
            _namingError = State.Editor.Status.Text;
            return;
        }
        _naming = false;
        if (_pending is { } pending)
        {
            _pending = null;
            await pending.Then();
        }
    }

    // The action list's text, its download and its problem: under the APL Editor's details, or the embedded editor's tab.
    private RenderFragment TextPane(AplVocabulary v) => __builder =>
    {
        <div class="text-field">
            <CodeField Vocabulary="v" Lines="true" Value="@State.Text" OnChange="TextChanged" Placeholder="actions+=/ability,if=condition" />
        </div>
        <div class="row">
            <button type="button" class="secondary-button" data-tooltip="Save the action list as a .simc file" @onclick="Download">Download</button>
        </div>
        <Message Kind="State.TextStatus.Kind">@State.TextStatus.Text</Message>
    };

    protected override bool ShouldRender()
    {
        if (!_keystroke) return true;
        _keystroke = false;
        return false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusNaming)
        {
            _focusNaming = false;
            await _namingInput.FocusAsync();
        }
        if (!firstRender) return;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/FellowshipSim.UI/apl/actionListsCard.js");
            State.Editor.ConditionMode = await _module.InvokeAsync<string>("readConditionMode");
            _drag = await _module.InvokeAsync<IJSObjectReference>("attachDrag", _root);
        }
        catch (JSDisconnectedException)
        {
            // The page closed before the module loaded.
        }
    }

    private void EditorChanged()
    {
        WriteText();
        _ = InvokeAsync(StateHasChanged);
    }

    private async void StoreConditionMode(string mode)
    {
        try
        {
            if (_module != null) await _module.InvokeVoidAsync("writeConditionMode", mode);
        }
        catch (Exception e) when (e is JSDisconnectedException or JSException or OperationCanceledException)
        {
            // The choice lasts until the page reloads.
        }
    }

    private async Task<AplVocabulary> VocabularyOf(string hero) =>
        await Engine.GetVocabularyAsync(hero) ?? throw new KeyNotFoundException($"No hero named {hero}.");

    private void Fail(Exception e) => State.Editor.SetStatus(MessageState.Error(e.Message));

    // The action-list text follows every change to the actions, 250 ms after the last one.
    private void WriteText()
    {
        if (State.Editor.Vocabulary is not { } v) return;
        var lists = State.Editor.Lists;
        if (ReferenceEquals(lists, _writtenLists) && ReferenceEquals(v, _writtenVocabulary)) return;
        _writtenLists = lists;
        _writtenVocabulary = v;
        _write?.Cancel();
        // Lists read from the text are the text already. A text edit that does not parse stays, and goes into the lists in
        // place of their changes once it parses.
        if (_fromText) return;
        if (State.TextEdited)
        {
            State.Editor.SetStatus(MessageState.Error("The action list text has an edit that does not parse. Fix it there: once it parses, it replaces the lists."));
            return;
        }
        _write = new CancellationTokenSource();
        _ = Write(v, lists, _write.Token);
    }

    private async Task Write(AplVocabulary v, IReadOnlyList<ActionList> lists, CancellationToken ct)
    {
        MessageState? status = null;
        string? text = null;
        try
        {
            await Task.Delay(250, ct);
            var result = await Engine.WriteActionListAsync(ActionListModel.DocumentActions(lists), ct);
            if (result.Text != null) text = result.Text;
            else status = MessageState.Error(ActionListModel.ErrorText(v, lists, result.Errors));
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            return;
        }
        catch (Exception e)
        {
            status = MessageState.Error(e.Message);
        }
        await InvokeAsync(() =>
        {
            // A text edit not in the lists yet stays: the lists' text would write over it.
            if (ct.IsCancellationRequested || State.TextEdited) return;
            if (text != null)
            {
                State.Text = text;
                State.TextStatus = MessageState.None;
                _ = Report();
            }
            else
            {
                State.TextStatus = status!;
            }
            StateHasChanged();
        });
    }

    // Another hero's lists are of no use to this one: the editor opens the new hero's built-in default list, and the
    // saved lists show only theirs.
    private Task SelectHero(string hero) => AskFirst($"opening {hero}", () => OpenHero(hero));

    private async Task OpenHero(string hero)
    {
        try
        {
            State.Editor.SetVocabulary(await VocabularyOf(hero));
            await PickDefault(State.Editor.Vocabulary!.Hero);
        }
        catch (Exception e)
        {
            Fail(e);
        }
    }

    /// <summary>Opens <paramref name="hero"/>'s built-in default list, or an empty one when it has none.</summary>
    private Task PickDefault(string hero)
    {
        string defaultList = SavedValue(new ActionListEntry(hero, DefaultActionLists.DefaultName, BuiltIn: true));
        return PickSaved(State.Saved.Any(s => SavedValue(s) == defaultList) ? defaultList : "");
    }

    private async Task LoadSavedLists(string selected = "")
    {
        State.Saved = await _savedLists.ListAsync();
        State.SelectedSaved = selected;
    }

    private async Task AddList()
    {
        if (State.Editor.AddList(State.NewList.Trim())) State.NewList = "";
        else await _newListInput.FocusAsync();
    }

    // The action list as it is now, edits included, in the APL Debugger.
    private async Task DebugAsync()
    {
        if (State.Editor.Vocabulary is not { } v) return;
        var lists = State.Editor.Lists;
        try
        {
            var written = await Engine.WriteActionListAsync(ActionListModel.DocumentActions(lists));
            if (written.Text == null)
            {
                State.Editor.SetStatus(MessageState.Error(ActionListModel.ErrorText(v, lists, written.Errors)));
                return;
            }
            Debugger.OpenActionList(v.Hero, State.Name.Trim().Length > 0 ? State.Name.Trim() : "Unsaved list", written.Text);
            Views.ShowDebugger();
        }
        catch (Exception e) when (e is SimEngineException or HttpRequestException)
        {
            State.Editor.SetStatus(MessageState.Error(e.Message));
        }
    }

    private Task Download() =>
        FileDownloads.SaveAsync(JS, State.Name.Trim().Length > 0 ? State.Name : State.Editor.Vocabulary?.Hero ?? "action list", ".simc", State.Text);

    // The text goes into the lists 400 ms after the last edit, when it parses. A builder write waiting for its delay would
    // write over the edit, so it stops.
    private void TextChanged(string text)
    {
        _keystroke = true;
        ReadLater(text);
    }

    private void ReadLater(string text)
    {
        State.Text = text;
        State.TextEdited = true;
        _write?.Cancel();
        _read?.Cancel();
        _read = new CancellationTokenSource();
        _ = Read(text, _read.Token);
        _ = Report();
    }

    /// <summary>Puts the text edit waiting for its delay into the lists; false, with the problem in the status, when it does not parse.</summary>
    private async Task<bool> ReadTextNow()
    {
        _read?.Cancel();
        string text = State.Text;
        try
        {
            var result = await Engine.ParseActionListAsync(text);
            if (State.Text != text) return false;
            LoadFromText(result);
            return true;
        }
        catch (Exception e)
        {
            State.TextStatus = MessageState.Error(e.Message);
            State.Editor.SetStatus(MessageState.Error($"Fix the action list text first. {e.Message}"));
            return false;
        }
    }

    private void LoadFromText(AplDocumentActions result)
    {
        // The lists came from the text: writing them back would reformat the text being typed.
        _fromText = true;
        try
        {
            State.Editor.Replace(result.Actions);
        }
        finally
        {
            _fromText = false;
        }
        State.TextEdited = false;
        State.TextStatus = MessageState.None;
    }

    private async Task Read(string text, CancellationToken ct)
    {
        AplDocumentActions? result = null;
        MessageState? status = null;
        try
        {
            await Task.Delay(400, ct);
            result = await Engine.ParseActionListAsync(text, ct);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            return;
        }
        catch (Exception e)
        {
            // The field marks a parse error itself; any other failure names its own.
            status = MessageState.Error($"{(e is SimEngineException ? "" : e.Message + " ")}The lists above keep the text's last version that parsed.");
        }
        await InvokeAsync(() =>
        {
            if (ct.IsCancellationRequested || State.Text != text) return;
            if (result != null)
            {
                LoadFromText(result);
                if (State.Editor.Status.Kind == MessageKind.Error) State.Editor.SetStatus(MessageState.None);
            }
            else
            {
                State.TextStatus = status!;
            }
            StateHasChanged();
        });
    }

    private async Task PickSaved(string value)
    {
        _loading = true;
        try
        {
            await PickSavedNow(value);
        }
        finally
        {
            _loading = false;
        }
        await Report();
    }

    private async Task PickSavedNow(string value)
    {
        // Another list replaces the text, with any edit of it.
        _read?.Cancel();
        State.TextEdited = false;
        State.SelectedSaved = value;
        State.Editor.SetStatus(MessageState.None);
        if (value.Length == 0)
        {
            State.Name = "";
            State.Editor.Load(State.Editor.Vocabulary!, []);
            State.MarkClean();
            return;
        }
        string[] parts = value.Split('/');
        string hero = parts.Length > 1 ? parts[1] : "", savedName = parts.Length > 2 ? parts[2] : "";
        try
        {
            var list = await _savedLists.ReadAsync(new ActionListEntry(hero, savedName, Shared: parts[0] == SharedValue, BuiltIn: parts[0] == BuiltInValue));
            var heroVocabulary = await VocabularyOf(hero);
            State.Editor.SetVocabulary(heroVocabulary);
            State.Name = savedName;
            if (list.Error != null)
            {
                State.Text = list.Text.ReplaceLineEndings("\n");
                State.TextEdited = true;
                State.TextOpen = true;
                State.TextKey++;
                State.Editor.SetStatus(MessageState.Error($"The saved text does not parse: {list.Error}"));
                State.MarkClean();
                return;
            }
            // The saved text is the list's text until the editor writes its own.
            State.Text = list.Text.ReplaceLineEndings("\n");
            State.Editor.Load(heroVocabulary, list.Actions ?? []);
            State.MarkClean();
        }
        catch (Exception e)
        {
            Fail(e);
        }
    }

    // The saved list picked, when it is one of the visitor's own.
    private ActionListEntry? PickedOwnList =>
        State.Saved.FirstOrDefault(s => SavedValue(s) == State.SelectedSaved) is { Shared: false, BuiltIn: false } own ? own : null;

    private bool CanDelete => PickedOwnList != null;

    private Task NewAsked() => AskFirst("starting a new list", () => PickSaved(""));

    private Task PickSavedAsked(string value)
    {
        var picked = State.Saved.FirstOrDefault(s => SavedValue(s) == value);
        return AskFirst(picked != null ? $"opening {picked.Name}" : "starting a new list", () => PickSaved(value));
    }

    /// <summary>Runs <paramref name="then"/> now, or after asking to save when the lists have changes not saved.</summary>
    private Task AskFirst(string what, Func<Task> then)
    {
        if (!State.HasEdits) return then();
        _pending = (what, then);
        _pickerKey++;
        return Task.CompletedTask;
    }

    private async Task SaveThenContinue()
    {
        if (_pending is not { } pending) return;
        await Save();
        // A save that failed keeps the question, with the reason in the status.
        if (State.HasEdits) return;
        _pending = null;
        await pending.Then();
    }

    private async Task DiscardThenContinue()
    {
        if (_pending is not { } pending) return;
        _pending = null;
        await pending.Then();
    }

    private void CancelPending() => _pending = null;

    // A copy of the lists, not saved yet: Save keeps it under its new name.
    private void Duplicate()
    {
        State.Name = State.Name.Length > 0 ? $"{State.Name} copy" : "copy";
        State.SelectedSaved = "";
        State.Editor.SetStatus(MessageState.Ok($"Copied to {State.Name}; save it to keep it."));
    }

    private async Task Delete()
    {
        if (PickedOwnList is not { } list) return;
        try
        {
            await _savedLists.DeleteAsync(list);
            await LoadSavedLists();
            State.Editor.SetStatus(MessageState.Ok($"Deleted {list.Name}. The editor keeps its actions until you change them."));
        }
        catch (Exception e)
        {
            Fail(e);
        }
    }

    // The embedded editor saves the visitor's own list under its name, and any other as a copy named in the save dialog.
    private async Task Save() => await Save(named: false);

    private async Task Save(bool named)
    {
        if (Embedded && !named && PickedOwnList == null)
        {
            OpenNaming();
            return;
        }
        _saveFailed = true;
        var v = State.Editor.Vocabulary!;
        string listName = State.Name.Trim();
        if (listName.Length == 0)
        {
            State.Editor.SetStatus(MessageState.Error("Name the action list first."));
            await _nameInput.FocusAsync();
            return;
        }
        if (State.TextEdited && !await ReadTextNow()) return;
        var lists = State.Editor.Lists;
        try
        {
            var saved = await _savedLists.SaveAsync(v.Hero, listName, ActionListModel.DocumentActions(lists));
            State.MarkClean();
            // No folder in the message: on a stream it would show the user's name.
            State.Editor.SetStatus(MessageState.Ok($"Saved {saved.Name} to your action lists."));
            await LoadSavedLists(SavedValue(saved));
            _saveFailed = false;
            if (Embedded)
            {
                await Report();
                await OnSaved.InvokeAsync();
            }
        }
        catch (ActionListNotSavedException e)
        {
            State.Editor.SetStatus(MessageState.Error($"{e.Message} {ActionListModel.ErrorText(v, lists, e.Errors)}".Trim()));
        }
        catch (Exception e)
        {
            Fail(e);
        }
    }

    public async ValueTask DisposeAsync()
    {
        State.Editor.Changed -= EditorChanged;
        State.Editor.ConditionModePicked -= StoreConditionMode;
        _write?.Cancel();
        _read?.Cancel();
        try
        {
            if (_drag != null)
            {
                await _drag.InvokeVoidAsync("dispose");
                await _drag.DisposeAsync();
            }
            if (_module != null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The page is gone, and the listeners with it.
        }
    }
}

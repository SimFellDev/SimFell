@using FellowshipSim.Core.APL
@using Microsoft.AspNetCore.Components.Rendering
@implements IDisposable
@*
    The action's target, variable value and condition, coloured, once each has stayed the same for 300 ms; its
    use_off_gcd and use_while_casting; its interrupt_if; and a run_action_list's warning.
*@
<div class="summary">@if (!string.IsNullOrWhiteSpace(_target.Text))
    {
        RenderClause(__builder, "target",
            (ActionListModel.SelectionName(Vocabulary, Action.TargetSelection ?? AplTargetSelection.First)?.Label ?? "").ToLowerInvariant(), _target);
    }
    @if (ActionListModel.IsVariableAction(Action) && Action.Variable is { } variable && !string.IsNullOrWhiteSpace(variable.Name))
    {
        RenderClause(__builder, variable.Op.ToString().ToLowerInvariant(), variable.Name.Trim(), variable.Op == AplVariableOp.Reset ? null : _value);
    }
    @if (!string.IsNullOrWhiteSpace(_condition.Text))
    {
        RenderClause(__builder, "if", null, _condition);
    }
    @if (Action.UseOffGcd)
    {
        RenderClause(__builder, "use", "off the global cooldown", null);
    }
    @if (Action.UseWhileCasting)
    {
        RenderClause(__builder, "use", "while casting", null);
    }
    @if (!string.IsNullOrWhiteSpace(_interrupt.Text))
    {
        RenderClause(__builder, "interrupt", Action.InterruptImmediate ? "immediately if" : "if", _interrupt);
    }
    @if (Warning is { } warning)
    {
        <p class="field-warning">@warning</p>
    }</div>

@code {
    [CascadingParameter] public ActionListEditor Editor { get; set; } = null!;

    [Parameter, EditorRequired] public AplVocabulary Vocabulary { get; set; } = null!;

    [Parameter, EditorRequired] public IReadOnlyList<ActionList> Lists { get; set; } = [];

    [Parameter, EditorRequired] public EditorAction Action { get; set; } = null!;

    private DebouncedCheck _condition = null!, _target = null!, _value = null!, _interrupt = null!;

    private string? Warning => ActionListModel.IsRunAction(Vocabulary, Action) ? ActionListModel.RunWarning(Vocabulary, Lists, Action.ActionList) : null;

    protected override void OnInitialized()
    {
        Func<System.Action, Task> dispatch = change => InvokeAsync(() =>
        {
            change();
            StateHasChanged();
        });
        _condition = new DebouncedCheck(Editor.Checks, TimeSpan.FromMilliseconds(300), dispatch);
        _target = new DebouncedCheck(Editor.Checks, TimeSpan.FromMilliseconds(300), dispatch);
        _value = new DebouncedCheck(Editor.Checks, TimeSpan.FromMilliseconds(300), dispatch);
        _interrupt = new DebouncedCheck(Editor.Checks, TimeSpan.FromMilliseconds(300), dispatch);
    }

    protected override void OnParametersSet()
    {
        _condition.Set(Vocabulary.Hero, Action.Condition ?? "");
        _target.Set(Vocabulary.Hero, Action.TargetExpression ?? "");
        _value.Set(Vocabulary.Hero, Action.Variable?.Value ?? "");
        _interrupt.Set(Vocabulary.Hero, Action.InterruptIf ?? "");
    }

    // A clause with no check is its keyword and label alone: a variable's reset.
    private void RenderClause(RenderTreeBuilder __builder, string keyword, string? label, DebouncedCheck? clause)
    {
        string text = clause?.Text ?? "";
        <div class="clause"><span class="keyword">@keyword</span>@(" " + (label != null ? $"{label} " : ""))@if (clause == null)
            {
            }
            else if (clause.Result is { } result && result.Text == text)
            {
                <Highlight Text="@text" Check="result.Check" />
            }
            else
            {
                @text
            }</div>
    }

    public void Dispose()
    {
        _condition.Dispose();
        _target.Dispose();
        _value.Dispose();
        _interrupt.Dispose();
    }
}

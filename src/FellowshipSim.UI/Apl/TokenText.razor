@using FellowshipSim.Core.APL
@* Text in the colour of its token kind (design-system.css), marked when a parse error is in it. *@
<span class="@HighlightSegment.ClassOf(Kind, Error)">@Text</span>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = "";

    [Parameter] public AplTokenKind? Kind { get; set; }

    [Parameter] public bool Error { get; set; }
}

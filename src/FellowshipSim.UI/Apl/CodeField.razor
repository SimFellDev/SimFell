@using FellowshipSim.Core.APL
@implements IAsyncDisposable
@inject IJSRuntime JS
@*
    A code editor (CodeMirror, in codeField.js) with its text coloured by the engine's check, and the completion list at
    its caret. Typing a name or a '.', or Ctrl+Space, opens the list; Enter or Tab writes the pick in place of the part at
    the caret. A pick with parts after it is written with its '.', and the list opens on those parts.
    The editor's text belongs to codeField.js: the component sends it a new value and receives each edit.
    With Lines, the text is a whole action list: Enter starts a new line, and the list's check colours it and ListEdits
    completes it.
*@
<div>
    <div @ref="_field" class="code-field @(Lines ? "lines" : null) @(Check?.Error != null ? "invalid" : null)" hidden="@Hidden"></div>
    <div>
        @if (Check?.Error is { } error)
        {
            <p class="field-error">@error</p>
        }
        @if (!string.IsNullOrWhiteSpace(Text))
        {
            foreach (string problem in Problems)
            {
                <p @key="problem" class="field-warning">@problem</p>
            }
        }
    </div>
</div>

@code {
    [CascadingParameter] public ActionListEditor Editor { get; set; } = null!;

    [Parameter, EditorRequired] public AplVocabulary Vocabulary { get; set; } = null!;

    [Parameter] public string? Value { get; set; }

    [Parameter] public string Placeholder { get; set; } = "";

    [Parameter] public EventCallback<string> OnChange { get; set; }

    /// <summary>Hides the input; its messages still show.</summary>
    [Parameter] public bool Hidden { get; set; }

    /// <summary>True when the text is a whole action list, not one expression.</summary>
    [Parameter] public bool Lines { get; set; }

    private ElementReference _field;
    private IJSObjectReference? _module, _handle;
    private DotNetObjectReference<CodeField>? _self;
    private DebouncedCheck _checked = null!;
    /// <summary>The editor's text, as codeField.js last reported or was sent it.</summary>
    private string _editorText = "";
    private bool _push;
    /// <summary>The check whose colours the editor has.</summary>
    private CheckedText? _shown;

    // The editor's text has "\n" line breaks alone, and the check's token offsets count them.
    private string Text => (Value ?? "").ReplaceLineEndings("\n");

    private AplExpressionCheck? Check => string.IsNullOrWhiteSpace(Text) ? null : _checked.Result?.Check;

    // The problems of the last check: a long list's check has thousands of tokens.
    private (AplExpressionCheck? Check, IReadOnlyList<string> Problems)? _problems;

    private IReadOnlyList<string> Problems => _problems is { } last && ReferenceEquals(last.Check, Check)
        ? last.Problems
        : (_problems = (Check, ActionListModel.ProblemsOf(Check))).Value.Problems;

    protected override void OnInitialized()
    {
        _checked = new DebouncedCheck(Editor.Checks, TimeSpan.FromMilliseconds(150), change => InvokeAsync(() =>
        {
            change();
            StateHasChanged();
        }), Lines);
        _editorText = Text;
    }

    protected override void OnParametersSet()
    {
        _checked.Set(Vocabulary.Hero, Text);
        if (Text != _editorText)
        {
            _editorText = Text;
            _push = _handle != null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/FellowshipSim.UI/apl/codeField.js");
            _handle = await _module.InvokeAsync<IJSObjectReference>("attach", _field, _self, _editorText, Lines, Placeholder);
        }
        if (_handle == null) return;
        if (_push)
        {
            _push = false;
            await _handle.InvokeVoidAsync("setValue", _editorText);
        }
        var result = _checked.Result;
        if (!ReferenceEquals(result, _shown))
        {
            _shown = result;
            await _handle.InvokeVoidAsync("highlight", result == null ? null : HighlightMarks.Of(result.Text, result.Check));
        }
    }

    [JSInvokable]
    public async Task Input(string value)
    {
        _editorText = value;
        await OnChange.InvokeAsync(value);
    }

    /// <summary>The completion list at <paramref name="at"/> in <paramref name="text"/>; <paramref name="always"/> for Ctrl+Space.</summary>
    [JSInvokable]
    public CompletionReply? Complete(string text, int at, bool always) =>
        (Lines ? ListEdits.Open(Vocabulary, text, at, always) : CodeEdits.Open(Vocabulary, text, at, always)) is { } list
            ? CompletionReply.Of(list)
            : null;

    // The editor writes 'and', 'or' and 'not': on leaving the field, '&', '|' and '!' become their words.
    [JSInvokable]
    public async Task Blur()
    {
        if (Lines) return;
        string text = _editorText;
        var check = await Editor.Checks.Get(Vocabulary.Hero, text);
        if (_editorText != text || check?.InWords is not { } inWords || inWords == text) return;
        _editorText = inWords;
        await OnChange.InvokeAsync(inWords);
        if (_handle != null) await _handle.InvokeVoidAsync("setValue", inWords);
    }

    public async ValueTask DisposeAsync()
    {
        _checked.Dispose();
        try
        {
            if (_handle != null)
            {
                await _handle.InvokeVoidAsync("dispose");
                await _handle.DisposeAsync();
            }
            if (_module != null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The page is gone, and the editor with it.
        }
        _self?.Dispose();
    }
}

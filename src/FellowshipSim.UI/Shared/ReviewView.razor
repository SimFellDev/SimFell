@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IReviewPages ReviewPages
@inject IJSRuntime JS
@inject ReplayLibrary Library
@inject VisitorReviews VisitorReviews
@inject Visitor Visitor
@inject IAppViews Views
@*
    A review page from the reviews folder, shown in the app page itself (reviewView.js), so the app page's scroll bar
    scrolls it. Save keeps it as its own HTML file. Findings JSON reads the review's findings file in .NET, so it works in
    the web, desktop and browser apps alike.
*@
<div class="review-bar">
    <div class="leading">@Leading</div>
    <div class="downloads">
        @if (_hasFindings)
        {
            <button type="button" class="secondary-button" data-tooltip="Download the review's findings as JSON, the input of /replay-fix" @onclick="DownloadFindingsAsync">Findings JSON</button>
        }
        <button type="button" class="secondary-button" disabled="@(!_loaded)" data-tooltip="Save this review as an HTML file" @onclick="SaveAsync">Save as HTML</button>
    </div>
</div>
<div @ref="_host" class="review-host"></div>

@code {
    private ElementReference _host;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ReviewView>? _self;
    private string? _shown;
    private bool _loaded;
    private bool _hasFindings;

    [Parameter, EditorRequired] public string HtmlFile { get; set; } = "";

    /// <summary>Shown left of the save button, such as the way back.</summary>
    [Parameter] public RenderFragment? Leading { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shown == HtmlFile) return;
        _shown = HtmlFile;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/FellowshipSim.UI/review/reviewView.js");
            _self ??= DotNetObjectReference.Create(this);
            _loaded = false;
            _hasFindings = false;
            _loaded = await _module.InvokeAsync<bool>("show", _host, ReviewPages.Url(HtmlFile), _self);
            // A free-dice page and a review from before the file existed have none.
            _hasFindings = _loaded && File.Exists(FindingsPath);
            StateHasChanged();
        }
        catch (JSDisconnectedException)
        {
            // The page closed before the review showed.
        }
    }

    /// <summary>The review page's file, when the visitor ran the review; for the desktop app, whose review host is another origin.</summary>
    [JSInvokable]
    public Task<string?> Read() => ReadFileAsync(Path.Combine(Library.ReviewsDirectory, Path.GetFileName(HtmlFile)));

    private string FindingsName => Path.GetFileNameWithoutExtension(HtmlFile) + ".findings";

    private string FindingsPath => Path.Combine(Library.ReviewsDirectory, FindingsName + ".json");

    private async Task<string?> ReadFileAsync(string path)
    {
        string name = Path.GetFileName(path);
        if (!await VisitorReviews.HasAsync(Visitor, name.Split('.')[0]) || !File.Exists(path)) return null;
        return await File.ReadAllTextAsync(path);
    }

    private async Task DownloadFindingsAsync()
    {
        if (await ReadFileAsync(FindingsPath) is { } text) await FileDownloads.SaveAsync(JS, FindingsName, ".json", text);
    }

    /// <summary>Opens another review page a link of this one names (the free-dice page links its replay review).</summary>
    [JSInvokable]
    public void Open(string htmlFile) => _ = InvokeAsync(() => Views.ShowReview(Path.GetFileName(htmlFile), "Review"));

    private async Task SaveAsync()
    {
        if (_module != null) await _module.InvokeVoidAsync("save", _host, Path.GetFileName(HtmlFile));
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module != null)
            {
                await _module.InvokeVoidAsync("dispose", _host);
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the page with it.
        }
        _self?.Dispose();
    }
}

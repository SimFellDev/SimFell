@* A status line under a form: plain, Ok (green), Error (red) or Warning (amber). *@
<p class="message @KindClass">@ChildContent</p>

@code {
    [Parameter] public MessageKind Kind { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string KindClass => Kind switch
    {
        MessageKind.Ok => "ok",
        MessageKind.Error => "error",
        MessageKind.Warning => "warning",
        _ => "",
    };
}

<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The [JSExport] methods the sim workers call (SimWorker). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Sims, results and reviews cross between the page and its workers as JSON of the engine's own records. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- index.html's #[.{fingerprint}] placeholders and import map get each build's file names, so a browser that kept an
         older build's start files (GitHub Pages lets it keep them for 10 minutes) cannot start that build again. -->
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FellowshipSim.UI\FellowshipSim.UI.csproj" />
  </ItemGroup>

  <!-- Each build's stamp, on the sim scripts' addresses (SimWorkerPool): a browser that kept an older build's scripts
       loads this build's instead. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildStamp</_Parameter1>
      <_Parameter2>$([System.DateTime]::UtcNow.ToString("yyyyMMddHHmmss"))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- The catalog finds heroes, talents, traits and gear by reflection: trimming keeps every type of the app's own assemblies. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="FellowshipSim.Core" />
    <TrimmerRootAssembly Include="FellowshipSim.Engine" />
    <TrimmerRootAssembly Include="FellowshipSim.Logs" />
    <TrimmerRootAssembly Include="FellowshipSim.UI" />
  </ItemGroup>

  <!-- A developer's FellowshipLogs API client: the repository's git-ignored settings.json becomes wwwroot/appsettings.json,
       which Blazor reads as configuration. A build without one (the deploy) has no client. -->
  <Target Name="DeveloperSettings" BeforeTargets="BeforeBuild">
    <Copy SourceFiles="..\..\settings.json" DestinationFiles="wwwroot\appsettings.json" Condition="Exists('..\..\settings.json')" />
    <Delete Files="wwwroot\appsettings.json" Condition="!Exists('..\..\settings.json')" />
  </Target>

</Project>

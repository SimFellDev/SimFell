# Xavian's default action list: the order the logged Xavian players follow (data/fights, patch 0.5.0.0). Brilliant Flash
# is Brilliant Flare while Xavian holds a Swift Reprieval or an Omega Reprieval.
actions.precombat=snapshot_stats
actions.precombat+=/aura_of_solace
# Swing the weapon whenever the swing timer allows.
actions=attack
actions+=/aura_of_solace,if=!buff.aura_of_solace.up
actions+=/decree_of_the_sun
actions+=/omega_reprieval
actions+=/solar_shield
actions+=/shining_halo
actions+=/solar_blades
actions+=/omnistrike
actions+=/brilliant_flash,if=buff.omega_reprieval.up
actions+=/sky_crash
actions+=/ruptured_dawn
actions+=/blinding_slash
actions+=/brilliant_flash
actions+=/sun_strike

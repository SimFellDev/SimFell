# Gunde's default action list: FellowSimc's SimC list (apl/gunde/gunde_apl.simc) in SimFell's names.
# Left out: the Carrion Onslaught legendary's lines (the engine did not have it when the list was made), Earthbreaker (a
# weapon the engine does not have) and the Rend stack checks (the engine does not show Rend to action lists): the Heart
# Splitter line at 200 Rend stacks goes, and the Slaughter line keeps the rest of its condition.
actions.precombat=snapshot_stats
# Swing the weapon whenever the swing timer allows.
actions=attack
actions+=/bloodbound_spirit,if=buff.reign_in_blood.up
actions+=/reign_in_blood
actions+=/owed_in_blood,target_if=debuff.open_wounds.up,if=!buff.bloodcraze.up&buff.owed_in_blood.stack>=30&buff.reign_in_blood.up
actions+=/sahrils_wrath,if=buff.spirit_of_heroism.up|spirit.deficit>=90
actions+=/voidbringers_touch
actions+=/slaughter,if=fight_remains<=10
actions+=/slaughter,if=talent.massacre&blessing.the_philosopher&(cooldown.heart_splitter.charges=0|active_enemies>2&!talent.oathshatter)&(!cooldown.grim_carve.up|active_enemies<3)
actions+=/fated_strike,if=!cooldown.heart_splitter.up&active_enemies<3|active_enemies>3&!cooldown.grim_carve.up
actions+=/blood_arc,if=active_enemies<3&cooldown.rupture.up&!buff.serrated_edge.up|active_enemies>3&cooldown.grim_carve.up
actions+=/rupture,if=buff.serrated_edge.up&active_enemies<=2|active_enemies>2
actions+=/grim_carve,if=buff.grim_harvest.up
actions+=/heart_splitter,if=full_recharge_time<=gcd.max*3&(active_enemies<3|talent.oathshatter)
actions+=/heart_splitter,if=buff.serrated_edge.up&(active_enemies<3|talent.oathshatter)&(talent.darkening_hearts&target.health.pct<=30|legendary.bleeding_hearts)
actions+=/slaughter,if=(!talent.massacre|!blessing.the_philosopher)&(!cooldown.heart_splitter.up|active_enemies>2&!talent.oathshatter)&!cooldown.grim_carve.up&debuff.open_wounds.up&!legendary.bleeding_hearts
actions+=/grim_carve
actions+=/blood_arc
actions+=/fated_strike
actions+=/reavers_edge
actions+=/double_strike

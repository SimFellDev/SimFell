# Elarion, the Heartseeker build of the logged fights: Piercing Seekers, Fusillade, Repeating Stars, Lunar Fury,
# Rising Moon, Lunarlight Affinity, Fervent Supremacy, Last Lights, Skylit Grace.
actions+=/shoot
actions+=/event_horizon
actions+=/skystriders_grace
actions+=/lunarlight_mark
actions+=/chronoshift
actions+=/skystriders_supremacy
actions+=/starfall_volley
actions+=/heartseeker_barrage

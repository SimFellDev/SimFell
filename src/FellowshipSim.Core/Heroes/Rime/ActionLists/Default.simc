# Rime's default action list: picks the Talons, Frostweaver or Soulfrost list by talent, else the generic list.
# The four lists are the same as Talons.simc, Frostweaver.simc, Soulfrost.simc and Generic.simc.
actions.precombat=snapshot_stats
actions.precombat+=/frost_bolt
# Interrupt a casting target.
actions=brain_freeze,if=target.casting
actions+=/run_action_list,name=talons,if=talent.icy_talons
actions+=/run_action_list,name=frostweaver,if=talent.frostweavers_wrath
actions+=/run_action_list,name=soulfrost,if=talent.soulfrost_torrent
actions+=/run_action_list,name=main

# ---- Talons
actions.talons=ice_blitz
actions.talons+=/winters_blessing
actions.talons+=/flight_of_the_navir
actions.talons+=/cold_snap,if=cooldown.chronoshift.up&worb<5&!buff.glacial_assault.at_max_stacks
actions.talons+=/chronoshift,if=(spirit>=70|spirit>=85|buff.ice_blitz.up|dungeon_event.fight.remains<=30)&(cooldown.cold_snap.charges=0|worb>=5)&target.time_to_die>=10
actions.talons+=/wrath_of_winter,if=(target.time_to_die>=18|dungeon_event.fight.remains<=20)&(buff.ice_blitz.up|spirit>=85)
actions.talons+=/icicles_of_anzhyr,if=!dungeon_event.adds.exists|active_enemies%2>=dungeon_event.adds.count|dungeon_event.adds.in>=12
actions.talons+=/voidbringers_touch,if=!debuff.voidbringers_touch.up
actions.talons+=/bursting_ice
actions.talons+=/talon_strike,if=buff.glacial_assault.at_max_stacks
actions.talons+=/glacial_blast,if=buff.glacial_assault.at_max_stacks
actions.talons+=/rising_talons,if=worb>=5&active_enemies>=4
actions.talons+=/talon_strike,if=worb>=5
actions.talons+=/ice_comet,if=active_enemies>=2&worb>=5
actions.talons+=/cold_snap,if=worb<5&!buff.glacial_assault.at_max_stacks
actions.talons+=/freezing_torrent,if=worb<=3&cooldown.cold_snap.charges=0&target.time_to_die>=3
# Nature's Fury is a weapon the engine does not have yet.
# actions.talons+=/natures_fury
actions.talons+=/frost_bolt

# ---- Frostweaver
actions.frostweaver=ice_blitz
actions.frostweaver+=/winters_blessing,if=worb>=4
actions.frostweaver+=/flight_of_the_navir
actions.frostweaver+=/cold_snap,if=cooldown.chronoshift.up&worb<4&!buff.glacial_assault.at_max_stacks
actions.frostweaver+=/chronoshift,if=(spirit>=70|spirit>=85|buff.ice_blitz.up|dungeon_event.fight.remains<=30)&(cooldown.cold_snap.charges=0|worb>=4)&target.time_to_die>=10
actions.frostweaver+=/wrath_of_winter,if=(target.time_to_die>=18|dungeon_event.fight.remains<=20)&(buff.ice_blitz.up|spirit>=85)
actions.frostweaver+=/icicles_of_anzhyr,if=!dungeon_event.adds.exists|active_enemies%2>=dungeon_event.adds.count|dungeon_event.adds.in>=12
actions.frostweaver+=/voidbringers_touch,if=!debuff.voidbringers_touch.up
actions.frostweaver+=/glacial_blast,if=buff.glacial_assault.at_max_stacks
actions.frostweaver+=/bursting_ice,if=worb>=4
actions.frostweaver+=/ice_comet,if=active_enemies>=2&buff.winters_embrace.up&(worb>=2|buff.undulating_spirit.react)
actions.frostweaver+=/glacial_blast,if=active_enemies=1&buff.winters_embrace.up&(worb>=2|buff.undulating_spirit.react)
actions.frostweaver+=/ice_comet,if=active_enemies>=2&worb>=4
actions.frostweaver+=/glacial_blast,if=active_enemies=1&worb>=4
actions.frostweaver+=/cold_snap,if=worb<4&!buff.glacial_assault.at_max_stacks
actions.frostweaver+=/freezing_torrent,if=worb<=2&cooldown.cold_snap.charges=0&target.time_to_die>=3
# Nature's Fury is a weapon the engine does not have yet.
# actions.frostweaver+=/natures_fury
actions.frostweaver+=/frost_bolt

# ---- Soulfrost
actions.soulfrost=ice_blitz
actions.soulfrost+=/winters_blessing,if=worb>=4
actions.soulfrost+=/flight_of_the_navir
actions.soulfrost+=/cold_snap,if=cooldown.chronoshift.up&worb<4&!buff.glacial_assault.at_max_stacks&(!blessing.the_vehement|!buff.the_vehement.at_max_stacks|buff.frostwyrms_spite.up)
actions.soulfrost+=/chronoshift,if=(spirit>=70|spirit>=85|buff.ice_blitz.up|dungeon_event.fight.remains<=30)&(cooldown.cold_snap.charges=0|worb>=4)&target.time_to_die>=10
actions.soulfrost+=/wrath_of_winter,if=(target.time_to_die>=18|dungeon_event.fight.remains<=20)&(buff.ice_blitz.up|spirit>=85)
actions.soulfrost+=/icicles_of_anzhyr,if=!dungeon_event.adds.exists|active_enemies%2>=dungeon_event.adds.count|dungeon_event.adds.in>=12
actions.soulfrost+=/voidbringers_touch,if=!debuff.voidbringers_touch.up
actions.soulfrost+=/glacial_blast,if=buff.glacial_assault.at_max_stacks
actions.soulfrost+=/cold_snap,if=buff.frostwyrms_spite.up&(buff.winters_embrace.up|cooldown.bursting_ice.remains>gcd.max*2|target.time_to_die<=8)
actions.soulfrost+=/freezing_torrent,if=active_enemies>=2&target.time_to_die>=3
actions.soulfrost+=/bursting_ice,if=active_enemies>=2&(worb>=4|cooldown.freezing_torrent.remains>0)
actions.soulfrost+=/ice_comet,if=active_enemies>=2&buff.winters_embrace.up&(worb>=2|buff.undulating_spirit.react)
actions.soulfrost+=/ice_comet,if=active_enemies>=2&worb>=4
actions.soulfrost+=/bursting_ice,if=active_enemies=1
actions.soulfrost+=/freezing_torrent,if=active_enemies=1&target.time_to_die>=3
actions.soulfrost+=/cold_snap,if=active_enemies=1&cooldown.cold_snap.charges>0&!buff.glacial_assault.at_max_stacks&worb<5&(!blessing.the_vehement|!buff.the_vehement.at_max_stacks|buff.frostwyrms_spite.up)
actions.soulfrost+=/glacial_blast,if=active_enemies=1&(worb>=2|buff.undulating_spirit.react|buff.winters_embrace.up)
actions.soulfrost+=/cold_snap,if=worb<5&!buff.glacial_assault.at_max_stacks&(!blessing.the_vehement|!buff.the_vehement.at_max_stacks|buff.frostwyrms_spite.up)
# Nature's Fury is a weapon the engine does not have yet.
# actions.soulfrost+=/natures_fury
actions.soulfrost+=/frost_bolt,if=!blessing.the_vehement|!buff.the_vehement.at_max_stacks
# At the most stacks of The Vehement, Cold Snap and Frost Bolt above wait for Frostwyrm's Spite. With nothing else to
# cast, Frost Bolt goes anyway: a dungeon fight stops while the hero casts nothing.
actions.soulfrost+=/frost_bolt

# ---- Generic
actions.variables=variable,name=will_spend_orbs,value=active_enemies>=3|talent.icy_talons|(action.frost_bolt.execute_time<=1.16|!talent.cascading_blitz|talent.bursting_swallows&talent.burstbolter&action.frost_bolt.execute_time<=1.25|talent.icy_flow&talent.burstbolter&talent.bursting_swallows&!talent.greater_glacial_blast&action.frost_bolt.execute_time<=1.36|!buff.ice_blitz.up),op=set
actions.main=flight_of_the_navir,target_if=max:target.health,if=(target.time_to_die>=18|dungeon_event.fight.remains<=20)
actions.main+=/icicles_of_anzhyr,if=!dungeon_event.adds.exists|active_enemies%2>=dungeon_event.adds.count|dungeon_event.adds.in>=12
actions.main+=/wrath_of_winter,target_if=max:target.health,if=(target.time_to_die>=28|dungeon_event.fight.remains<=20|spirit.deficit<=10)&((!weapon.voidbringer|cooldown.voidbringers_touch.remains>45|spirit.deficit<=10)|!weapon_trait.visions_of_grandeur)&(buff.ice_blitz.up|spirit.deficit<=10)
actions.main+=/winters_blessing,target_if=max:target.health,if=(target.time_to_die>=20|dungeon_event.fight.remains<=20)&(worb>=2&!talent.icy_talons|worb>=4&talent.icy_talons)
actions.main+=/voidbringers_touch,if=!debuff.voidbringers_touch.up
actions.main+=/bursting_ice,target_if=max:target.health,if=refreshable&(!talent.icy_talons|worb>=4|legendary.skandis_decree|talent.harrowing_ice)
actions.main+=/ice_blitz,target_if=max:target.health,if=(!talent.cascading_blitz&target.time_to_die>=18|target.time_to_die>=25|dungeon_event.fight.remains<=60)&!buff.ice_blitz.up|!buff.the_philosopher.up&buff.winters_embrace.up
actions.main+=/cold_snap,target_if=max:target.health,if=buff.the_vehement.at_max_stacks&buff.winters_embrace.up&buff.frostwyrms_spite.up
actions.main+=/cold_snap,target_if=max:target.health,if=full_recharge_time<=gcd.max*3&worb<5&(!buff.icy_flow.at_max_stacks|talent.icy_talons)&variable.will_spend_orbs
actions.main+=/talon_strike,target_if=max:target.health,if=buff.winters_embrace.up&buff.glacial_assault.at_max_stacks
actions.main+=/rising_talons,target_if=max:target.health,if=(buff.winters_embrace.up&worb>=5|worb>=4&buff.wrath_of_winter.up|worb>=5&cooldown.bursting_ice.remains>=gcd.max*2)&active_enemies>=(3+talent.greater_glacial_blast)
actions.main+=/talon_strike,target_if=max:target.health,if=(buff.winters_embrace.up&worb>=5|worb>=4&buff.wrath_of_winter.up|worb>=5&!buff.glacial_assault.at_max_stacks&cooldown.bursting_ice.remains>=gcd.max*2)&active_enemies<(3+talent.greater_glacial_blast)
actions.main+=/glacial_blast,target_if=max:target.health,if=buff.glacial_assault.at_max_stacks
actions.main+=/ice_comet,if=active_enemies>=2&(worb>=5&!talent.cascading_blitz|buff.undulating_spirit.react|buff.winters_embrace.up)
actions.main+=/freezing_torrent,target_if=max:target.health,if=(worb<5)&target.time_to_die>=4
actions.main+=/glacial_blast,target_if=max:target.health,if=active_enemies=1&(worb>=4&variable.will_spend_orbs|buff.undulating_spirit.react|buff.winters_embrace.up|buff.icy_flow.at_max_stacks|buff.icy_flow.up&(talent.supreme_torrent|talent.soulfrost_torrent))&(!talent.harrowing_ice|!talent.cascading_blitz|!talent.burstbolter|!buff.ice_blitz.up|action.frost_bolt.execute_time<=1.16|buff.wrath_of_winter.up|buff.icy_flow.up)
actions.main+=/cold_snap,target_if=max:target.health,if=(buff.flight_of_the_navir.up|(cooldown.flight_of_the_navir.remains>=cooldown.cold_snap.duration*2|legendary.frostwyrms_spite)&(!buff.frostwyrms_spite.up|buff.winters_embrace.up)|target.time_to_die<=12)&(!buff.icy_flow.at_max_stacks|talent.icy_talons|legendary.frostwyrms_spite)&(!legendary.frostwyrms_spite|!blessing.the_vehement|buff.the_vehement.at_max_stacks|!buff.frostwyrms_spite.up)&(!buff.glacial_assault.at_max_stacks|!talent.icy_talons)
actions.main+=/chronoshift,if=!cooldown.flight_of_the_navir.up&!cooldown.winters_blessing.up&!cooldown.bursting_ice.up
# Nature's Fury is a weapon the engine does not have yet.
# actions.main+=/natures_fury
actions.main+=/cold_snap,target_if=max:target.health,if=buff.the_vehement.at_max_stacks
actions.main+=/frost_bolt,target_if=max:target.health

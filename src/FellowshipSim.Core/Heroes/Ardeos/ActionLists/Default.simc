# Ardeos's default action list: FellowSimc's SimC list (apl/ardeos/ardeos_apl.simc) in SimFell's names. Apocalypse
# spreads Searing Blaze, so the list never casts it.
# Left out: every check on Ardeos's damage over time (Engulfing Flames, Searing Blaze, Fire Ball, Apocalypse), which
# action lists cannot see yet; Incinerate's conditions (every one was such a check), Chronoshift's last use, The Vehement's buff,
# and the Curse of Anzhyr count, which reads the target's own.
actions.precombat=snapshot_stats
actions.precombat+=/infernal_wave
actions=apocalypse,target_if=max:target.health,if=(legendary.explosivo&target.time_to_die>=40|!raid_event.adds.exists|raid_event.adds.in>=55&target.time_to_die>=15|active_enemies=1&legendary.explosivo&raid_event.adds.in>=40)&buff.apocalyptic_surge.stack<3
actions+=/icicles_of_anzhyr,if=(!raid_event.adds.exists|active_enemies%2>=raid_event.adds.count|raid_event.adds.in>=12)&(!debuff.curse_of_anzhyr.up|!raid_event.adds.exists|raid_event.adds.in>=30)
actions+=/fire_ball,if=full_recharge_time<=gcd.max*3|cooldown.wildfire.remains<=gcd.max*3|!talent.slow_burn|weapon.chronoshift&cooldown.chronoshift.up&!talent.slow_burn
actions+=/fire_frogs,if=(active_enemies<12|talent.pyrophibian_frenzy)&cooldown.engulfing_flames.full_recharge_time>gcd.max
actions+=/engulfing_flames,target_if=max:target.health,if=full_recharge_time<=gcd.max*3&(cooldown.wildfire.remains>=10|talent.rolling_flames)|cooldown.wildfire.remains<=gcd.max*4|buff.wildfire.up|cooldown.chronoshift.up&weapon.chronoshift
actions+=/voidbringers_touch,target_if=max:target.health,if=buff.wildfire.up
# Engulfing Flames goes out ahead of Wildfire (the line above), so Wildfire no longer waits to see it.
actions+=/wildfire
actions+=/pyromania,if=buff.wildfire.up
actions+=/chronoshift,if=!cooldown.wildfire.up|fight_remains<=30
actions+=/infernal_wave,target_if=max:target.health,if=buff.cascading_inferno.stack>=18&talent.flare_up
actions+=/detonate,if=cinders>=300|buff.wildfire.up
actions+=/natures_fury
# In place of the SimC list's Incinerate, which waited on Engulfing Flames counts: Incinerate on 3 or more enemies (+10-25% on 4).
actions+=/incinerate,if=active_enemies>=3
actions+=/infernal_wave,target_if=max:target.health

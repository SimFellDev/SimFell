# Ardeos's default action list: FellowSimc's SimC list (apl/ardeos/ardeos_apl.simc) in SimFell's names. Apocalypse
# spreads Searing Blaze, so the list never casts it. Fire Ball's burn is dot.fire_ball.
# Left out: Apocalypse's burn (the engine's Apocalypse has none), Incinerate's wait on Chronoshift's last use, The
# Vehement's buff, and a typo the SimC list never read (cinder>=300). Its shortest Engulfing Flames is the target's.
actions.precombat=snapshot_stats
actions.precombat+=/infernal_wave
actions=apocalypse,target_if=max:target.health,if=(legendary.explosivo&target.time_to_die>=40|!dungeon_event.adds.exists|(dungeon_event.adds.in>=55|(active_enemies-active_dot.searing_blaze)>=1&legendary.explosivo|(active_enemies-active_dot.searing_blaze)>=3&!legendary.explosivo)&target.time_to_die>=15|active_enemies=1&legendary.explosivo&dungeon_event.adds.in>=40)&buff.apocalyptic_surge.stack<3
actions+=/icicles_of_anzhyr,if=(!dungeon_event.adds.exists|active_enemies%2>=dungeon_event.adds.count|dungeon_event.adds.in>=12)&(active_dot.curse_of_anzhyr<active_enemies|!dungeon_event.adds.exists|dungeon_event.adds.in>=30)
actions+=/fire_ball,if=full_recharge_time<=gcd.max*3|active_dot.fire_ball=0&(active_dot.engulfing_flames>0|cooldown.wildfire.remains<=gcd.max*3|!talent.slow_burn)|weapon.chronoshift&cooldown.chronoshift.up&!talent.slow_burn
actions+=/fire_frogs,if=(active_enemies<12|talent.pyrophibian_frenzy)&cooldown.engulfing_flames.full_recharge_time>gcd.max
actions+=/engulfing_flames,target_if=max:target.health,if=full_recharge_time<=(gcd.max*3+talent.rolling_flames*active_dot.searing_blaze*0.4)&(cooldown.wildfire.remains>=10|talent.rolling_flames)|cooldown.wildfire.remains<=gcd.max*4|buff.wildfire.up|cooldown.chronoshift.up&weapon.chronoshift
actions+=/voidbringers_touch,target_if=max:target.health,if=buff.wildfire.up
actions+=/wildfire,if=active_dot.engulfing_flames>0|cooldown.pyromania.up
actions+=/pyromania,if=buff.wildfire.up
actions+=/chronoshift,if=!cooldown.wildfire.up|dungeon_event.fight.remains<=30
actions+=/incinerate,target_if=min:dot.engulfing_flames.remains-100*dot.engulfing_flames.ticking-100*target.time_to_die>=12,if=active_dot.engulfing_flames>=2&dot.engulfing_flames.remains<=5|!talent.rolling_flames&!weapon.chronoshift&active_dot.engulfing_flames>=2
actions+=/infernal_wave,target_if=max:dot.engulfing_flames.stack,if=buff.cascading_inferno.stack>=18&talent.flare_up
actions+=/detonate,if=active_dot.engulfing_flames>=1&cinders>=300|buff.wildfire.up
actions+=/detonate,if=active_dot.searing_blaze>=6&active_dot.engulfing_flames>1
actions+=/natures_fury
actions+=/detonate,if=cinders>=360&active_dot.searing_blaze>=4
actions+=/infernal_wave,target_if=max:target.health

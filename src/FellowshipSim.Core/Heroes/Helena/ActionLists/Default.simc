# Helena's default action list: her damage abilities, Shockwave and Shield Slam first, since Veteran of War reduces their
# cooldowns.
actions.precombat=snapshot_stats
# Swing the weapon whenever the swing timer allows.
actions=attack
actions+=/siegebreaker
# Hold the Line resets Shield Slam's cooldown, so it waits until Shield Slam has no charge.
actions+=/hold_the_line,if=cooldown.shield_slam.charges=0
# Shields Up increases Toughness, which increases Greater Shockwave's damage; with High Command it reduces Hold the Line's
# cooldown.
actions+=/shields_up
actions+=/fated_strike
actions+=/sahrils_wrath
actions+=/shockwave
actions+=/shield_slam
actions+=/shield_throw
actions+=/sweeping_strike
actions+=/power_strike
actions+=/charge
actions+=/measured_strike

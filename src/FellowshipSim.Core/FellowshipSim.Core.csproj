<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Superpower" Version="3.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Each hero's default action lists (DefaultActionLists). -->
    <EmbeddedResource Include="Heroes\*\ActionLists\*.simc" />
    <!-- The built-in dungeons (DefaultDungeons). -->
    <EmbeddedResource Include="Dungeons\*.simc" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FellowshipSim.Core.Generators\FellowshipSim.Core.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    Game data from FellowshipSim.Codex.Generators: each creature's, dungeon's, hero's, ability's, talent's, legendary's,
    augmentation's, glyph's, weapon's and relic passive's class, and every hero's gear (GameGearData). Its files are
    committed in Generated/Codex/<generator>/, and a build compiles them, so a build needs no Codex export. With
    RegenerateCodex=true (tools/regenerate-codex.sh) the generators run over codex-export/ instead, and their files replace
    Generated/Codex/ with codex-export.sha256, the hash of the export they are from.
  -->
  <PropertyGroup>
    <RegenerateCodex Condition="'$(RegenerateCodex)' == ''">false</RegenerateCodex>
    <CodexExportFolder>$(MSBuildThisFileDirectory)../../codex-export/</CodexExportFolder>
    <CodexGeneratedFolder>$(MSBuildThisFileDirectory)Generated/Codex/</CodexGeneratedFolder>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Generated/**" />
    <Compile Include="Generated/Codex/**/*.cs" Condition="'$(RegenerateCodex)' != 'true'" />
  </ItemGroup>

  <ItemGroup Condition="'$(RegenerateCodex)' == 'true'">
    <ProjectReference Include="..\FellowshipSim.Codex.Generators\FellowshipSim.Codex.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="$(CodexExportFolder)entities.jsonl" />
    <AdditionalFiles Include="$(CodexExportFolder)settings.json" />
  </ItemGroup>

  <!-- The compiler writes every generator's files to <output>/<generator assembly>/<generator type>/. -->
  <PropertyGroup Condition="'$(RegenerateCodex)' == 'true'">
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)codex-generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <Target Name="CheckCodexExport" BeforeTargets="ResolveProjectReferences" Condition="'$(RegenerateCodex)' == 'true'">
    <Error Condition="!Exists('$(CodexExportFolder)entities.jsonl') Or !Exists('$(CodexExportFolder)settings.json')"
      Text="RegenerateCodex needs the Codex export in codex-export/. Run tools/download-codex-export.sh first." />
    <RemoveDir Directories="$(CompilerGeneratedFilesOutputPath)" />
  </Target>

  <!--
    Generated/Codex/ has a folder per generator, named after its type without its namespace and Generator
    (FellowshipSim.Codex.Generators.AbilityGenerator is Ability/), so a tracked path stays short.
  -->
  <Target Name="CopyCodexGenerated" AfterTargets="CoreCompile" Condition="'$(RegenerateCodex)' == 'true' And '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <CodexGenerated Include="$(CompilerGeneratedFilesOutputPath)/FellowshipSim.Codex.Generators/**/*.cs" />
      <CodexGenerated>
        <Folder>$([System.String]::Copy('%(RecursiveDir)').Replace('FellowshipSim.Codex.Generators.', '').Replace('Generator\', '\').Replace('Generator/', '/'))</Folder>
      </CodexGenerated>
      <CodexExportFile Include="$(CodexExportFolder)entities.jsonl;$(CodexExportFolder)settings.json" />
    </ItemGroup>
    <Error Condition="'@(CodexGenerated)' == ''" Text="The Codex generators wrote no file. Build with --no-incremental (tools/regenerate-codex.sh)." />
    <RemoveDir Directories="$(CodexGeneratedFolder)" />
    <Copy SourceFiles="@(CodexGenerated)" DestinationFiles="@(CodexGenerated->'$(CodexGeneratedFolder)%(Folder)%(Filename)%(Extension)')" />
    <GetFileHash Files="@(CodexExportFile)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="CodexExportHash" />
    </GetFileHash>
    <ItemGroup>
      <CodexExportHash>
        <Line>$([System.String]::Copy('%(FileHash)').ToLowerInvariant())  %(Filename)%(Extension)</Line>
      </CodexExportHash>
    </ItemGroup>
    <WriteLinesToFile File="$(CodexGeneratedFolder)codex-export.sha256" Overwrite="true" Lines="@(CodexExportHash->'%(Line)')" />
    <Message Importance="high" Text="Codex generated files: @(CodexGenerated->Count()) in $(CodexGeneratedFolder)" />
  </Target>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Superpower" Version="3.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Each hero's default action lists (DefaultActionLists). -->
    <EmbeddedResource Include="Heroes\*\ActionLists\*.simc" />
    <!-- The built-in dungeons (DefaultDungeons). -->
    <EmbeddedResource Include="Dungeons\*.simc" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FellowshipSim.Core.Generators\FellowshipSim.Core.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\FellowshipSim.Codex.Generators\FellowshipSim.Codex.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Game data in codex-export/: each creature's class (CreatureGenerator) and each dungeon's creature placements (DungeonGenerator). -->
  <PropertyGroup>
    <CodexExportFolder>$(MSBuildThisFileDirectory)../../codex-export/</CodexExportFolder>
    <CodexExportUrl>https://codex.fellowshipanalyzer.com/api/export</CodexExportUrl>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(CodexExportFolder)entities.jsonl" />
    <AdditionalFiles Include="$(CodexExportFolder)settings.json" />
  </ItemGroup>

  <!--
    Each build compares the game data's export.json, which names its game build, with the copy in codex-export/, and
    downloads the game data when they differ. An offline build keeps the copy it has. A build without a copy, as on every CI run, needs
    the download and retries it. Every file arrives in the intermediate folder and export.json is copied last, so an
    interrupted download reads as out of date on the next build.
  -->
  <Target Name="DownloadCodexExport" BeforeTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <CodexExportDownloadFolder>$(IntermediateOutputPath)codex-export/</CodexExportDownloadFolder>
    </PropertyGroup>

    <DownloadFile Condition="Exists('$(CodexExportFolder)export.json')" SourceUrl="$(CodexExportUrl)" DestinationFolder="$(CodexExportDownloadFolder)" DestinationFileName="export.json" SkipUnchangedFiles="false" Timeout="5000" ContinueOnError="true">
      <Output TaskParameter="DownloadedFile" PropertyName="CodexExportLatestFile" />
    </DownloadFile>
    <DownloadFile Condition="!Exists('$(CodexExportFolder)export.json')" SourceUrl="$(CodexExportUrl)" DestinationFolder="$(CodexExportDownloadFolder)" DestinationFileName="export.json" SkipUnchangedFiles="false" Retries="3">
      <Output TaskParameter="DownloadedFile" PropertyName="CodexExportLatestFile" />
    </DownloadFile>

    <PropertyGroup>
      <CodexExportHeld Condition="Exists('$(CodexExportFolder)export.json')">$([System.IO.File]::ReadAllText('$(CodexExportFolder)export.json'))</CodexExportHeld>
      <CodexExportLatest Condition="'$(CodexExportLatestFile)' != ''">$([System.IO.File]::ReadAllText('$(CodexExportDownloadFolder)export.json'))</CodexExportLatest>
      <CodexExportOutOfDate Condition="'$(CodexExportHeld)' == '' Or ('$(CodexExportLatest)' != '' And '$(CodexExportLatest)' != '$(CodexExportHeld)')">true</CodexExportOutOfDate>
    </PropertyGroup>

    <DownloadFile Condition="'$(CodexExportOutOfDate)' == 'true'" SourceUrl="$(CodexExportUrl)/entities.jsonl" DestinationFolder="$(CodexExportDownloadFolder)" SkipUnchangedFiles="false" Retries="3" />
    <DownloadFile Condition="'$(CodexExportOutOfDate)' == 'true'" SourceUrl="$(CodexExportUrl)/settings.json" DestinationFolder="$(CodexExportDownloadFolder)" SkipUnchangedFiles="false" Retries="3" />
    <Copy Condition="'$(CodexExportOutOfDate)' == 'true'" SourceFiles="$(CodexExportDownloadFolder)entities.jsonl;$(CodexExportDownloadFolder)settings.json;$(CodexExportDownloadFolder)export.json" DestinationFolder="$(CodexExportFolder)" />
  </Target>

  <ItemGroup>
    <Folder Include="Enemies\" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Superpower" Version="3.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Each hero's default action lists (DefaultActionLists). -->
    <EmbeddedResource Include="Heroes\*\ActionLists\*.simc" />
    <!-- The built-in dungeons (DefaultDungeons). -->
    <EmbeddedResource Include="Dungeons\*.simc" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FellowshipSim.Core.Generators\FellowshipSim.Core.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\FellowshipSim.Codex.Generators\FellowshipSim.Codex.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- The Codex's data export (tools/download-codex-export.sh): each creature's class (CreatureGenerator). -->
  <PropertyGroup>
    <CodexExportFolder>$(MSBuildThisFileDirectory)..\..\codex-export\</CodexExportFolder>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(CodexExportFolder)entities.jsonl" Condition="Exists('$(CodexExportFolder)entities.jsonl')" />
    <AdditionalFiles Include="$(CodexExportFolder)settings.json" Condition="Exists('$(CodexExportFolder)settings.json')" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Enemies\" />
  </ItemGroup>

</Project>

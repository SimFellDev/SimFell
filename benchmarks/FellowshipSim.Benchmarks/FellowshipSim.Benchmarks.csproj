<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FellowshipSim.Core\FellowshipSim.Core.csproj" />
    <ProjectReference Include="..\..\src\FellowshipSim.Logs\FellowshipSim.Logs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\tests\FellowshipSim.Tests\Fixtures\rime_character.json" Link="Fixtures\rime_character.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
